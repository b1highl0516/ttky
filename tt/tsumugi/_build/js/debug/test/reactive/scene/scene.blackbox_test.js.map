///| Little-endian byte codec.
///
/// The wire formats in this project (the IR block, the light block, and the
/// raster blob) are defined *in bytes*, so every multi-byte field is written by
/// hand and a big-endian host still produces the same file. That makes these
/// six functions structure-known, logic-fixed and only data-varying: they
/// belong in L0 next to the checksum, not copied into each producer.

///|
/// UTF-8 bytes of a string as a flat array — the one honest way to turn text
/// into bytes. (`String::to_bytes()` yields the runtime's *internal* encoding,
/// which is UTF-16 here; see the note in `crc.mbt`.)
pub fn utf8_bytes(s : String) -> FixedArray[Byte] {
  let u = @utf8.encode(s)
  let buf = FixedArray::make(u.length(), b'\x00')
  for i = 0; i < u.length(); i = i + 1 {
    buf[i] = u[i]
  }
  buf
}

///|
pub fn put_u16(buf : FixedArray[Byte], off : Int, v : Int) -> Unit {
  buf[off] = (v & 255).reinterpret_as_uint().to_byte()
  buf[off + 1] = ((v >> 8) & 255).reinterpret_as_uint().to_byte()
}

///|
pub fn put_u32_le(buf : FixedArray[Byte], off : Int, v : Int) -> Unit {
  buf[off] = (v & 255).reinterpret_as_uint().to_byte()
  buf[off + 1] = ((v >> 8) & 255).reinterpret_as_uint().to_byte()
  buf[off + 2] = ((v >> 16) & 255).reinterpret_as_uint().to_byte()
  buf[off + 3] = ((v >> 24) & 255).reinterpret_as_uint().to_byte()
}

///|
pub fn put_u64(buf : FixedArray[Byte], off : Int, v : UInt64) -> Unit {
  for i = 0; i < 8; i = i + 1 {
    buf[off + i] = (v >> (i * 8)).land(255UL).to_byte()
  }
}

///|
pub fn put_f64(buf : FixedArray[Byte], off : Int, v : Double) -> Unit {
  let bits = v.reinterpret_as_uint64()
  put_u64(buf, off, bits)
}

///|
pub fn get_u16(buf : FixedArray[Byte], off : Int) -> Int {
  buf[off].to_int() | (buf[off + 1].to_int() << 8)
}

///|
pub fn get_u32_le(buf : FixedArray[Byte], off : Int) -> Int {
  buf[off].to_int() |
  (buf[off + 1].to_int() << 8) |
  (buf[off + 2].to_int() << 16) |
  (buf[off + 3].to_int() << 24)
}

///|
pub fn get_u64(buf : FixedArray[Byte], off : Int) -> UInt64 {
  let mut v = 0UL
  for i = 0; i < 8; i = i + 1 {
    v = v | (buf[off + i].to_int().reinterpret_as_uint().to_uint64() << (i * 8))
  }
  v
}

///|
/// Read a little-endian `f64`. Used by the bench/test side of the raster blob,
/// where the host and the wasm module exchange doubles inside one flat buffer.
pub fn get_f64(buf : FixedArray[Byte], off : Int) -> Double {
  get_u64(buf, off).reinterpret_as_double()
}

///|
/// A growable little-endian writer: one buffer, one cursor, no reallocation per
/// field. Every wire producer in the project uses it, which is what keeps the
/// three block formats (IR / light / raster) byte-identical in style.
pub(all) struct LeWriter {
  mut buf : FixedArray[Byte]
  mut len : Int
}

///|
pub fn LeWriter::new(cap : Int) -> LeWriter {
  { buf: FixedArray::make(if cap < 16 { 16 } else { cap }, b'\x00'), len: 0, }
}

///|
fn LeWriter::reserve(self : LeWriter, extra : Int) -> Unit {
  let need = self.len + extra
  if need <= self.buf.length() {
    return
  }
  let mut cap = self.buf.length() * 2
  while cap < need {
    cap = cap * 2
  }
  let nb = FixedArray::make(cap, b'\x00')
  for i = 0; i < self.len; i = i + 1 {
    nb[i] = self.buf[i]
  }
  self.buf = nb
}

///|
pub fn LeWriter::byte(self : LeWriter, b : Int) -> Unit {
  self.reserve(1)
  self.buf[self.len] = (b & 255).reinterpret_as_uint().to_byte()
  self.len = self.len + 1
}

///|
pub fn LeWriter::u16(self : LeWriter, v : Int) -> Unit {
  self.reserve(2)
  put_u16(self.buf, self.len, v)
  self.len = self.len + 2
}

///|
pub fn LeWriter::u32(self : LeWriter, v : Int) -> Unit {
  self.reserve(4)
  put_u32_le(self.buf, self.len, v)
  self.len = self.len + 4
}

///|
pub fn LeWriter::u64(self : LeWriter, v : UInt64) -> Unit {
  self.reserve(8)
  put_u64(self.buf, self.len, v)
  self.len = self.len + 8
}

///|
pub fn LeWriter::f64(self : LeWriter, v : Double) -> Unit {
  self.reserve(8)
  put_f64(self.buf, self.len, v)
  self.len = self.len + 8
}

///|
pub fn LeWriter::bytes(self : LeWriter, src : FixedArray[Byte]) -> Unit {
  self.reserve(src.length())
  for i = 0; i < src.length(); i = i + 1 {
    self.buf[self.len + i] = src[i]
  }
  self.len = self.len + src.length()
}

///|
/// Snapshot of the bytes written so far.
pub fn LeWriter::to_bytes(self : LeWriter) -> FixedArray[Byte] {
  let out = FixedArray::make(self.len, b'\x00')
  for i = 0; i < self.len; i = i + 1 {
    out[i] = self.buf[i]
  }
  out
}

///|
/// The buffer itself, trimmed to the written length (no copy).
pub fn LeWriter::bytes_view(self : LeWriter) -> FixedArray[Byte] {
  if self.len == self.buf.length() {
    return self.buf
  }
  let out = self.to_bytes()
  self.buf = out
  out
}
