///| 2D / 3D vector primitives. All operations are value-semantic and
/// allocation-free; the `Double` layout is ABI-stable so a `FixedArray[Vec2]`
/// can be handed straight to the wasm/js boundary.

///|
#valtype
pub(all) struct Vec2 {
  x : Double
  y : Double
} derive(Eq)

///|
pub extend Vec2 with Eq::{equal, not_equal}

///|
pub fn Vec2::new(x : Double, y : Double) -> Vec2 {
  { x, y, }
}

///|
#inline
pub fn Vec2::zero() -> Vec2 {
  { x: 0.0, y: 0.0, }
}

///|
#inline
pub fn Vec2::add(self : Vec2, o : Vec2) -> Vec2 {
  { x: self.x + o.x, y: self.y + o.y, }
}

///|
#inline
pub fn Vec2::sub(self : Vec2, o : Vec2) -> Vec2 {
  { x: self.x - o.x, y: self.y - o.y, }
}

///|
#inline
pub fn Vec2::scale(self : Vec2, k : Double) -> Vec2 {
  { x: self.x * k, y: self.y * k, }
}

///|
#inline
pub fn Vec2::dot(self : Vec2, o : Vec2) -> Double {
  self.x * o.x + self.y * o.y
}

///|
/// 2D cross product = signed area of the parallelogram (z of the 3D cross).
#inline
pub fn Vec2::cross(self : Vec2, o : Vec2) -> Double {
  self.x * o.y - self.y * o.x
}

///|
pub fn Vec2::length_sq(self : Vec2) -> Double {
  self.dot(self)
}

///|
pub fn Vec2::length(self : Vec2) -> Double {
  self.length_sq().sqrt()
}

///|
/// Distance using the fast inverse square root; error < 2e-3 relative.
/// Only for comparisons, never for exact output values.
pub fn Vec2::length_fast(self : Vec2) -> Double {
  let s = self.length_sq()
  if s <= 0.0 {
    0.0
  } else {
    s * inv_sqrt(s)
  }
}

///|
pub fn Vec2::normalize(self : Vec2) -> Vec2 {
  let len = self.length()
  if len <= 1.0e-12 {
    { x: 0.0, y: 0.0, }
  } else {
    self.scale(1.0 / len)
  }
}

///|
#inline
pub fn Vec2::perpendicular(self : Vec2) -> Vec2 {
  { x: -self.y, y: self.x, }
}

///|
pub fn Vec2::rotate(self : Vec2, rad : Double) -> Vec2 {
  let c = @cmath.cos(rad)
  let s = @cmath.sin(rad)
  { x: self.x * c - self.y * s, y: self.x * s + self.y * c, }
}

///|
pub fn Vec2::angle(self : Vec2) -> Double {
  @cmath.atan2(self.y, self.x)
}

///|
pub fn Vec2::lerp(self : Vec2, o : Vec2, t : Double) -> Vec2 {
  { x: self.x + (o.x - self.x) * t, y: self.y + (o.y - self.y) * t, }
}

///|
pub fn Vec2::distance(self : Vec2, o : Vec2) -> Double {
  self.sub(o).length()
}

///|
pub fn Vec2::abs(self : Vec2) -> Vec2 {
  { x: self.x.abs(), y: self.y.abs(), }
}

///|
pub fn Vec2::min(self : Vec2, o : Vec2) -> Vec2 {
  { x: Double::min(self.x, o.x), y: Double::min(self.y, o.y), }
}

///|
pub fn Vec2::max(self : Vec2, o : Vec2) -> Vec2 {
  { x: Double::max(self.x, o.x), y: Double::max(self.y, o.y), }
}

///|
#inline
pub fn Vec2::is_finite(self : Vec2) -> Bool {
  !(self.x.is_nan() || self.y.is_nan()) &&
  !(self.x.is_pos_inf() ||
  self.x.is_neg_inf() ||
  self.y.is_pos_inf() ||
  self.y.is_neg_inf())
}

///|
/// 3D vector, used for 2.5D normals / light directions (z = height).
#valtype
pub(all) struct Vec3 {
  x : Double
  y : Double
  z : Double
} derive(Eq)

///|
pub extend Vec3 with Eq::{equal, not_equal}

///|
pub fn Vec3::new(x : Double, y : Double, z : Double) -> Vec3 {
  { x, y, z, }
}

///|
pub fn Vec3::zero() -> Vec3 {
  { x: 0.0, y: 0.0, z: 0.0, }
}

///|
#inline
pub fn Vec3::add(self : Vec3, o : Vec3) -> Vec3 {
  { x: self.x + o.x, y: self.y + o.y, z: self.z + o.z, }
}

///|
#inline
pub fn Vec3::sub(self : Vec3, o : Vec3) -> Vec3 {
  { x: self.x - o.x, y: self.y - o.y, z: self.z - o.z, }
}

///|
#inline
pub fn Vec3::scale(self : Vec3, k : Double) -> Vec3 {
  { x: self.x * k, y: self.y * k, z: self.z * k, }
}

///|
#inline
pub fn Vec3::dot(self : Vec3, o : Vec3) -> Double {
  self.x * o.x + self.y * o.y + self.z * o.z
}

///|
pub fn Vec3::cross(self : Vec3, o : Vec3) -> Vec3 {
  {
    x: self.y * o.z - self.z * o.y,
    y: self.z * o.x - self.x * o.z,
    z: self.x * o.y - self.y * o.x,
  }
}

///|
pub fn Vec3::length_sq(self : Vec3) -> Double {
  self.dot(self)
}

///|
pub fn Vec3::length(self : Vec3) -> Double {
  self.length_sq().sqrt()
}

///|
pub fn Vec3::normalize(self : Vec3) -> Vec3 {
  let len = self.length()
  if len <= 1.0e-12 {
    { x: 0.0, y: 0.0, z: 0.0, }
  } else {
    self.scale(1.0 / len)
  }
}

///|
pub fn Vec3::lerp(self : Vec3, o : Vec3, t : Double) -> Vec3 {
  {
    x: self.x + (o.x - self.x) * t,
    y: self.y + (o.y - self.y) * t,
    z: self.z + (o.z - self.z) * t,
  }
}

///|
#inline
pub fn Vec3::is_finite(self : Vec3) -> Bool {
  !(self.x.is_nan() || self.y.is_nan() || self.z.is_nan())
}

///|
/// Batch helpers: operate in-place on planar (SoA) buffers, which is the
/// layout used by @ir / @raster / @light.
pub fn vec2_bounds(points : FixedArray[Double], count : Int) -> (Vec2, Vec2) {
  let mut mn = Vec2::{ x: 1.0e30, y: 1.0e30, }
  let mut mx = Vec2::{ x: -1.0e30, y: -1.0e30, }
  for i = 0; i < count; i = i + 1 {
    let x = points[i * 2]
    let y = points[i * 2 + 1]
    mn = mn.min(Vec2::{ x, y, })
    mx = mx.max(Vec2::{ x, y, })
  }
  (mn, mx)
}
