///| Deterministic PRNG: PCG32 (XSH-RR variant, O'Neill 2014).
///
/// The whole point of this package's random source is *bit-identical
/// reproducibility* across native / wasm / js: golden tests, benchmark input
/// generation and the KV compaction sampler all depend on it. `Random` from
/// the core library is explicitly not used here because its stream is not
/// guaranteed stable across backends.

///|
pub(all) struct Pcg32 {
  mut state : UInt64
  mut inc : UInt64
}

///|
/// Create with the standard default stream selector.
pub fn Pcg32::new(seed? : UInt64, seq? : UInt64) -> Pcg32 {
  let init_state = match seed {
    Some(s) => s
    None => 0x853C49E6748FEA9BUL
  }
  let init_seq = match seq {
    Some(s) => s
    None => 0xDA3E39CB94B95BDBUL
  }
  let rng = { state: 0UL, inc: (init_seq << 1) | 1UL, }
  ignore(rng.next_u32())
  rng.state = rng.state + init_state
  ignore(rng.next_u32())
  rng
}

///|
/// XSH-RR output function of PCG32. Both shifts are **logical**: doing the
/// rotate on a signed `Int` fills the vacated top bits with copies of the sign
/// bit, so any draw whose top bit is set comes out as `0xFFFFFFFF` instead of
/// its real value. The golden vector in `num_test.mbt` (O'Neill's `pcg32-demo`
/// stream for seed 42 / seq 54) is what caught it: five of six values matched
/// the reference and the fourth — the first one with the top bit set — did not.
#inline
pub fn Pcg32::next_u32(self : Pcg32) -> UInt {
  let old = self.state
  self.state = old * 6364136223846793005UL + self.inc
  let xorshifted : UInt = (((old >> 18) ^ old) >> 27).to_uint()
  let rot = (old >> 59).to_int()
  (xorshifted >> rot) | (xorshifted << ((32 - rot) % 32))
}

///|
#inline
pub fn Pcg32::next_u64(self : Pcg32) -> UInt64 {
  let hi = self.next_u32().to_uint64()
  let lo = self.next_u32().to_uint64()
  (hi << 32) | lo
}

///|
/// Double in [0, 1).
///
/// The 32 bits are taken as **unsigned** (`UInt::to_double`, i.e. zero-extended)
/// and divided by 2³². An earlier version reinterpreted them as a signed 32-bit
/// integer first, which made the result land in (−0.5, 0.5) instead of [0, 1) —
/// so `range(lo, hi)` returned values half a range below `lo`, and a caller that
/// trusted it scattered its inputs into the wrong quadrant. There was no test on
/// this function at the time, which is exactly why it survived: every caller
/// used `range` for fuzzing, where "outside the asked-for interval" does not
/// fail an assertion.
pub fn Pcg32::next_double(self : Pcg32) -> Double {
  self.next_u32().to_double() / 4294967296.0
}

///|
/// Uniform integer in [0, bound).
pub fn Pcg32::next_below(self : Pcg32, bound : Int) -> Int {
  if bound <= 0 {
    return 0
  }
  // rejection sampling: unbiased, worst case 2 draws
  let threshold = (4294967296UL - bound.to_uint64()) % bound.to_uint64()
  let mut r = self.next_u32().to_uint64()
  while r < threshold {
    r = self.next_u32().to_uint64()
  }
  (r % bound.to_uint64()).to_int()
}

///|
/// Deterministic double in [lo, hi).
pub fn Pcg32::range(self : Pcg32, lo : Double, hi : Double) -> Double {
  lo + (hi - lo) * self.next_double()
}

///|
/// Shuffle in place with Fisher-Yates (unbiased, deterministic).
pub fn[A] Pcg32::shuffle(self : Pcg32, arr : Array[A]) -> Unit {
  let mut i = arr.length() - 1
  while i > 0 {
    let j = self.next_below(i + 1)
    let tmp = arr[i]
    arr[i] = arr[j]
    arr[j] = tmp
    i = i - 1
  }
}
