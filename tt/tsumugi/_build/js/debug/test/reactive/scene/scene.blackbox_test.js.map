///| The scene graph, and the incremental machinery that keeps it consistent.
///
/// **Why a scene graph and a dependency graph are different things.** The tree
/// is what the author edits; the dependency graph is what the machine
/// propagates. This package keeps both, but the propagation is *not* a tree
/// traversal:
///
///  * a node's world matrix depends on its **parent's world matrix**, not on its
///    whole subtree — so a `set_trs` invalidates exactly one node, and a *pull*
///    (`world_of`, `bounds_of`, `damage_of`, `hit_test`) walks up the parent
///    chain and composes, which costs `O(depth)` and touches only the nodes on
///    that chain. Nothing is recomputed for the descendants of a moved node
///    until somebody asks for them, which is what "lazy" means here;
///  * a node's subtree bounds depend on its **children**, so that one propagates
///    *upwards* with an early stop as soon as an ancestor's bounds come out
///    unchanged — and they are stored **in the node's own frame**, which is what
///    keeps a parent's move from invalidating anything below it. If they were
///    stored in world space, moving a group would invalidate every descendant
///    and the cost would be the whole subtree instead of `O(depth)`; cached
///    bounds in local space are the difference between "incremental" and
///    "recompute everything under the thing you moved".
///
/// That is the two-directional, stamp-verified scheme the L2 design called for,
/// and it is the same `changed_at` / `validated_at` idea as `reactive/signal`,
/// with one difference: here the stamps live in flat arrays next to the
/// matrices they guard, so a refresh is a few compares and one 2×3 multiply,
/// and there is no per-node call into a generic engine. `flush()` reports how
/// much work it did, and the tests compare the incremental result against a
/// from-scratch recompute of the whole tree, so "incremental == full" is
/// checked, not assumed.
///
/// **Damage.** Two rectangles per change, both required:
///
///  * where the node *was* (its cached bounds at invalidation time) — otherwise
///    the old pixels are never cleared;
///  * where it *is now* (after flush) — otherwise it is not drawn.
///
/// Both go into the scene's `DirtyRegion`, intersected with the node's clip
/// chain, so a scrolled list's damage never exceeds the viewport it scrolls in.
///
/// Nodes are free-list slots in one `Array[Node]`; a stale id is detected by
/// `alive()`, and `gen` records how many times a slot has been reused so a
/// caller can tell "gone" from "reused by someone else".

///|
pub const ROOT : Int = 0

///|
pub const NO_NODE : Int = -1

///|
/// The node and its subtree paint nothing.
pub const FLAG_HIDDEN : Int = 1

///|
/// The node has a clip box (in its own local space).
pub const FLAG_CLIP : Int = 2

///|
/// Local transform: translation, rotation, scale. Matrix is `T · R · S`, the
/// CSS `transform` order, so a node rotates about its own origin and scales
/// before rotating.
pub(all) struct Trs {
  x : Double
  y : Double
  rot : Double
  sx : Double
  sy : Double
}

///|
pub fn Trs::new(
  x : Double,
  y : Double,
  rot : Double,
  sx : Double,
  sy : Double,
) -> Trs {
  { x, y, rot, sx, sy, }
}

///|
pub fn Trs::at(x : Double, y : Double) -> Trs {
  { x, y, rot: 0.0, sx: 1.0, sy: 1.0, }
}

///|
pub fn Trs::identity() -> Trs {
  { x: 0.0, y: 0.0, rot: 0.0, sx: 1.0, sy: 1.0, }
}

///|
pub fn Trs::matrix(self : Trs) -> @math.Mat2x3 {
  @math.Mat2x3::translate(self.x, self.y)
  .compose(@math.Mat2x3::rotate(self.rot))
  .compose(@math.Mat2x3::scale(self.sx, self.sy))
}

///|
pub fn Trs::equal(self : Trs, o : Trs) -> Bool {
  self.x == o.x &&
  self.y == o.y &&
  self.rot == o.rot &&
  self.sx == o.sx &&
  self.sy == o.sy
}

///|
pub fn Trs::to_display(self : Trs) -> String {
  let sx = self.sx
  let sy = self.sy
  let rot = self.rot
  "Trs(\{self.x}, \{self.y}, rot=\{rot}, scale=\{sx}×\{sy})"
}

///|
pub impl @debug.Debug for Trs with fn to_repr(self) {
  @debug.Repr::literal(self.to_display())
}

///|
pub extend Trs with @debug.Debug::{to_repr}

///|
/// One node. Every cached field is guarded by a stamp: `world_ver` counts how
/// often `world` changed, `world_base` records the parent's `world_ver` at the
/// time `world` was computed, and a mismatch means "recompute by composing".
pub(all) struct Node {
  mut alive : Bool
  mut gen : Int
  mut parent : Int
  mut first_child : Int
  mut last_child : Int
  mut next : Int
  mut prev : Int
  mut depth : Int
  mut trs : Trs
  /// Geometry in the node's own space (before its own transform).
  mut bounds_local : @spatial.Aabb
  mut flags : Int
  /// Paint opacity, 0..1. It is a paint property, not a transform, but it
  /// damages the subtree like a transform does, so it lives here rather than in
  /// a separate paint node.
  mut opacity : Double
  mut clip_local : @spatial.Aabb
  mut mat : @math.Mat2x3
  mut mat_valid : Bool
  /// True when this node's own matrix was just refreshed: the parent's subtree
  /// box places this node's box with that matrix, so the parent has to recompute
  /// even when this node's own box is unchanged.
  mut placed_dirty : Bool
  mut world : @math.Mat2x3
  mut world_ver : Int
  mut world_base : Int
  mut world_valid : Bool
  /// Geometry in world space: `bounds_local` under `world`.
  mut bounds : @spatial.Aabb
  mut bounds_ver : Int
  /// The node's clip box in world space (only meaningful with `FLAG_CLIP`).
  mut clip_world : @spatial.Aabb
  mut clip_ver : Int
  /// Subtree bounds **in this node's own frame**: this node's local bounds
  /// unioned with every child's subtree bounds. Kept local on purpose — a
  /// parent's transform change must not touch it. `subtree_bounds_of` places it
  /// in world space on demand (Arvo, ~12 flops).
  mut sub_local : @spatial.Aabb
}

///|
/// Work counters for one flush. Every field is a real measurement, not a
/// guess: `refreshed` is how many nodes had their matrix recomputed,
/// `early_stops` is how often the upward pass found nothing to propagate.
pub(all) struct SceneStats {
  mut marks : Int
  mut refreshed : Int
  mut matmuls : Int
  mut promotes : Int
  mut early_stops : Int
  mut post_rects : Int
  mut pre_rects : Int
}

///|
pub fn SceneStats::to_display(self : SceneStats) -> String {
  let marks = self.marks
  let refreshed = self.refreshed
  let matmuls = self.matmuls
  let promotes = self.promotes
  let early_stops = self.early_stops
  let pre_rects = self.pre_rects
  let post_rects = self.post_rects
  "SceneStats(marks=\{marks}, refreshed=\{refreshed}, matmuls=\{matmuls}, promotes=\{promotes}, early_stops=\{early_stops}, pre_rects=\{pre_rects}, post_rects=\{post_rects})"
}

///|
pub impl @debug.Debug for SceneStats with fn to_repr(self) {
  @debug.Repr::literal(self.to_display())
}

///|
pub extend SceneStats with @debug.Debug::{to_repr}

///|
pub(all) struct Scene {
  vp : @spatial.Aabb
  mut nodes : Array[Node]
  mut free : Array[Int]
  mut marks : Array[Int]
  mut mark_stamp : Array[Int]
  mut stamp : Int
  mut scratch : Array[Int]
  mut id_stack : Array[Int]
  mut clip_stack : Array[@spatial.Aabb]
  mut dirty : DirtyRegion
  mut stats : SceneStats
}

///|
/// A scene with a root node covering the viewport.
pub fn Scene::new(vp : @spatial.Aabb, tile : Int) -> Scene {
  let s : Scene = {
    vp,
    nodes: [],
    free: [],
    marks: [],
    mark_stamp: [],
    stamp: 1,
    scratch: [],
    id_stack: [],
    clip_stack: [],
    dirty: DirtyRegion::new(vp, tile),
    stats: {
      marks: 0,
      refreshed: 0,
      matmuls: 0,
      promotes: 0,
      early_stops: 0,
      post_rects: 0,
      pre_rects: 0,
    },
  }
  let root : Node = {
    alive: true,
    gen: 0,
    parent: NO_NODE,
    first_child: NO_NODE,
    last_child: NO_NODE,
    next: NO_NODE,
    prev: NO_NODE,
    depth: 0,
    trs: Trs::identity(),
    // The root is a container: the viewport is a property of the *scene*, not a
    // box the root paints, so a hit test outside every child finds nothing
    // rather than "the root".
    bounds_local: @spatial.Aabb::empty(),
    flags: 0,
    opacity: 1.0,
    clip_local: @spatial.Aabb::empty(),
    mat: @math.Mat2x3::identity(),
    mat_valid: true,
    placed_dirty: false,
    world: @math.Mat2x3::identity(),
    world_ver: 0,
    world_base: 0,
    world_valid: true,
    bounds: @spatial.Aabb::empty(),
    bounds_ver: -1,
    clip_world: @spatial.Aabb::empty(),
    clip_ver: -1,
    sub_local: @spatial.Aabb::empty(),
  }
  s.nodes.push(root)
  s.mark_stamp.push(0)
  s
}

///|
pub fn Scene::viewport(self : Scene) -> @spatial.Aabb {
  self.vp
}

///|
/// Number of slots in use (including the root, excluding freed ones).
pub fn Scene::node_count(self : Scene) -> Int {
  self.nodes.length() - self.free.length()
}

///|
/// Total slots ever allocated (the array length).
pub fn Scene::capacity(self : Scene) -> Int {
  self.nodes.length()
}

///|
/// True if `id` refers to a live node.
pub fn Scene::alive(self : Scene, id : Int) -> Bool {
  id >= 0 && id < self.nodes.length() && self.nodes[id].alive
}

///|
/// How many times this slot has been reused. A caller that keeps an id across
/// removals should keep the generation too, and treat a mismatch as "gone".
pub fn Scene::gen(self : Scene, id : Int) -> Int {
  if id < 0 || id >= self.nodes.length() {
    -1
  } else {
    self.nodes[id].gen
  }
}

///|
pub fn Scene::depth_of(self : Scene, id : Int) -> Int {
  self.nodes[id].depth
}

///|
pub fn Scene::parent_of(self : Scene, id : Int) -> Int {
  self.nodes[id].parent
}

///|
/// Children in paint order (first drawn first).
pub fn Scene::children_of(self : Scene, id : Int) -> Array[Int] {
  let out : Array[Int] = []
  let mut c = self.nodes[id].first_child
  while c != NO_NODE {
    out.push(c)
    c = self.nodes[c].next
  }
  out
}

///|
/// Is the node painted?
///
/// Visibility is **inherited**: hiding a node hides its whole subtree (that is
/// what `set_visible` documents), so this walks the ancestor chain instead of
/// reading one flag. Reading only the node's own flag made this predicate
/// disagree with the renderer — `damage_of` refuses to damage anything under a
/// hidden ancestor (nothing was painted there) while `is_visible` claimed the
/// child was visible — and the disagreement showed up as "a box that changed
/// was never damaged" in the damage fuzz, only once a mutation happened to land
/// under a hidden group.
pub fn Scene::is_visible(self : Scene, id : Int) -> Bool {
  if id == NO_NODE || !self.alive(id) {
    return false
  }
  let mut cur = id
  while cur != NO_NODE {
    if (self.nodes[cur].flags & FLAG_HIDDEN) != 0 {
      return false
    }
    cur = self.nodes[cur].parent
  }
  true
}

///|
pub fn Scene::has_clip(self : Scene, id : Int) -> Bool {
  (self.nodes[id].flags & FLAG_CLIP) != 0
}

///|
/// Local transform of a node.
pub fn Scene::trs_of(self : Scene, id : Int) -> Trs {
  self.nodes[id].trs
}

///|
/// The node's geometry in its own space.
pub fn Scene::local_bounds_of(self : Scene, id : Int) -> @spatial.Aabb {
  self.nodes[id].bounds_local
}

///|
/// The node's world matrix. Pulls the ancestor chain up to date if needed
/// (O(depth), no work for nodes that did not change), so this is always exact —
/// not "as of the last flush".
pub fn Scene::world_of(self : Scene, id : Int) -> @math.Mat2x3 {
  self.ensure(id)
  self.nodes[id].world
}

///|
/// The node's own world-space bounds (pulled, see `world_of`).
pub fn Scene::bounds_of(self : Scene, id : Int) -> @spatial.Aabb {
  self.ensure(id)
  self.nodes[id].bounds
}

///|
/// World-space bounds of the subtree rooted here, as of the last `flush()`.
/// Conservative by construction: the local subtree box is placed by the node's
/// matrix, so a rotated group's box is the rotated local box (which contains
/// every descendant, and may exceed the exact union of their world boxes).
pub fn Scene::subtree_bounds_of(self : Scene, id : Int) -> @spatial.Aabb {
  self.ensure(id)
  transform_bounds(self.nodes[id].sub_local, self.nodes[id].world)
}

///|
/// The subtree box in the node's own frame (what a move of this node leaves
/// untouched).
pub fn Scene::subtree_local_of(self : Scene, id : Int) -> @spatial.Aabb {
  self.nodes[id].sub_local
}

///|
/// The node's clip box in its own local space (empty when it has no clip).
pub fn Scene::clip_local_of(self : Scene, id : Int) -> @spatial.Aabb {
  if self.has_clip(id) {
    self.nodes[id].clip_local
  } else {
    @spatial.Aabb::empty()
  }
}

///|
/// The node's clip box in world space (empty when it has no clip).
pub fn Scene::clip_world_of(self : Scene, id : Int) -> @spatial.Aabb {
  self.ensure(id)
  if self.has_clip(id) {
    self.nodes[id].clip_world
  } else {
    @spatial.Aabb::empty()
  }
}

///|
/// Damage accumulated since `begin_frame()`.
pub fn Scene::dirty(self : Scene) -> DirtyRegion {
  self.dirty
}

///|
/// Counters of the last `flush()`.
pub fn Scene::stats(self : Scene) -> SceneStats {
  self.stats
}

///|
/// True if there is work queued for the next `flush()`.
pub fn Scene::pending(self : Scene) -> Bool {
  self.marks.length() > 0
}

///|
/// Start a frame: forget the previous frame's damage and counters. Mutations
/// after this call accumulate damage; `flush()` closes the frame.
pub fn Scene::begin_frame(self : Scene) -> Unit {
  self.dirty.clear()
  self.stats.marks = 0
  self.stats.refreshed = 0
  self.stats.matmuls = 0
  self.stats.promotes = 0
  self.stats.early_stops = 0
  self.stats.post_rects = 0
  self.stats.pre_rects = 0
}

///|
/// Add a node under `parent`. The node starts with untransformed geometry and
/// is queued for the next flush (which is when it enters the damage region).
pub fn Scene::add_node(
  self : Scene,
  parent : Int,
  trs : Trs,
  bounds_local : @spatial.Aabb,
) -> Int {
  if !self.alive(parent) {
    return NO_NODE
  }
  let id = self.alloc(parent, trs, bounds_local)
  self.link_last(parent, id)
  self.mark_node(id)
  id
}

///|
/// Allocate a slot (reusing a freed one when possible) without linking it.
fn Scene::alloc(
  self : Scene,
  parent : Int,
  trs : Trs,
  bounds_local : @spatial.Aabb,
) -> Int {
  let depth = self.nodes[parent].depth + 1
  let node : Node = {
    alive: true,
    gen: 0,
    parent,
    first_child: NO_NODE,
    last_child: NO_NODE,
    next: NO_NODE,
    prev: NO_NODE,
    depth,
    trs,
    bounds_local,
    flags: 0,
    opacity: 1.0,
    clip_local: @spatial.Aabb::empty(),
    mat: @math.Mat2x3::identity(),
    mat_valid: false,
    placed_dirty: false,
    world: @math.Mat2x3::identity(),
    world_ver: 0,
    world_base: 0,
    world_valid: false,
    bounds: @spatial.Aabb::empty(),
    bounds_ver: -1,
    clip_world: @spatial.Aabb::empty(),
    clip_ver: -1,
    sub_local: @spatial.Aabb::empty(),
  }
  if self.free.length() > 0 {
    let id = self.free.pop().unwrap()
    let gen = self.nodes[id].gen + 1
    self.nodes[id] = node
    self.nodes[id].gen = gen
    self.mark_stamp[id] = 0
    id
  } else {
    self.nodes.push(node)
    self.mark_stamp.push(0)
    self.nodes.length() - 1
  }
}

///|
/// Append `id` as the last child of `parent` (last child paints on top).
fn Scene::link_last(self : Scene, parent : Int, id : Int) -> Unit {
  let last = self.nodes[parent].last_child
  self.nodes[id].prev = last
  self.nodes[id].next = NO_NODE
  self.nodes[id].parent = parent
  if last == NO_NODE {
    self.nodes[parent].first_child = id
  } else {
    self.nodes[last].next = id
  }
  self.nodes[parent].last_child = id
}

///|
fn Scene::unlink(self : Scene, id : Int) -> Unit {
  let p = self.nodes[id].parent
  if p == NO_NODE {
    return
  }
  let prev = self.nodes[id].prev
  let next = self.nodes[id].next
  if prev == NO_NODE {
    self.nodes[p].first_child = next
  } else {
    self.nodes[prev].next = next
  }
  if next == NO_NODE {
    self.nodes[p].last_child = prev
  } else {
    self.nodes[next].prev = prev
  }
  self.nodes[id].parent = NO_NODE
  self.nodes[id].prev = NO_NODE
  self.nodes[id].next = NO_NODE
}

///|
/// Remove `id` and its whole subtree. The area the subtree occupied becomes
/// damage; nothing is drawn there afterwards. Returns false if `id` is not a
/// live, non-root node.
pub fn Scene::remove_node(self : Scene, id : Int) -> Bool {
  if !self.alive(id) || id == ROOT {
    return false
  }
  // Damage is where the subtree *was*; one rectangle, because the subtree box
  // already covers every descendant.
  self.mark_pre(id)
  let parent = self.nodes[id].parent
  self.unlink(id)
  // Free the subtree iteratively (a 100k-node subtree must not touch the call
  // stack, and a recursive version would).
  self.scratch.clear()
  self.scratch.push(id)
  while self.scratch.length() > 0 {
    let n = self.scratch.pop().unwrap()
    let mut c = self.nodes[n].first_child
    while c != NO_NODE {
      self.scratch.push(c)
      c = self.nodes[c].next
    }
    self.nodes[n].alive = false
    self.nodes[n].sub_local = @spatial.Aabb::empty()
    self.nodes[n].flags = self.nodes[n].flags | FLAG_HIDDEN
    self.free.push(n)
  }
  if parent != NO_NODE {
    self.mark_node(parent)
  }
  true
}

///|
/// Move a node to another parent, keeping it last in the new parent's paint
/// order. Depth is restored for the whole subtree.
pub fn Scene::reparent(self : Scene, id : Int, new_parent : Int) -> Bool {
  if !self.alive(id) || id == ROOT || !self.alive(new_parent) {
    return false
  }
  // refuse to build a cycle
  let mut p = new_parent
  while p != NO_NODE {
    if p == id {
      return false
    }
    p = self.nodes[p].parent
  }
  self.mark_pre(id)
  let old_parent = self.nodes[id].parent
  self.unlink(id)
  self.link_last(new_parent, id)
  self.fix_depths(id)
  // The world matrix is cached with "my parent's version when I computed it"
  // as its stamp. Moving the node to a *different* parent breaks that link, and
  // the two parents' versions can easily be equal (both fresh scenes, both
  // version 0), so the stamp would silently agree and the subtree would keep its
  // old world matrices. Structural change ⇒ invalidate explicitly; the
  // descendants follow because the node's own version changes when it is
  // recomputed.
  self.nodes[id].world_valid = false
  // Promote the two *parents*, not the node. The node's own subtree box did not
  // change (it is in the node's own frame), so promoting it would hit the early
  // stop immediately and the new parent would never learn about its new child.
  self.mark_node(new_parent)
  if old_parent != NO_NODE {
    self.mark_node(old_parent)
  }
  true
}

///|
/// Restore `depth` for a subtree (iteratively).
fn Scene::fix_depths(self : Scene, id : Int) -> Unit {
  self.scratch.clear()
  self.scratch.push(id)
  while self.scratch.length() > 0 {
    let n = self.scratch.pop().unwrap()
    let d = self.nodes[self.nodes[n].parent].depth + 1
    self.nodes[n].depth = d
    let mut c = self.nodes[n].first_child
    while c != NO_NODE {
      self.scratch.push(c)
      c = self.nodes[c].next
    }
  }
}

///|
/// Set a node's local transform. Equality cut-off: an identical transform does
/// not mark anything, so re-setting the same value (a common thing for bound
/// controls to do every frame) costs one comparison.
pub fn Scene::set_trs(self : Scene, id : Int, trs : Trs) -> Bool {
  if !self.alive(id) {
    return false
  }
  if Trs::equal(self.nodes[id].trs, trs) {
    return false
  }
  self.mark_pre(id)
  self.nodes[id].trs = trs
  self.nodes[id].mat_valid = false
  self.mark_node(id)
  true
}

///|
/// Translate by a delta — the drag path. Equivalent to `set_trs` with `x+dx`,
/// `y+dy`, with the same equality cut-off.
pub fn Scene::move_by(self : Scene, id : Int, dx : Double, dy : Double) -> Bool {
  if !self.alive(id) {
    return false
  }
  if dx == 0.0 && dy == 0.0 {
    return false
  }
  let t = self.nodes[id].trs
  self.set_trs(id, Trs::new(t.x + dx, t.y + dy, t.rot, t.sx, t.sy))
}

///|
/// Change the node's own geometry.
pub fn Scene::set_local_bounds(
  self : Scene,
  id : Int,
  b : @spatial.Aabb,
) -> Bool {
  if !self.alive(id) {
    return false
  }
  if @spatial.Aabb::equal(self.nodes[id].bounds_local, b) {
    return false
  }
  self.mark_pre(id)
  self.nodes[id].bounds_local = b
  self.nodes[id].bounds_ver = -1
  self.mark_node(id)
  true
}

///|
/// Show or hide the node (and, by inheritance, its subtree).
pub fn Scene::set_visible(self : Scene, id : Int, visible : Bool) -> Bool {
  if !self.alive(id) || id == ROOT {
    return false
  }
  let hidden = (self.nodes[id].flags & FLAG_HIDDEN) != 0
  if hidden == !visible {
    return false
  }
  // Hiding damages where the subtree was; showing damages where it will be.
  // (Both directions are handled by the pre/post rectangles.)
  self.mark_pre(id)
  self.nodes[id].flags = if visible {
    self.nodes[id].flags & FLAG_HIDDEN.lnot()
  } else {
    self.nodes[id].flags | FLAG_HIDDEN
  }
  self.nodes[id].bounds_ver = -1
  self.mark_node(id)
  true
}

///|
/// Paint opacity of the node (and, by multiplication, of its subtree).
pub fn Scene::set_opacity(self : Scene, id : Int, v : Double) -> Bool {
  if !self.alive(id) {
    return false
  }
  let nv = if v < 0.0 { 0.0 } else if v > 1.0 { 1.0 } else { v }
  if self.nodes[id].opacity == nv {
    return false
  }
  self.mark_pre(id)
  self.nodes[id].opacity = nv
  self.mark_node(id)
  true
}

///|
pub fn Scene::opacity_of(self : Scene, id : Int) -> Double {
  self.nodes[id].opacity
}

///|
/// Give the node a clip box in its own local space.
pub fn Scene::set_clip(self : Scene, id : Int, box : @spatial.Aabb) -> Bool {
  if !self.alive(id) {
    return false
  }
  self.mark_pre(id)
  self.nodes[id].clip_local = box
  self.nodes[id].flags = self.nodes[id].flags | FLAG_CLIP
  self.nodes[id].clip_ver = -1
  self.mark_node(id)
  true
}

///|
/// Remove the node's clip box.
pub fn Scene::clear_clip(self : Scene, id : Int) -> Bool {
  if !self.alive(id) || !self.has_clip(id) {
    return false
  }
  self.mark_pre(id)
  self.nodes[id].flags = self.nodes[id].flags & FLAG_CLIP.lnot()
  self.nodes[id].clip_ver = -1
  self.mark_node(id)
  true
}

// ---------------------------------------------------------------- invalidation

///|
/// Record the rectangle the node's subtree covers *right now* (cached values,
/// i.e. what the last flushed frame painted). This is the "where it was" half
/// of the damage.
fn Scene::mark_pre(self : Scene, id : Int) -> Unit {
  if !self.alive(id) {
    return
  }
  let r = self.damage_of(id)
  if r.is_empty() {
    return
  }
  self.stats.pre_rects = self.stats.pre_rects + 1
  self.dirty.add_rect(r)
}

///|
/// The world-space rectangle a change to this node can damage: its subtree box
/// placed by its matrix, cut by the clip chain, and empty when the node or any
/// ancestor is hidden (nothing was painted there, so nothing needs repainting).
pub fn Scene::damage_of(self : Scene, id : Int) -> @spatial.Aabb {
  self.ensure(id)
  let box = transform_bounds(self.nodes[id].sub_local, self.nodes[id].world)
  self.clip_to_chain(id, box)
}

///|
/// Queue a node for the next flush. Deduplicated by a stamp that advances once
/// per flush cycle, so a node touched ten times between two frames is queued
/// once.
fn Scene::mark_node(self : Scene, id : Int) -> Unit {
  if id == NO_NODE || !self.alive(id) {
    return
  }
  if self.mark_stamp[id] == self.stamp {
    return
  }
  self.mark_stamp[id] = self.stamp
  self.marks.push(id)
  self.stats.marks = self.stats.marks + 1
}

///|
/// Intersect a world-space rectangle with the clip chain above (and including)
/// `id`, and with the viewport.
fn Scene::clip_to_chain(
  self : Scene,
  id : Int,
  r : @spatial.Aabb,
) -> @spatial.Aabb {
  let mut acc = r.intersect(self.vp)
  let mut cur = id
  while cur != NO_NODE && !acc.is_empty() {
    let n = self.nodes[cur]
    if (n.flags & FLAG_HIDDEN) != 0 {
      return @spatial.Aabb::empty()
    }
    if (n.flags & FLAG_CLIP) != 0 {
      acc = acc.intersect(n.clip_world)
    }
    cur = n.parent
  }
  acc
}

// --------------------------------------------------------------------- flush

///|
/// Bring the scene up to date and close the frame.
///
/// Three passes over the marked set only:
///  1. `ensure` per marked node — pull ancestors, compose matrices (with a
///     validity check so an unchanged parent chain costs two compares);
///  2. `promote` per marked node — rebuild visible-subtree bounds upwards,
///     stopping at the first ancestor whose bounds did not change;
///  3. damage for the new positions, clipped to each node's clip chain.
pub fn Scene::flush(self : Scene) -> SceneStats {
  if self.marks.length() == 0 {
    return self.stats
  }
  for i = 0; i < self.marks.length(); i = i + 1 {
    let id = self.marks[i]
    if self.alive(id) {
      self.ensure(id)
    }
  }
  for i = 0; i < self.marks.length(); i = i + 1 {
    let id = self.marks[i]
    if self.alive(id) {
      self.promote(id)
    }
  }
  for i = 0; i < self.marks.length(); i = i + 1 {
    let id = self.marks[i]
    if !self.alive(id) {
      continue
    }
    let r = self.damage_of(id)
    if !r.is_empty() {
      self.stats.post_rects = self.stats.post_rects + 1
      self.dirty.add_rect(r)
    }
  }
  self.marks.clear()
  // a new flush cycle: the next mark of any node is a new mark
  self.stamp = self.stamp + 1
  self.stats
}

///|
/// Pull `id`'s invariants (local matrix, world matrix, world bounds, world
/// clip) up to date: collect the ancestor chain, then refresh it top-down.
///
/// Always walking to the root is deliberate. An "is this node valid?" check
/// cannot be answered by looking at one node: a parent can be edited without its
/// `world_ver` having moved yet, so a child would happily agree that it is up to
/// date. The walk is `O(depth)` compares and the refresh below does no work for
/// the nodes that did not change, so the chain walk is the whole cost — and
/// depth is bounded by the UI's nesting, not by scene size.
fn Scene::ensure(self : Scene, id : Int) -> Unit {
  if id == NO_NODE || !self.alive(id) {
    return
  }
  self.scratch.clear()
  let mut cur = id
  while cur != NO_NODE {
    self.scratch.push(cur)
    cur = self.nodes[cur].parent
  }
  let mut k = self.scratch.length() - 1
  while k >= 0 {
    self.refresh_node(self.scratch[k])
    k = k - 1
  }
}

///|
/// Refresh `id` only if its own stamps say it is stale, trusting that its
/// parent is already up to date. This is the top-down walk's cheap step: it is
/// O(1) per node instead of the O(depth) chain walk `ensure` does, and it is
/// sound *only* when the caller is descending from a valid parent — which is
/// exactly what a renderer's descent does.
fn Scene::pull_local(self : Scene, id : Int) -> Unit {
  let nd = self.nodes[id]
  let p = nd.parent
  let parent_ver = if p == NO_NODE { 0 } else { self.nodes[p].world_ver }
  if !nd.mat_valid || !nd.world_valid || nd.world_base != parent_ver {
    self.refresh_node(id)
  }
}

///|
/// Recompute one node's cached invariants (its parent must already be fresh).
fn Scene::refresh_node(self : Scene, n : Int) -> Unit {
  let nd = self.nodes[n]
  let mut local_changed = false
  if !nd.mat_valid {
    nd.mat = nd.trs.matrix()
    nd.mat_valid = true
    nd.placed_dirty = true
    local_changed = true
    self.stats.refreshed = self.stats.refreshed + 1
  }
  let p = nd.parent
  let parent_ver = if p == NO_NODE { 0 } else { self.nodes[p].world_ver }
  // Recompute when *either* side of the composition changed. Checking only the
  // parent's version misses the case the whole design is built around: this
  // node's own transform was edited while its parent stood still.
  if local_changed || !nd.world_valid || nd.world_base != parent_ver {
    let w = if p == NO_NODE {
      nd.mat
    } else {
      self.nodes[p].world.compose(nd.mat)
    }
    self.stats.matmuls = self.stats.matmuls + 1
    if !@math.Mat2x3::equal(w, nd.world) {
      nd.world_ver = nd.world_ver + 1
    }
    nd.world = w
    nd.world_base = parent_ver
    nd.world_valid = true
    self.stats.refreshed = self.stats.refreshed + 1
  }
  if nd.bounds_ver != nd.world_ver {
    nd.bounds = transform_bounds(nd.bounds_local, nd.world)
    nd.bounds_ver = nd.world_ver
  }
  if nd.clip_ver != nd.world_ver {
    if (nd.flags & FLAG_CLIP) != 0 {
      nd.clip_world = transform_bounds(nd.clip_local, nd.world)
    } else {
      nd.clip_world = @spatial.Aabb::empty()
    }
    nd.clip_ver = nd.world_ver
  }
}

///|
/// Rebuild `id`'s visible-subtree bounds and propagate upwards until an
/// ancestor comes out unchanged. A change that stays inside the parent's
/// existing bounds costs one rectangle comparison per level.
fn Scene::promote(self : Scene, id : Int) -> Unit {
  let mut cur = id
  while cur != NO_NODE {
    let before = self.nodes[cur].sub_local
    let after = self.recompute_sub(cur)
    // Did this node's *placement* change? Then the box the parent builds from it
    // is stale even though this node's own box is identical (a pure rotation
    // keeps the local box but moves it in the parent's frame).
    let placed = self.nodes[cur].placed_dirty
    self.nodes[cur].placed_dirty = false
    self.stats.promotes = self.stats.promotes + 1
    self.nodes[cur].sub_local = after
    if !placed && @spatial.Aabb::equal(before, after) {
      self.stats.early_stops = self.stats.early_stops + 1
      break
    }
    cur = self.nodes[cur].parent
  }
}

///|
/// Subtree bounds in `n`'s own frame: its local geometry unioned with every
/// child's subtree box *placed by that child's local matrix* (the child's box is
/// in the child's frame, so it has to be moved into this one).
///
/// Purely geometric — visibility is a paint property and is applied by the
/// damage path (`clip_to_chain`), not here, so that hiding and showing a node
/// never has to walk its descendants.
///
/// The children's local matrices are valid here: `flush` refreshes every marked
/// node (pass 1) before promoting anything (pass 2), and an unmarked node's
/// matrix is valid by definition.
fn Scene::recompute_sub(self : Scene, n : Int) -> @spatial.Aabb {
  let mut s = self.nodes[n].bounds_local
  let mut c = self.nodes[n].first_child
  while c != NO_NODE {
    s = s.union(transform_bounds(self.nodes[c].sub_local, self.nodes[c].mat))
    c = self.nodes[c].next
  }
  s
}

// ------------------------------------------------------------- interaction

///|
/// Topmost node whose own bounds contain the point, or `NO_NODE`. Descends in
/// reverse paint order (later siblings first) and prunes whole subtrees whose
/// visible bounds miss the point; a node's clip box (and every clipped
/// ancestor's) bounds the hit.
pub fn Scene::hit_test(self : Scene, x : Double, y : Double) -> Int {
  if !self.alive(ROOT) || !self.is_visible(ROOT) {
    return NO_NODE
  }
  self.ensure(ROOT)
  if !self.subtree_bounds_of(ROOT).contains_point(x, y) {
    return NO_NODE
  }
  // every node visited below is validated on the way down, top-down, so the
  // descent never reads a stale matrix and each step is O(1)
  self.id_stack.clear()
  self.clip_stack.clear()
  self.id_stack.push(ROOT)
  self.clip_stack.push(self.vp)
  while self.id_stack.length() > 0 {
    let v = self.id_stack.pop().unwrap()
    let clip = self.clip_stack.pop().unwrap()
    if v < 0 {
      // the "test this node itself" marker: children are behind it in the stack
      let id = v.lnot()
      let b = self.nodes[id].bounds
      if b.contains_point(x, y) && clip.contains_point(x, y) {
        return id
      }
      continue
    }
    self.pull_local(v)
    let node = self.nodes[v]
    if (node.flags & FLAG_HIDDEN) != 0 {
      continue
    }
    if !transform_bounds(self.nodes[v].sub_local, node.world).contains_point(
        x, y,
      ) {
      continue
    }
    let mut inner = clip
    if (node.flags & FLAG_CLIP) != 0 {
      inner = clip.intersect(node.clip_world)
    }
    // push self first so children (pushed after) are examined before it.
    // `lnot` makes the id negative, which is how the marker is recognised above.
    self.id_stack.push(v.lnot())
    self.clip_stack.push(clip)
    // Push children in document order: the stack pops the *last* pushed first,
    // so the child that paints last is examined first (reverse paint order).
    let mut c = node.first_child
    while c != NO_NODE {
      self.id_stack.push(c)
      self.clip_stack.push(inner)
      c = self.nodes[c].next
    }
  }
  NO_NODE
}

// ------------------------------------------------------------------ display

///|
/// Graphviz dump of the tree: one node per scene node, with its transform and
/// flags. Used by the inspector and by tests that assert structure.
pub fn Scene::to_dot(self : Scene) -> String {
  let sb = StringBuilder()
  sb.write_string("digraph scene {\n")
  for i = 0; i < self.nodes.length(); i = i + 1 {
    if !self.nodes[i].alive {
      continue
    }
    sb.write_string("  n")
    sb.write_string(i.to_string())
    sb.write_string(" [label=\"#")
    sb.write_string(i.to_string())
    sb.write_string(" ")
    sb.write_string(self.nodes[i].trs.to_display())
    if (self.nodes[i].flags & FLAG_HIDDEN) != 0 {
      sb.write_string(" hidden")
    }
    if (self.nodes[i].flags & FLAG_CLIP) != 0 {
      sb.write_string(" clip")
    }
    sb.write_string("\"];\n")
  }
  for i = 0; i < self.nodes.length(); i = i + 1 {
    if !self.nodes[i].alive {
      continue
    }
    let mut c = self.nodes[i].first_child
    while c != NO_NODE {
      sb.write_string("  n")
      sb.write_string(i.to_string())
      sb.write_string(" -> n")
      sb.write_string(c.to_string())
      sb.write_string(";\n")
      c = self.nodes[c].next
    }
  }
  sb.write_string("}\n")
  sb.to_string()
}
