///| Convolution: the decision between direct and FFT is *measured*, not
/// guessed, and the measured answer changed the design (see docs/04).
///
/// First implementation notes that survived contact with the benchmark:
///  * a single-shot FFT of the padded length loses badly when n >> k, because
///    the transform is sized n+k-1 for only k non-zero taps — the plan, the
///    zero padding and three full-length transforms are all wasted;
///  * Bluestein (needed when the padded length is not a power of two) costs
///    ~3x a power-of-two transform, so the padded length is always rounded up
///    to a power of two;
///  * therefore the FFT branch is implemented as *overlap-add with a planned
///    transform that is reused across blocks*, and the plan is owned by a
///    reusable `Convolver`. Allocation happens once per kernel, not per call.

///|
pub(all) enum ConvMethod {
  Direct
  OverlapAdd
} derive(Eq)

///|
pub extend ConvMethod with Eq::{equal, not_equal}

///|
pub impl @debug.Debug for ConvMethod with fn to_repr(self) {
  match self {
    Direct => @debug.Repr::literal("Direct")
    OverlapAdd => @debug.Repr::literal("OverlapAdd")
  }
}

///|
pub extend ConvMethod with @debug.Debug::{to_repr}

///|
/// Pick the cheaper method for signal length n and kernel length k.
///
/// Cost model (ops, measured against the benches in this package):
///   direct     : n * k
///   overlap-add: n * log2(B + k) * 3 with B = max(4k, 256), plus one plan
/// The model is honest about the constant factor 3 (two transforms per block
/// plus the pointwise multiply).
pub fn choose_method(n : Int, k : Int) -> ConvMethod {
  if k <= 1 {
    return ConvMethod::Direct
  }
  let block = Int::max(4 * k, 256)
  let size = next_pow2(block + k - 1)
  let mut log2sz = 0.0
  let mut v = 1
  while v < size {
    v = v << 1
    log2sz = log2sz + 1.0
  }
  let direct = n.to_double() * k.to_double()
  let overlap = 3.0 * n.to_double() * log2sz
  if direct <= overlap {
    ConvMethod::Direct
  } else {
    ConvMethod::OverlapAdd
  }
}

///|
/// Direct (naive) convolution: the reference implementation the FFT path is
/// tested against, and the fast path for small kernels.
pub fn convolve_direct(
  a : FixedArray[Double],
  na : Int,
  b : FixedArray[Double],
  nb : Int,
  out : FixedArray[Double],
) -> Unit {
  let n_out = na + nb - 1
  for i = 0; i < n_out; i = i + 1 {
    out[i] = 0.0
  }
  for i = 0; i < na; i = i + 1 {
    let ai = a[i]
    if ai != 0.0 {
      for j = 0; j < nb; j = j + 1 {
        out[i + j] = out[i + j] + ai * b[j]
      }
    }
  }
}

///|
/// Single-shot FFT convolution (padded to a power of two so Bluestein is
/// never used). Kept for cases where n and k are comparable in size; for
/// long signals prefer `Convolver`.
pub fn convolve_fft(
  a : FixedArray[Double],
  na : Int,
  b : FixedArray[Double],
  nb : Int,
  out : FixedArray[Double],
) -> Unit {
  let n_out = na + nb - 1
  let n = next_pow2(n_out)
  let plan = Fft::plan(n)
  let re = FixedArray::make(n, 0.0)
  let im = FixedArray::make(n, 0.0)
  let re2 = FixedArray::make(n, 0.0)
  let im2 = FixedArray::make(n, 0.0)
  for i = 0; i < na; i = i + 1 {
    re[i] = a[i]
  }
  for i = 0; i < nb; i = i + 1 {
    re2[i] = b[i]
  }
  plan.forward(re, im)
  plan.forward(re2, im2)
  for i = 0; i < n; i = i + 1 {
    let xr = re[i]
    let xi = im[i]
    let yr = re2[i]
    let yi = im2[i]
    re[i] = xr * yr - xi * yi
    im[i] = xr * yi + xi * yr
  }
  plan.inverse(re, im)
  for i = 0; i < n_out; i = i + 1 {
    out[i] = re[i]
  }
}

///|
/// Streaming convolution for long signals against a fixed kernel:
/// overlap-add with a power-of-two transform, plan reused for every block.
/// This is the form @fx uses for full-image blurs.
pub(all) struct OverlapAdd {
  plan : Fft
  hop : Int
  nk : Int
  kernel_re : FixedArray[Double]
  kernel_im : FixedArray[Double]
  tmp_re : FixedArray[Double]
  tmp_im : FixedArray[Double]
}

///|
pub fn OverlapAdd::new(
  kernel : FixedArray[Double],
  nk : Int,
  block? : Int,
) -> OverlapAdd {
  let blk = match block {
    Some(b) => Int::max(1, b)
    None => Int::max(256, nk * 4)
  }
  // The transform length is rounded up to a power of two so that the blocks
  // never fall onto the Bluestein path, and the hop is what is left of the
  // transform after the kernel has covered it (overlap-add semantics).
  let n = next_pow2(blk + nk - 1)
  let plan = Fft::plan(n)
  let k_re = FixedArray::make(n, 0.0)
  let k_im = FixedArray::make(n, 0.0)
  for i = 0; i < nk; i = i + 1 {
    k_re[i] = kernel[i]
  }
  plan.forward(k_re, k_im)
  {
    plan,
    hop: n - nk + 1,
    nk,
    kernel_re: k_re,
    kernel_im: k_im,
    tmp_re: FixedArray::make(n, 0.0),
    tmp_im: FixedArray::make(n, 0.0),
  }
}

///|
/// Full linear convolution of a long signal with the planned kernel, using
/// overlap-add so that memory is O(block + kernel) rather than O(signal).
pub fn OverlapAdd::run(
  self : OverlapAdd,
  x : FixedArray[Double],
  nx : Int,
  out : FixedArray[Double],
) -> Unit {
  let n = self.plan.n
  let nk = self.nk
  let hop = n - nk + 1
  let n_out = nx + nk - 1
  for i = 0; i < n_out; i = i + 1 {
    out[i] = 0.0
  }
  let mut pos = 0
  while pos < nx {
    let len = Int::min(hop, nx - pos)
    for i = 0; i < n; i = i + 1 {
      self.tmp_re[i] = 0.0
      self.tmp_im[i] = 0.0
    }
    for i = 0; i < len; i = i + 1 {
      self.tmp_re[i] = x[pos + i]
    }
    self.plan.forward(self.tmp_re, self.tmp_im)
    for i = 0; i < n; i = i + 1 {
      let xr = self.tmp_re[i]
      let xi = self.tmp_im[i]
      let yr = self.kernel_re[i]
      let yi = self.kernel_im[i]
      self.tmp_re[i] = xr * yr - xi * yi
      self.tmp_im[i] = xr * yi + xi * yr
    }
    self.plan.inverse(self.tmp_re, self.tmp_im)
    let valid = Int::min(len + nk - 1, n_out - pos)
    for i = 0; i < valid; i = i + 1 {
      out[pos + i] = out[pos + i] + self.tmp_re[i]
    }
    pos = pos + len
  }
}

///|
/// One allocation per kernel: plan + spectral kernel live here, and every
/// `run` is allocation-free. This is the object @fx keeps for a blur pass.
pub(all) struct Convolver {
  mode : ConvMethod
  kernel : FixedArray[Double]
  nk : Int
  oa : OverlapAdd?
}

///|
pub fn Convolver::new(
  kernel : FixedArray[Double],
  nk : Int,
  n? : Int,
) -> Convolver {
  let n_hint = match n {
    Some(v) => v
    None => Int::max(1024, nk * 8)
  }
  let mode = choose_method(n_hint, nk)
  let oa = match mode {
    Direct => None
    OverlapAdd => Some(OverlapAdd::new(kernel, nk))
  }
  { mode, kernel: kernel.copy(), nk, oa, }
}

///|
/// Convolve `x[0..nx)` into `out[0..nx+nk-1)`.
pub fn Convolver::run(
  self : Convolver,
  x : FixedArray[Double],
  nx : Int,
  out : FixedArray[Double],
) -> ConvMethod {
  match self.oa {
    Some(oa) => oa.run(x, nx, out)
    None =>
      // direct path: the stored kernel is already an owned array, so there is
      // nothing to copy (an earlier version copied it on every call).
      convolve_direct(x, nx, self.kernel, self.nk, out)
  }
  self.mode
}

///|
/// Auto-selecting one-shot convolution (allocates; use `Convolver` in hot
/// paths).
pub fn convolve(
  a : FixedArray[Double],
  na : Int,
  b : FixedArray[Double],
  nb : Int,
  out : FixedArray[Double],
) -> ConvMethod {
  let chosen = choose_method(na, nb)
  match chosen {
    Direct => convolve_direct(a, na, b, nb, out)
    OverlapAdd => {
      let oa = OverlapAdd::new(b, nb)
      oa.run(a, na, out)
    }
  }
  chosen
}
