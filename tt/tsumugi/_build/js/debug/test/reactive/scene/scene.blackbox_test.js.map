///| Axis-aligned boxes and the ray tests that go with them.
///
/// This is the smallest file in the package and the one everything else leans
/// on, including `render/light` (tile vs light bounds) and `render/raster`
/// (tile vs primitive bounds). Two disciplines are worth stating because they
/// are what make the rest of the package fast:
///
///  * `Aabb` is `#valtype` — four doubles, unboxed, so packing a million of
///    them is 32 MB of contiguous doubles and not a million heap objects.
///  * the ray test is the slab method, written with explicit zero-direction
///    branches: the branchless `1/d = ±inf` form produces NaN when the origin
///    lies exactly on a slab plane, and a point on a plane is not a corner
///    case a renderer can afford to get wrong.

///|
#valtype
pub(all) struct Aabb {
  min_x : Double
  min_y : Double
  max_x : Double
  max_y : Double
} derive(Eq)

///|
pub extend Aabb with Eq::{equal, not_equal}

///|
/// `[min_x, min_y, max_x, max_y]`, for test failures and debug output.
pub fn Aabb::to_display(self : Aabb) -> String {
  "[\{self.min_x}, \{self.min_y}, \{self.max_x}, \{self.max_y}]"
}

///|
pub impl @debug.Debug for Aabb with fn to_repr(self) {
  @debug.Repr::literal(self.to_display())
}

///|
pub extend Aabb with @debug.Debug::{to_repr}

///|
pub fn Aabb::new(
  min_x : Double,
  min_y : Double,
  max_x : Double,
  max_y : Double,
) -> Aabb {
  { min_x, min_y, max_x, max_y, }
}

///|
/// A box that contains nothing (for fold-style accumulation).
pub fn Aabb::empty() -> Aabb {
  { min_x: 1.0e308, min_y: 1.0e308, max_x: -1.0e308, max_y: -1.0e308, }
}

///|
pub fn Aabb::is_empty(self : Aabb) -> Bool {
  self.min_x > self.max_x || self.min_y > self.max_y
}

///|
pub fn Aabb::union(self : Aabb, o : Aabb) -> Aabb {
  {
    min_x: if self.min_x < o.min_x {
      self.min_x
    } else {
      o.min_x
    },
    min_y: if self.min_y < o.min_y {
      self.min_y
    } else {
      o.min_y
    },
    max_x: if self.max_x > o.max_x {
      self.max_x
    } else {
      o.max_x
    },
    max_y: if self.max_y > o.max_y {
      self.max_y
    } else {
      o.max_y
    },
  }
}

///|
/// The overlap of two boxes; an empty box if they do not overlap. Clipping
/// needs this (`reactive/scene` cuts a node's damage against its clip chain),
/// and it was the one AABB operation missing — `overlaps` answers the question
/// but throws the answer away.
pub fn Aabb::intersect(self : Aabb, o : Aabb) -> Aabb {
  let min_x = Double::max(self.min_x, o.min_x)
  let min_y = Double::max(self.min_y, o.min_y)
  let max_x = Double::min(self.max_x, o.max_x)
  let max_y = Double::min(self.max_y, o.max_y)
  if min_x > max_x || min_y > max_y {
    Aabb::empty()
  } else {
    { min_x, min_y, max_x, max_y, }
  }
}

///|
pub fn Aabb::expand_d(self : Aabb, d : Double) -> Aabb {
  {
    min_x: self.min_x - d,
    min_y: self.min_y - d,
    max_x: self.max_x + d,
    max_y: self.max_y + d,
  }
}

///|
/// Touching counts as overlapping (closed boxes), which is what a tile/light
/// cull wants: a light exactly on a tile edge lights that tile.
pub fn Aabb::overlaps(self : Aabb, o : Aabb) -> Bool {
  self.min_x <= o.max_x &&
  o.min_x <= self.max_x &&
  self.min_y <= o.max_y &&
  o.min_y <= self.max_y
}

///|
pub fn Aabb::contains_point(self : Aabb, x : Double, y : Double) -> Bool {
  x >= self.min_x && x <= self.max_x && y >= self.min_y && y <= self.max_y
}

///|
pub fn Aabb::contains_box(self : Aabb, o : Aabb) -> Bool {
  o.min_x >= self.min_x &&
  o.max_x <= self.max_x &&
  o.min_y >= self.min_y &&
  o.max_y <= self.max_y
}

///|
pub fn Aabb::width(self : Aabb) -> Double {
  self.max_x - self.min_x
}

///|
pub fn Aabb::height(self : Aabb) -> Double {
  self.max_y - self.min_y
}

///|
/// Half-perimeter, the SAH surface proxy in 2D.
pub fn Aabb::half_perimeter(self : Aabb) -> Double {
  self.width() + self.height()
}

///|
pub fn Aabb::center_x(self : Aabb) -> Double {
  (self.min_x + self.max_x) * 0.5
}

///|
pub fn Aabb::center_y(self : Aabb) -> Double {
  (self.min_y + self.max_y) * 0.5
}

///|
/// Slab-method ray/box intersection. `main` semantics: returns the entry
/// distance `t` (in units of the direction vector) or `None`. Directions do
/// not have to be normalised; a zero component is handled exactly.
pub fn ray_aabb(
  ox : Double,
  oy : Double,
  dx : Double,
  dy : Double,
  b : Aabb,
) -> Double? {
  let mut tmin = -1.0e308
  let mut tmax = 1.0e308
  // x slab
  if dx == 0.0 {
    if ox < b.min_x || ox > b.max_x {
      return None
    }
  } else {
    let inv = 1.0 / dx
    let t1 = (b.min_x - ox) * inv
    let t2 = (b.max_x - ox) * inv
    let lo = if t1 < t2 { t1 } else { t2 }
    let hi = if t1 < t2 { t2 } else { t1 }
    if lo > tmin {
      tmin = lo
    }
    if hi < tmax {
      tmax = hi
    }
    if tmin > tmax {
      return None
    }
  }
  // y slab
  if dy == 0.0 {
    if oy < b.min_y || oy > b.max_y {
      return None
    }
  } else {
    let inv = 1.0 / dy
    let t1 = (b.min_y - oy) * inv
    let t2 = (b.max_y - oy) * inv
    let lo = if t1 < t2 { t1 } else { t2 }
    let hi = if t1 < t2 { t2 } else { t1 }
    if lo > tmin {
      tmin = lo
    }
    if hi < tmax {
      tmax = hi
    }
    if tmin > tmax {
      return None
    }
  }
  // the box is behind the origin when the whole interval is negative
  if tmax < 0.0 {
    return None
  }
  if tmin < 0.0 {
    return Some(0.0)
  }
  Some(tmin)
}

///|
/// Cheap "does this ray touch the box at all" used by shadow/occlusion tests.
pub fn ray_aabb_hit(
  ox : Double,
  oy : Double,
  dx : Double,
  dy : Double,
  b : Aabb,
) -> Bool {
  match ray_aabb(ox, oy, dx, dy, b) {
    Some(_) => true
    None => false
  }
}

///|
/// Ray/sphere: solves |o + t·d − c|² = r² and returns the first positive
/// root (or 0 when the origin is inside). `d` need not be normalised, so the
/// returned `t` is in the same units as `d` — same convention as `ray_aabb`.
pub fn ray_sphere(
  ox : Double,
  oy : Double,
  dx : Double,
  dy : Double,
  cx : Double,
  cy : Double,
  r : Double,
) -> Double? {
  let fx = ox - cx
  let fy = oy - cy
  let a = dx * dx + dy * dy
  if a == 0.0 {
    return None
  }
  let b = 2.0 * (fx * dx + fy * dy)
  let c = fx * fx + fy * fy - r * r
  let disc = b * b - 4.0 * a * c
  if disc < 0.0 {
    return None
  }
  let sd = disc.sqrt()
  let t0 = (-b - sd) / (2.0 * a)
  let t1 = (-b + sd) / (2.0 * a)
  if t0 >= 0.0 {
    return Some(t0)
  }
  if t1 >= 0.0 {
    return Some(0.0)
  }
  None
}
