///| Bit-level containers. The dirty-mask word of @scene, the z-occupancy mask
/// of @light and the free-slot map of the arenas all share this logic.

///|
/// Dynamic bitset with word-level operations and iteration over set bits.
pub(all) struct BitSet {
  words : Array[UInt64]
  len : Int
}

///|
pub fn BitSet::new(bits : Int) -> BitSet {
  let words = Array::make((bits + 63) / 64, 0UL)
  { words, len: bits, }
}

///|
#inline
pub fn BitSet::set(self : BitSet, i : Int) -> Unit {
  if i >= 0 && i < self.len {
    self.words[i / 64] = self.words[i / 64].lor(1UL << (i % 64))
  }
}

///|
#inline
pub fn BitSet::clear_bit(self : BitSet, i : Int) -> Unit {
  if i >= 0 && i < self.len {
    self.words[i / 64] = self.words[i / 64].land(
      0xFFFFFFFFFFFFFFFFUL.lxor(1UL << (i % 64)),
    )
  }
}

///|
#inline
pub fn BitSet::get(self : BitSet, i : Int) -> Bool {
  if i < 0 || i >= self.len {
    false
  } else {
    ((self.words[i / 64] >> (i % 64)) & 1UL) == 1UL
  }
}

///|
pub fn BitSet::clear_all(self : BitSet) -> Unit {
  for i = 0; i < self.words.length(); i = i + 1 {
    self.words[i] = 0UL
  }
}

///|
pub fn BitSet::count(self : BitSet) -> Int {
  let mut total = 0
  for w in self.words {
    total = total + popcount64(w)
  }
  total
}

///|
/// Population count via the compiler intrinsic on the two 32-bit halves
/// (there is no i64 popcnt intrinsic exposed, so this is exact: 2 popcnt).
#inline
pub fn popcount64(w : UInt64) -> Int {
  w.popcnt()
}

///|
/// Index of the lowest set bit, or -1 when the word is empty.
#inline
pub fn lowest_bit(w : UInt64) -> Int {
  if w == 0UL {
    -1
  } else {
    w.ctz()
  }
}

///|
/// Iterate set-bit indices without allocating a list.
pub fn BitSet::for_each_set(self : BitSet, f : (Int) -> Unit) -> Unit {
  for wi = 0; wi < self.words.length(); wi = wi + 1 {
    let mut w = self.words[wi]
    while w != 0UL {
      let bit = lowest_bit(w)
      f(wi * 64 + bit)
      w = w & (w - 1UL)
    }
  }
}
