///| Fixed-point trigonometry over a turn-based angle unit.
///
/// Angle convention (fixed logic, data-only inputs):
///   full turn == 65536 raw == 2*pi, so one quadrant == 16384 raw.
/// Values are Q16.16 (1.0 == 65536).
///
/// Two interchangeable evaluators, because the table/polynomial trade-off is
/// measurable and the call site should be able to choose:
///  * `SinCosTable` — quarter-wave table + linear interpolation. The error
///    floor is set by the Q16 storage quantisation (~1.5e-5), so beyond a few
///    hundred entries a bigger table buys almost nothing: measured 2.5e-5 for
///    256 entries and 2.0e-5 for 1024 entries.
///  * `sin_turn_poly` / `cos_turn_poly` — table-free minimax polynomial
///    evaluated with Q32 intermediates, ~1e-7 absolute, no memory.

///|
pub fn turn_from_radians(rad : Double) -> Int {
  (rad / @tm.TAU * 65536.0).round().to_int()
}

///|
pub fn turn_to_radians(raw : Int) -> Double {
  raw.to_double() / 65536.0 * @tm.TAU
}

///|
/// Split a turn angle into quadrant (0..3) and within-quadrant remainder
/// (0..16384], both integers — no floating point involved.
fn quadrant_split(raw : Int) -> (Int, Int) {
  let mut a = raw % 65536
  if a < 0 {
    a = a + 65536
  }
  (a / 16384, a % 16384)
}

///|
pub(all) struct SinCosTable {
  quarter : FixedArray[Int]
  entries : Int
}

///|
/// Build the quarter-wave table. `entries` sets the accuracy/cache
/// trade-off; error is quantisation-bound (~2e-5) once entries >= 256.
pub fn SinCosTable::new(entries? : Int) -> SinCosTable {
  let n = match entries {
    Some(e) => Int::max(4, e)
    None => 256
  }
  let quarter : FixedArray[Int] = FixedArray::make(n + 1, 0)
  for i = 0; i <= n; i = i + 1 {
    let t = i.to_double() / n.to_double() * (@tm.PI / 2.0)
    quarter[i] = (@tm.sin(t) * 65536.0).round().to_int()
  }
  { quarter, entries: n, }
}

///|
/// Interpolated value of the quarter wave at `w` in [0, 16384].
fn SinCosTable::quarter_at(self : SinCosTable, w : Int) -> Int {
  // scale w (0..16384) to table units: idx_f = w * n / 16384 in Q16
  let idx_f = (w.to_int64() * self.entries.to_int64()) << 2 >> 16
  let mut idx = idx_f.to_int()
  let frac = (w.to_int64() * self.entries.to_int64() * 4 % 65536).to_int()
  if idx > self.entries {
    idx = self.entries
  }
  let lo = self.quarter[idx]
  let hi = self.quarter[Int::min(idx + 1, self.entries)]
  lo + (((hi - lo).to_int64() * frac.to_int64()) >> 16).to_int()
}

///|
/// (sin, cos) in Q16.16 for an angle in turns.
pub fn SinCosTable::sin_cos(self : SinCosTable, raw : Int) -> (Int, Int) {
  let (q, w) = quadrant_split(raw)
  let s = self.quarter_at(w)
  let c = self.quarter_at(16384 - w)
  match q {
    0 => (s, c)
    1 => (c, -s)
    2 => (-s, -c)
    _ => (-c, s)
  }
}

///|
pub fn SinCosTable::sin(self : SinCosTable, raw : Int) -> Int {
  let (s, _) = self.sin_cos(raw)
  s
}

///|
pub fn SinCosTable::cos(self : SinCosTable, raw : Int) -> Int {
  let (_, c) = self.sin_cos(raw)
  c
}

// --- Alternative: table-free polynomials ----------------------------------

///|
const Q32 : Int64 = 4294967296L

///|
/// Q32 x Q32 -> Q32 multiplication that stays inside Int64 by shifting the
/// left operand down first. A naive `(a * b) >> 32` overflows as soon as
/// |a| > ~1.4 (i.e. for x > pi/4), which is exactly the bug this guards
/// against — the intermediate is bounded to |va*vb| * 2^48 <= 2^51 here.
#inline
fn mul_q32(a : Int64, b : Int64) -> Int64 {
  ((a >> 16) * b) >> 16
}

///|
/// Minimax odd polynomial for sin on [-pi/4, pi/4] (Cephes coefficients),
/// evaluated in Q32 so the Q16 output keeps ~1e-7 accuracy. Input is Q16
/// radians, output Q16.
fn poly_sin_rad(x_q16 : Int64) -> Int64 {
  let x32 = x_q16 << 16 // Q32 radians
  let x2 = mul_q32(x32, x32)
  let c1 : Int64 = -715827883L // -1/6
  let c2 : Int64 = 35791394L // 1/120
  let c3 : Int64 = -852355L // -1/5040
  let mut t = mul_q32(x2, c3)
  t = mul_q32(x2, c2 + t)
  t = mul_q32(x2, c1 + t)
  mul_q32(x32, Q32 + t) >> 16 // Q32 result -> Q16
}

///|
/// Same construction for cos on [-pi/4, pi/4].
fn poly_cos_rad(x_q16 : Int64) -> Int64 {
  let x32 = x_q16 << 16
  let x2 = mul_q32(x32, x32)
  let c1 : Int64 = -2147483648L // -1/2
  let c2 : Int64 = 178956971L // 1/24
  let c3 : Int64 = -5965232L // -1/720
  let mut t = mul_q32(x2, c3)
  t = mul_q32(x2, c2 + t)
  t = mul_q32(x2, c1 + t)
  (Q32 + t) >> 16
}

///|
/// Quarter-wave value sin(w * pi/2 / 16384) for w in [0, 16384], in Q16.
/// Reduction to [0, pi/4] so the polynomial stays inside its accuracy window.
fn sin_quarter_poly(w : Int) -> Int {
  // w * (pi/2) / 16384 in Q16 radians  ==  w * 102944 / 16384
  if w <= 8192 {
    let x = (w.to_int64() * 102944L) >> 14
    poly_sin_rad(x).to_int()
  } else {
    // sin(pi/2 - a) = cos(a)
    let a = ((16384 - w).to_int64() * 102944L) >> 14
    poly_cos_rad(a).to_int()
  }
}

///|
/// Table-free sine; angle in turns, result Q16.16.
pub fn sin_turn_poly(raw : Int) -> Int {
  let (q, w) = quadrant_split(raw)
  let s = sin_quarter_poly(w)
  let c = sin_quarter_poly(16384 - w)
  match q {
    0 => s
    1 => c
    2 => -s
    _ => -c
  }
}

///|
/// Table-free cosine; angle in turns, result Q16.16.
pub fn cos_turn_poly(raw : Int) -> Int {
  sin_turn_poly(raw + 16384)
}

///|
/// atan(r) for r in [0, 1], returned in turns-Q16 (1/8 turn == 8192 units),
/// using a degree-9 odd minimax polynomial (max error 6.6e-5 rad) evaluated
/// in Q32 and then converted from radians to turns.
fn atan_unit_turns(r_q16 : Int64) -> Int64 {
  let r32 = r_q16 << 16
  let r2 = mul_q32(r32, r32)
  let c1 : Int64 = 4294392015L // 0.9998660
  let c2 : Int64 = -1418716536L // -0.3302995
  let c3 : Int64 = 773701350L // 0.1801410
  let c4 : Int64 = -365656648L // -0.0851330
  let c5 : Int64 = 89494526L // 0.0208351
  // Horner from the highest power down: atan(r)/r = c1 + r2*(c2 + r2*(...))
  let mut t = mul_q32(r2, c5)
  t = c4 + mul_q32(r2, t)
  t = c3 + mul_q32(r2, t)
  t = c2 + mul_q32(r2, t)
  t = c1 + mul_q32(r2, t)
  let rad32 = mul_q32(r32, t) // Q32 radians
  // turns_Q16 = rad * 65536/(2*pi); the factor below is 65536/(2*pi) in Q16,
  // so the product is Q48 and two 16-bit shifts land back on Q16.
  let factor : Int64 = 683565262L
  mul_q32(rad32, factor) >> 16
}

///|
/// atan2 in fixed point, output in turns (matches the angle convention),
/// normalised to [0, 65536). Error < 1e-4 turn (< 6e-4 rad).
pub fn atan2_turn(y : Int, x : Int) -> Int {
  if x == 0 && y == 0 {
    return 0
  }
  let ay = if y < 0 { -y } else { y }
  let ax = if x < 0 { -x } else { x }
  let angle : Int64 = if ax >= ay {
    if ax == 0 {
      0L
    } else {
      atan_unit_turns((ay.to_int64() << 16) / ax.to_int64())
    }
  } else if ay == 0 {
    0L
  } else {
    16384L - atan_unit_turns((ax.to_int64() << 16) / ay.to_int64())
  }
  let mut a : Int64 = match (x < 0, y < 0) {
    (false, false) => angle
    (true, false) => 32768L - angle
    (true, true) => 32768L + angle
    (false, true) => 65536L - angle
  }
  a = a % 65536L
  if a < 0 {
    a = a + 65536L
  }
  a.to_int()
}
