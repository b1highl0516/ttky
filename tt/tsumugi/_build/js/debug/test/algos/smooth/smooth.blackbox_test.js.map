///| Interactive signal conditioning: the layer between raw input events and
/// the numbers the scene actually uses.
///
/// This is where "feel" is decided, and it is arithmetic, not taste:
///
///  * `OneEuro`  — the 1€ filter (Casiez et al. 2012): a low-pass whose cutoff
///    rises with the signal's own speed, so slow motion is smooth and fast
///    motion has no lag. This is what makes dragging feel attached to the
///    cursor instead of floaty.
///  * `Spring`   — an analytic critically damped spring. Solved in closed form,
///    so step size cannot destabilise it (an Euler spring explodes when the
///    frame stalls; that is a real bug, not a theoretical one).
///  * `Kalman1D` — constant-velocity Kalman filter for noisy input devices.
///  * `Hysteresis` — Schmitt trigger, for anything that must not chatter.

///|
/// 1€ filter state for one scalar channel.
pub(all) struct OneEuro {
  min_cutoff : Double
  beta : Double
  d_cutoff : Double
  mut x_prev : Double
  mut dx_prev : Double
  mut started : Bool
}

///|
/// `min_cutoff` in Hz (lower = smoother when still), `beta` = how fast the
/// cutoff opens up with speed, `d_cutoff` in Hz for the derivative filter.
pub fn OneEuro::new(
  min_cutoff : Double,
  beta : Double,
  d_cutoff : Double,
) -> OneEuro {
  { min_cutoff, beta, d_cutoff, x_prev: 0.0, dx_prev: 0.0, started: false, }
}

///|
/// Smoothing factor for a cutoff frequency in Hz and a sample period in
/// seconds: `alpha = 1/(1 + tau/Te)` with `tau = 1/(2π fc)`.
pub fn alpha_for(cutoff : Double, dt : Double) -> Double {
  let tau = 1.0 / (2.0 * @cmath.PI * cutoff)
  1.0 / (1.0 + tau / dt)
}

///|
/// Filter one raw sample. The sample period must be the real one (frame time),
/// not an assumed 16.7 ms — that is the whole point of the filter.
pub fn OneEuro::step(self : OneEuro, x : Double, dt : Double) -> Double {
  if !self.started {
    self.started = true
    self.x_prev = x
    self.dx_prev = 0.0
    return x
  }
  // derivative estimate, filtered with its own (fixed) cutoff
  let dx = (x - self.x_prev) / dt
  let a_d = alpha_for(self.d_cutoff, dt)
  let dx_hat = a_d * dx + (1.0 - a_d) * self.dx_prev
  // the cutoff opens with the filtered speed
  let cutoff = self.min_cutoff + self.beta * dx_hat.abs()
  let a = alpha_for(cutoff, dt)
  let x_hat = a * x + (1.0 - a) * self.x_prev
  self.x_prev = x_hat
  self.dx_prev = dx_hat
  x_hat
}

///|
/// Two channels (e.g. pointer x/y) sharing one parameter set.
pub(all) struct OneEuro2 {
  fx : OneEuro
  fy : OneEuro
}

///|
pub fn OneEuro2::new(
  min_cutoff : Double,
  beta : Double,
  d_cutoff : Double,
) -> OneEuro2 {
  {
    fx: OneEuro::new(min_cutoff, beta, d_cutoff),
    fy: OneEuro::new(min_cutoff, beta, d_cutoff),
  }
}

///|
/// Returns the filtered `(x, y)`.
pub fn OneEuro2::step(
  self : OneEuro2,
  x : Double,
  y : Double,
  dt : Double,
) -> (Double, Double) {
  (self.fx.step(x, dt), self.fy.step(y, dt))
}

///|
/// Critically damped spring, integrated in closed form.
///
/// For ζ = 1 the exact solution of `x'' + 2ωx' + ω²x = 0` (relative to the
/// target) is
///
/// ```text
/// x(t) = (x₀ + (v₀ + ωx₀)t) e^{−ωt}
/// v(t) = (v₀ − ω(v₀ + ωx₀)t) e^{−ωt}
/// ```
///
/// Stepping that formula means any `dt` (a 500 ms stalled frame included) is
/// exact, and the motion can never overshoot.
pub(all) struct Spring {
  stiffness : Double
  mut pos : Double
  mut vel : Double
  mut target : Double
}

///|
/// `half_life` in seconds: the time for the remaining offset to halve, from
/// rest. With `x(t) = (1 + ωt)e^{−ωt}` that means solving
/// `(1 + s)e^{−s} = 1/2`, i.e. `s = 1.6783469900166605` (the Lambert-W value,
/// not the `2·ln2` approximation some hand-rolled springs use — that one is
/// 21% off and nobody notices because "it still looks springy").
pub fn Spring::new(half_life : Double, start : Double) -> Spring {
  {
    stiffness: 1.6783469900166605 / half_life,
    pos: start,
    vel: 0.0,
    target: start,
  }
}

///|
/// Set the goal; the spring keeps its velocity so a moving target does not
/// cause a jerk.
pub fn Spring::set_target(self : Spring, t : Double) -> Unit {
  self.target = t
}

///|
/// Advance by `dt` seconds, exactly.
pub fn Spring::step(self : Spring, dt : Double) -> Double {
  let w = self.stiffness
  let x = self.pos - self.target
  let v = self.vel
  let e = @cmath.exp(-w * dt)
  let c = v + w * x
  let x_new = (x + c * dt) * e
  let v_new = (v - w * c * dt) * e
  self.pos = self.target + x_new
  self.vel = v_new
  self.pos
}

///|
/// Snap when the remaining offset is negligible (avoids a long tail of
/// denormal-sized movements).
pub fn Spring::settled(self : Spring, eps : Double) -> Bool {
  (self.pos - self.target).abs() < eps && self.vel.abs() < eps
}

///|
/// Constant-velocity Kalman filter, 2 states (position, velocity), 1
/// measurement. Matrices are fixed at construction, so a step is a handful of
/// multiplies.
///
/// State: `[x, v]ᵀ`, `F = [[1, dt], [0, 1]]`, `H = [1, 0]`.
pub(all) struct Kalman1D {
  q_pos : Double
  q_vel : Double
  r : Double
  mut x : Double
  mut v : Double
  mut p00 : Double
  mut p01 : Double
  mut p11 : Double
  mut started : Bool
}

///|
/// `q_pos`/`q_vel` are process noise spectral densities, `r` the measurement
/// variance. Set `q_vel` small for a slow-moving input device, larger for a
/// jittery one.
pub fn Kalman1D::new(q_pos : Double, q_vel : Double, r : Double) -> Kalman1D {
  {
    q_pos,
    q_vel,
    r,
    x: 0.0,
    v: 0.0,
    p00: 1.0,
    p01: 0.0,
    p11: 1.0,
    started: false,
  }
}

///|
/// One predict/update cycle; returns the filtered position.
pub fn Kalman1D::step(self : Kalman1D, z : Double, dt : Double) -> Double {
  if !self.started {
    self.started = true
    self.x = z
    self.v = 0.0
    return z
  }
  // predictor, part 1: the *state* must be propagated by the motion model.
  // (Forgetting this is the classic silent Kalman bug: the covariance
  // prediction below is present, the filter looks like it works, and the
  // result is a permanent lag that no amount of tuning removes. It was caught
  // here by the ramp test, which demands zero steady-state lag.)
  let x_pred = self.x + dt * self.v
  // predictor, part 2: covariance gains the process noise of a
  // constant-velocity model
  let p00 = self.p00 + dt * (2.0 * self.p01 + dt * self.p11) + self.q_pos * dt
  let p01 = self.p01 + dt * self.p11
  let p11 = self.p11 + self.q_vel * dt
  // innovation
  let s = p00 + self.r
  let k0 = p00 / s
  let k1 = p01 / s
  let y = z - x_pred
  self.x = x_pred + k0 * y
  self.v = self.v + k1 * y
  // covariance update (Joseph-free form is fine here: P is 2x2 and symmetric)
  let n00 = (1.0 - k0) * p00
  let n01 = (1.0 - k0) * p01
  let n11 = p11 - k1 * p01
  self.p00 = n00
  self.p01 = n01
  self.p11 = n11
  self.x
}

///|
/// Schmitt trigger: a binary decision with two thresholds, so a value that
/// hovers on one threshold cannot produce a stream of flips.
pub(all) struct Hysteresis {
  lo : Double
  hi : Double
  mut on : Bool
}

///|
pub fn Hysteresis::new(lo : Double, hi : Double) -> Hysteresis {
  { lo, hi, on: false, }
}

///|
/// Turns on when the value rises above `hi`, and stays on until it falls
/// below `lo`. Between the two thresholds the previous decision is kept.
pub fn Hysteresis::update(self : Hysteresis, x : Double) -> Bool {
  if self.on {
    if x < self.lo {
      self.on = false
    }
  } else if x > self.hi {
    self.on = true
  }
  self.on
}
