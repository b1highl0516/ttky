///| Scene-graph tests. Three of them carry the real weight:
///
///  * **incremental == full**: after every batch of random mutations, every
///    node's world matrix, world bounds and subtree bounds are compared against
///    a from-scratch recompute of the whole tree. This is the test that catches
///    a wrong validity stamp — the failure mode of every incremental scheme.
///  * **damage covers what changed**: the tiles of the old and new world bounds
///    of every node that changed must all be dirty. Missing damage is a visual
///    artefact; this test forbids it.
///  * **no false damage**: an unchanged transform (or an identical write) must
///    produce an empty region and no work, otherwise every frame repaints.

///|
/// Build a scene whose viewport is 256×192 at tile size 16.
fn make_scene() -> @scene.Scene {
  @scene.Scene::new(@spatial.Aabb::new(0.0, 0.0, 256.0, 192.0), 16)
}

///|
/// Recompute the whole tree from scratch, ignoring every cache. Deliberately
/// the same arithmetic as the incremental path (same composition order, same
/// local-frame subtree box) so that the comparison is exact and any
/// disagreement is a propagation bug rather than a rounding difference.
fn naive_fill(
  s : @scene.Scene,
  id : Int,
  parent : @math.Mat2x3,
  worlds : Array[@math.Mat2x3],
  bounds : Array[@spatial.Aabb],
  subs : Array[@spatial.Aabb],
) -> @spatial.Aabb {
  let lm = s.trs_of(id).matrix()
  let w = if id == 0 { lm } else { parent.compose(lm) }
  let b = @scene.transform_bounds(s.local_bounds_of(id), w)
  worlds.push(w)
  bounds.push(b)
  subs.push(b)
  let my_slot = subs.length() - 1
  // the subtree box is assembled in this node's own frame, so each child's box
  // has to be placed by that child's local matrix first
  let mut sub_local = s.local_bounds_of(id)
  for k in s.children_of(id) {
    let child_sub = naive_fill(s, k, w, worlds, bounds, subs)
    sub_local = sub_local.union(
      @scene.transform_bounds(child_sub, s.trs_of(k).matrix()),
    )
  }
  // entries are appended in pre-order; this node's was appended before its
  // children's, so patch it in place
  subs[my_slot] = sub_local
  sub_local
}

///|
/// Compare the whole scene against a from-scratch recompute. Returns a list of
/// problems (empty means the incremental caches agree with full recomputation).
fn check_against_full(s : @scene.Scene, tag : String) -> Array[String] {
  let problems : Array[String] = []
  let ids : Array[Int] = []
  collect_ids(s, 0, ids)
  let worlds : Array[@math.Mat2x3] = []
  let bounds : Array[@spatial.Aabb] = []
  let subs : Array[@spatial.Aabb] = []
  ignore(naive_fill(s, 0, @math.Mat2x3::identity(), worlds, bounds, subs))
  // naive_fill walks in the same order as collect_ids (pre-order)
  for i = 0; i < ids.length(); i = i + 1 {
    let id = ids[i]
    if !@math.Mat2x3::equal(worlds[i], s.world_of(id)) {
      problems.push("\{tag}: world wrong at node \{id}")
    }
    let wb = s.bounds_of(id)
    let nb = bounds[i]
    if (wb.min_x - nb.min_x).abs() > 1.0e-12 ||
      (wb.min_y - nb.min_y).abs() > 1.0e-12 ||
      (wb.max_x - nb.max_x).abs() > 1.0e-12 ||
      (wb.max_y - nb.max_y).abs() > 1.0e-12 {
      problems.push("\{tag}: bounds wrong at node \{id}")
    }
    let ws = s.subtree_bounds_of(id)
    let ns = @scene.transform_bounds(subs[i], worlds[i])
    if (ws.min_x - ns.min_x).abs() > 1.0e-12 ||
      (ws.min_y - ns.min_y).abs() > 1.0e-12 ||
      (ws.max_x - ns.max_x).abs() > 1.0e-12 ||
      (ws.max_y - ns.max_y).abs() > 1.0e-12 {
      problems.push("\{tag}: subtree bounds wrong at node \{id}")
    }
  }
  problems
}

///|
fn collect_ids(s : @scene.Scene, id : Int, out : Array[Int]) -> Unit {
  out.push(id)
  for k in s.children_of(id) {
    collect_ids(s, k, out)
  }
}

///|
/// Tiles a world box touches, under the same half-open rule the damage
/// rasteriser uses (written here as a shrink-by-epsilon, i.e. independently).
fn tiles_of_box(
  b : @spatial.Aabb,
  tile : Double,
  cols : Int,
  rows : Int,
) -> Array[(Int, Int)] {
  let out : Array[(Int, Int)] = []
  if b.is_empty() {
    return out
  }
  let eps = 1.0e-9
  let x0 = (b.min_x / tile).floor().to_int()
  let x1 = ((b.max_x - eps) / tile).floor().to_int()
  let y0 = (b.min_y / tile).floor().to_int()
  let y1 = ((b.max_y - eps) / tile).floor().to_int()
  for ty = y0; ty <= y1; ty = ty + 1 {
    for tx = x0; tx <= x1; tx = tx + 1 {
      if tx >= 0 && ty >= 0 && tx < cols && ty < rows {
        out.push((tx, ty))
      }
    }
  }
  out
}

///|
fn missing_tiles(
  d : @scene.DirtyRegion,
  boxes : Array[@spatial.Aabb],
) -> Array[(Int, Int)] {
  let bad : Array[(Int, Int)] = []
  for b in boxes {
    for t in tiles_of_box(b, 16.0, d.cols(), d.rows()) {
      if !d.is_tile_set(t.0, t.1) {
        bad.push(t)
      }
    }
  }
  bad
}

///|
test "scene: TRS composes as T · R · S, like CSS transform" {
  let s = make_scene()
  // rotate 90° then translate: a unit-x vector must end up pointing +y
  let n = s.add_node(
    0,
    @scene.Trs::new(10.0, 0.0, @math.PI / 2.0, 1.0, 1.0),
    @spatial.Aabb::new(0.0, 0.0, 1.0, 1.0),
  )
  let n2 = s.add_node(
    0,
    @scene.Trs::new(10.0, 0.0, @math.PI / 2.0, 2.0, 1.0),
    @spatial.Aabb::new(0.0, 0.0, 1.0, 1.0),
  )
  ignore(s.flush())
  let p = s.world_of(n).apply(@math.Vec2::new(1.0, 0.0))
  assert_true((p.x - 10.0).abs() < 1.0e-12, msg="x = \{p.x}")
  assert_true((p.y - 1.0).abs() < 1.0e-12, msg="y = \{p.y}")
  // scale is applied first: (100,1) -> 2*(1,0) rotated -> (10,2)
  let q = s.world_of(n2).apply(@math.Vec2::new(1.0, 0.0))
  assert_true((q.x - 10.0).abs() < 1.0e-12, msg="scaled x = \{q.x}")
  assert_true((q.y - 2.0).abs() < 1.0e-12, msg="scaled y = \{q.y}")
  // the local bound of a child is placed by the parent's matrix
  let child = s.add_node(
    n,
    @scene.Trs::at(0.0, 5.0),
    @spatial.Aabb::new(0.0, 0.0, 1.0, 1.0),
  )
  ignore(s.flush())
  // the child sits 5 units up its parent's local +y, which the parent's 90°
  // rotation maps to world -x: (0,5) -> (-5,0) -> +10 in x
  let c = s.world_of(child).apply(@math.Vec2::zero())
  assert_true((c.x - 5.0).abs() < 1.0e-12, msg="child x = \{c.x}")
  assert_true(c.y.abs() < 1.0e-12, msg="child y = \{c.y}")
  assert_true(s.depth_of(child) == 2, msg="depth")
}

///|
test "scene: incremental updates equal a full recompute (random fuzz)" {
  let s = make_scene()
  let rng = @num.Pcg32::new()
  // a shallow, wide-ish tree with random geometry
  let mut ids : Array[Int] = [0]
  for i = 0; i < 120; i = i + 1 {
    let parent = ids[rng.next_below(ids.length())]
    let t = @scene.Trs::new(
      rng.range(-40.0, 40.0),
      rng.range(-40.0, 40.0),
      rng.range(-1.0, 1.0),
      rng.range(0.3, 2.0),
      rng.range(0.3, 2.0),
    )
    let x = rng.range(0.0, 60.0)
    let y = rng.range(0.0, 60.0)
    let w = rng.range(4.0, 40.0)
    let h = rng.range(4.0, 40.0)
    let id = s.add_node(parent, t, @spatial.Aabb::new(x, y, x + w, y + h))
    if rng.next_double() < 0.15 {
      ignore(s.set_visible(id, false))
    }
    ids.push(id)
  }
  ignore(s.flush())
  let initial = check_against_full(s, "build")
  if initial.length() > 0 {
    fail(initial.join("\n"))
  }
  // now mutate, and check after every flush
  for round = 0; round < 40; round = round + 1 {
    // snapshot the world bounds of every node before the mutations
    let before_ids : Array[Int] = []
    collect_ids(s, 0, before_ids)
    let before : Array[@spatial.Aabb] = []
    let before_vis : Array[Bool] = []
    for id in before_ids {
      before.push(s.bounds_of(id))
      before_vis.push(s.is_visible(id))
    }
    s.begin_frame()
    let op = rng.next_below(6)
    let victim = ids[rng.next_below(ids.length())]
    if op == 0 {
      let t = s.trs_of(victim)
      ignore(
        s.set_trs(
          victim,
          @scene.Trs::new(
            t.x + rng.range(-60.0, 60.0),
            t.y + rng.range(-60.0, 60.0),
            t.rot,
            t.sx,
            t.sy,
          ),
        ),
      )
    } else if op == 1 {
      ignore(
        s.set_trs(
          victim,
          @scene.Trs::new(
            rng.range(-200.0, 200.0),
            rng.range(-200.0, 200.0),
            t_rot(s),
            1.0,
            1.0,
          ),
        ),
      )
    } else if op == 2 {
      let x = rng.range(0.0, 60.0)
      let y = rng.range(0.0, 60.0)
      ignore(
        s.set_local_bounds(
          victim,
          @spatial.Aabb::new(
            x,
            y,
            x + rng.range(2.0, 30.0),
            y + rng.range(2.0, 30.0),
          ),
        ),
      )
    } else if op == 3 {
      ignore(s.set_visible(victim, !s.is_visible(victim)))
    } else if op == 4 {
      // add a node
      let x = rng.range(0.0, 60.0)
      let y = rng.range(0.0, 60.0)
      let id = s.add_node(
        victim,
        @scene.Trs::at(rng.range(-50.0, 50.0), rng.range(-50.0, 50.0)),
        @spatial.Aabb::new(x, y, x + 20.0, y + 20.0),
      )
      if id != @scene.NO_NODE {
        ids.push(id)
      }
      // remove a non-root node
    } else if victim != 0 {
      ignore(s.remove_node(victim))
    }
    ignore(s.flush())
    let problems = check_against_full(s, "round \{round}")
    if problems.length() > 0 {
      fail(problems.join("\n"))
    }
    // Damage must cover every node whose visible world box changed: its old
    // area and its new one. (Nodes that did not move need no damage — the whole
    // point of tracking.)
    let after_ids : Array[Int] = []
    collect_ids(s, 0, after_ids)
    let need : Array[@spatial.Aabb] = []
    for id in after_ids {
      if !s.is_visible(id) {
        continue
      }
      let after = s.bounds_of(id)
      let mut seen_before = false
      let mut old = @spatial.Aabb::empty()
      for i = 0; i < before_ids.length(); i = i + 1 {
        if before_ids[i] == id {
          seen_before = true
          old = before[i]
        }
      }
      if !seen_before || !@spatial.Aabb::equal(old, after) {
        need.push(after)
        if seen_before {
          need.push(old)
        }
      }
    }
    // a node that was removed or hidden still needs its old area repainted
    for i = 0; i < before_ids.length(); i = i + 1 {
      let id = before_ids[i]
      if before_vis[i] && (!s.alive(id) || !s.is_visible(id)) {
        need.push(before[i])
      }
    }
    let missing = missing_tiles(s.dirty(), need)
    if missing.length() > 0 {
      fail(
        "round \{round}: \{missing.length()} tile(s) not damaged, first tile = (\{missing[0].0}, \{missing[0].1})",
      )
    }
    // ids from this round stay valid for the next one: drop the dead ones
    let alive : Array[Int] = []
    for id in ids {
      if s.alive(id) {
        alive.push(id)
      }
    }
    ids = alive
  }
}

///|
/// a rotation that the mutation can use without reading state
fn t_rot(s : @scene.Scene) -> Double {
  let _ = s
  0.5
}

///|
test "scene: identical writes cost nothing and damage nothing" {
  let s = make_scene()
  let n = s.add_node(
    0,
    @scene.Trs::at(10.0, 10.0),
    @spatial.Aabb::new(0.0, 0.0, 20.0, 20.0),
  )
  ignore(s.flush())
  s.begin_frame()
  assert_true(
    s.set_trs(n, @scene.Trs::at(10.0, 10.0)) == false,
    msg="same transform is a no-op",
  )
  assert_true(s.move_by(n, 0.0, 0.0) == false, msg="zero delta is a no-op")
  assert_true(
    s.set_local_bounds(n, @spatial.Aabb::new(0.0, 0.0, 20.0, 20.0)) == false,
    msg="same bounds",
  )
  assert_true(s.pending() == false, msg="nothing should be queued")
  ignore(s.flush())
  assert_true(s.dirty().is_empty(), msg="no-op writes must not damage")
  let st = s.stats()
  assert_eq(st.marks, 0)
  assert_eq(st.matmuls, 0)
}

///|
test "scene: damage is the union of where it was and where it is" {
  let s = make_scene()
  let n = s.add_node(
    0,
    @scene.Trs::at(0.0, 0.0),
    @spatial.Aabb::new(0.0, 0.0, 20.0, 20.0),
  )
  ignore(s.flush())
  s.begin_frame()
  ignore(s.move_by(n, 200.0, 150.0))
  let st = s.flush()
  assert_true(st.pre_rects >= 1, msg="the old position must be damaged")
  assert_true(st.post_rects >= 1, msg="the new position must be damaged")
  let d = s.dirty()
  let missing = missing_tiles(d, [
    @spatial.Aabb::new(0.0, 0.0, 20.0, 20.0),
    @spatial.Aabb::new(200.0, 150.0, 220.0, 170.0),
  ])
  assert_true(missing.length() == 0, msg="both endpoints must be dirty")
  // and the damage is bounded: it must not cover the whole viewport
  assert_true(
    d.tiles() < d.cols() * d.rows(),
    msg="a 20px move must not dirty everything",
  )
}

///|
test "scene: subtree bounds make a group move with one rectangle" {
  let s = make_scene()
  let group = s.add_node(0, @scene.Trs::at(20.0, 20.0), @spatial.Aabb::empty())
  let a = s.add_node(
    group,
    @scene.Trs::at(0.0, 0.0),
    @spatial.Aabb::new(0.0, 0.0, 10.0, 10.0),
  )
  let b = s.add_node(
    group,
    @scene.Trs::at(30.0, 40.0),
    @spatial.Aabb::new(0.0, 0.0, 10.0, 10.0),
  )
  ignore(s.flush())
  let gb = s.subtree_bounds_of(group)
  assert_true((gb.min_x - 20.0).abs() < 1.0e-12, msg="group sub min_x")
  assert_true((gb.max_x - 60.0).abs() < 1.0e-12, msg="group sub max_x")
  assert_true((gb.max_y - 70.0).abs() < 1.0e-12, msg="group sub max_y")
  s.begin_frame()
  ignore(s.move_by(group, 100.0, 0.0))
  let st = s.flush()
  // one pre + one post rectangle for the whole group, not two per child
  assert_eq(st.pre_rects, 1)
  assert_eq(st.post_rects, 1)
  let d = s.dirty()
  let missing = missing_tiles(d, [
    @spatial.Aabb::new(20.0, 20.0, 60.0, 70.0),
    @spatial.Aabb::new(120.0, 20.0, 160.0, 70.0),
  ])
  assert_true(
    missing.length() == 0,
    msg="old and new group areas must be dirty",
  )
  // the children's caches are still exact
  assert_eq(check_against_full(s, "group move").length(), 0)
  let _ = a
  let _ = b
}

///|
test "scene: hidden subtrees paint nothing, and changes inside them damage nothing" {
  let s = make_scene()
  let n = s.add_node(
    0,
    @scene.Trs::at(10.0, 10.0),
    @spatial.Aabb::new(0.0, 0.0, 30.0, 30.0),
  )
  let kid = s.add_node(
    n,
    @scene.Trs::at(0.0, 0.0),
    @spatial.Aabb::new(0.0, 0.0, 10.0, 10.0),
  )
  ignore(s.flush())
  assert_true(
    s.subtree_bounds_of(n).is_empty() == false,
    msg="visible: non-empty",
  )
  s.begin_frame()
  ignore(s.set_visible(n, false))
  ignore(s.flush())
  // the subtree box stays geometric (it is a fact about geometry, not paint),
  // but the damage is where it was and nothing more
  assert_true(
    s.subtree_bounds_of(n).is_empty() == false,
    msg="geometry is unchanged by hiding",
  )
  assert_true(s.damage_of(n).is_empty(), msg="a hidden node damages nothing")
  let missing = missing_tiles(s.dirty(), [
    @spatial.Aabb::new(10.0, 10.0, 40.0, 40.0),
  ])
  assert_true(missing.length() == 0, msg="hiding must damage where it was")
  // moving a child *inside* the hidden group is invisible: no damage at all
  s.begin_frame()
  ignore(s.move_by(kid, 100.0, 100.0))
  ignore(s.flush())
  assert_true(
    s.dirty().is_empty(),
    msg="changes under a hidden node must not damage",
  )
  assert_eq(check_against_full(s, "hidden move").length(), 0)
  // showing it again damages the area it will occupy
  s.begin_frame()
  ignore(s.set_visible(n, true))
  ignore(s.flush())
  let need = [
    @spatial.Aabb::new(10.0, 10.0, 40.0, 40.0),
    @scene.transform_bounds(s.subtree_local_of(n), s.world_of(n)),
  ]
  assert_true(
    missing_tiles(s.dirty(), need).length() == 0,
    msg="showing must damage the new area",
  )
}

///|
test "scene: clip chains bound the damage" {
  let s = make_scene()
  let win = s.add_node(0, @scene.Trs::at(0.0, 0.0), @spatial.Aabb::empty())
  ignore(s.set_clip(win, @spatial.Aabb::new(0.0, 0.0, 64.0, 64.0)))
  let item = s.add_node(
    win,
    @scene.Trs::at(0.0, 0.0),
    @spatial.Aabb::new(0.0, 0.0, 32.0, 32.0),
  )
  ignore(s.flush())
  // moving the item far outside the window damages only the window area
  s.begin_frame()
  ignore(s.move_by(item, 300.0, 300.0))
  ignore(s.flush())
  let b = s.dirty().bounds()
  assert_true(b.max_x <= 64.0, msg="damage escaped the clip in x: \{b.max_x}")
  assert_true(b.max_y <= 64.0, msg="damage escaped the clip in y: \{b.max_y}")
  let missing = missing_tiles(s.dirty(), [
    @spatial.Aabb::new(0.0, 0.0, 32.0, 32.0),
  ])
  assert_true(
    missing.length() == 0,
    msg="the part that was visible must be damaged",
  )
  // scrolling inside the clip damages inside the clip only, and the item's own
  // clipped-out part never enters the region
  s.begin_frame()
  ignore(s.move_by(item, 16.0, 0.0))
  ignore(s.flush())
  let b2 = s.dirty().bounds()
  assert_true(
    b2.max_x <= 64.0 && b2.min_x >= 0.0,
    msg="scrolling stayed inside the clip",
  )
}

///|
test "scene: removal frees the subtree, and generations catch reuse" {
  let s = make_scene()
  let parent = s.add_node(0, @scene.Trs::at(0.0, 0.0), @spatial.Aabb::empty())
  let a = s.add_node(
    parent,
    @scene.Trs::at(0.0, 0.0),
    @spatial.Aabb::new(0.0, 0.0, 20.0, 20.0),
  )
  let b = s.add_node(
    a,
    @scene.Trs::at(0.0, 0.0),
    @spatial.Aabb::new(0.0, 0.0, 10.0, 10.0),
  )
  ignore(s.flush())
  assert_eq(s.node_count(), 4)
  let gen_a = s.gen(a)
  let gen_b = s.gen(b)
  s.begin_frame()
  assert_true(s.remove_node(a), msg="remove must succeed")
  assert_true(s.alive(a) == false, msg="removed node is not alive")
  assert_true(s.alive(b) == false, msg="the whole subtree is gone")
  assert_eq(s.node_count(), 2)
  ignore(s.flush())
  let missing = missing_tiles(s.dirty(), [
    @spatial.Aabb::new(0.0, 0.0, 20.0, 20.0),
  ])
  assert_true(
    missing.length() == 0,
    msg="removal must damage where the subtree was",
  )
  assert_true(
    s.subtree_bounds_of(parent).is_empty(),
    msg="parent shrank back to nothing",
  )
  // freed slots are reused last-in-first-out; the generation is what tells a
  // caller that the id it kept no longer means the node it meant
  let c = s.add_node(
    parent,
    @scene.Trs::at(0.0, 0.0),
    @spatial.Aabb::new(0.0, 0.0, 5.0, 5.0),
  )
  assert_eq(c, b)
  assert_true(s.alive(b), msg="the slot is live again — as a different node")
  assert_true(
    s.gen(b) != gen_b,
    msg="a stale id must be detectable through the generation",
  )
  assert_true(
    s.gen(a) != gen_a || !s.alive(a),
    msg="the other freed slot is still free or renewed",
  )
  let _ = gen_a
  // removing the root or a dead node is refused, not silently accepted
  assert_true(s.remove_node(0) == false, msg="the root cannot be removed")
  // `a` is still free (the free list is LIFO), so removing it again is refused
  assert_true(
    s.remove_node(a) == false,
    msg="a freed id cannot be removed again",
  )
  // a stale id whose slot was reused is *not* refused — which is exactly why
  // callers get the generation to compare
  assert_true(s.alive(b), msg="the reused slot is alive again under a new node")
}

///|
test "scene: reparent keeps depths, refuses cycles, damages both ends" {
  let s = make_scene()
  let p1 = s.add_node(0, @scene.Trs::at(10.0, 10.0), @spatial.Aabb::empty())
  let p2 = s.add_node(0, @scene.Trs::at(120.0, 100.0), @spatial.Aabb::empty())
  let mid = s.add_node(p1, @scene.Trs::at(0.0, 0.0), @spatial.Aabb::empty())
  let leaf = s.add_node(
    mid,
    @scene.Trs::at(0.0, 0.0),
    @spatial.Aabb::new(0.0, 0.0, 20.0, 20.0),
  )
  ignore(s.flush())
  let before = s.bounds_of(leaf)
  s.begin_frame()
  assert_true(s.reparent(mid, p2), msg="reparent must succeed")
  assert_eq(s.depth_of(mid), s.depth_of(p2) + 1)
  assert_eq(s.depth_of(leaf), s.depth_of(mid) + 1)
  assert_true(s.parent_of(mid) == p2, msg="new parent")
  ignore(s.flush())
  let after = s.bounds_of(leaf)
  let missing = missing_tiles(s.dirty(), [before, after])
  assert_true(
    missing.length() == 0,
    msg="both old and new places must be damaged",
  )
  assert_eq(check_against_full(s, "reparent").length(), 0)
  // a cycle is refused
  assert_true(s.reparent(p2, leaf) == false, msg="a cycle must be refused")
  assert_true(s.reparent(0, p1) == false, msg="the root cannot be reparented")
  assert_true(
    s.reparent(mid, 9999) == false,
    msg="a dead target must be refused",
  )
  assert_eq(
    s.parent_of(p2),
    0,
    msg="the refused reparent must not have moved anything",
  )
}

///|
test "scene: hit testing is topmost-first and clip aware" {
  let s = make_scene()
  // two overlapping siblings: the later one paints on top
  let under = s.add_node(
    0,
    @scene.Trs::at(0.0, 0.0),
    @spatial.Aabb::new(0.0, 0.0, 50.0, 50.0),
  )
  let over = s.add_node(
    0,
    @scene.Trs::at(10.0, 10.0),
    @spatial.Aabb::new(0.0, 0.0, 50.0, 50.0),
  )
  // a child that overflows its parent's bounds must still be hittable
  let tiny = s.add_node(
    over,
    @scene.Trs::at(30.0, 30.0),
    @spatial.Aabb::new(0.0, 0.0, 40.0, 40.0),
  )
  // a clipped window with an item inside
  let win = s.add_node(0, @scene.Trs::at(150.0, 100.0), @spatial.Aabb::empty())
  ignore(s.set_clip(win, @spatial.Aabb::new(0.0, 0.0, 40.0, 40.0)))
  let item = s.add_node(
    win,
    @scene.Trs::at(0.0, 0.0),
    @spatial.Aabb::new(0.0, 0.0, 200.0, 200.0),
  )
  ignore(s.flush())
  // the child of `over` paints last, so it wins where it covers
  assert_eq(s.hit_test(45.0, 45.0), tiny)
  // over `over` but not the child: `over` wins, not `under`
  assert_eq(s.hit_test(15.0, 15.0), over)
  // and the child overflows its parent's box, which must still be hittable
  assert_eq(s.hit_test(70.0, 70.0), tiny)
  // far right of the window: the item extends to 350px but the clip stops at 190
  assert_eq(s.hit_test(160.0, 110.0), item)
  assert_true(
    s.hit_test(220.0, 110.0) != item,
    msg="a clipped-out point must not hit the item",
  )
  // nothing there
  assert_eq(s.hit_test(250.0, 20.0), @scene.NO_NODE)
  // hidden nodes are not hit
  ignore(s.set_visible(over, false))
  ignore(s.flush())
  assert_true(
    s.hit_test(45.0, 45.0) != tiny,
    msg="a hidden subtree must not be hittable",
  )
  assert_true(s.hit_test(45.0, 45.0) != over, msg="nor the hidden node itself")
  let _ = under
}

///|
test "scene: a 4000-deep chain works (no recursion anywhere)" {
  let s = make_scene()
  let mut cur = s.add_node(0, @scene.Trs::at(0.0, 0.0), @spatial.Aabb::empty())
  for i = 0; i < 4000; i = i + 1 {
    cur = s.add_node(cur, @scene.Trs::at(0.01, 0.0), @spatial.Aabb::empty())
  }
  // the bottom of the chain is the only node with real geometry
  ignore(s.set_local_bounds(cur, @spatial.Aabb::new(0.0, 0.0, 1.0, 1.0)))
  ignore(s.flush())
  assert_eq(s.depth_of(cur), 4001)
  // the chain walks 0.01 in x per level, and the leaf is the only node with
  // geometry; move the leaf in y and check both axes
  let b0 = s.bounds_of(cur)
  assert_true((b0.min_x - 40.0).abs() < 1.0e-6, msg="leaf x = \{b0.min_x}")
  assert_true(b0.min_y.abs() < 1.0e-9, msg="leaf y before move = \{b0.min_y}")
  assert_true(s.move_by(cur, 0.0, 1.0), msg="leaf move")
  ignore(s.flush())
  let b = s.bounds_of(cur)
  assert_true((b.min_y - 1.0).abs() < 1.0e-9, msg="leaf y = \{b.min_y}")
  assert_true(
    (b.min_x - 40.0).abs() < 1.0e-6,
    msg="leaf x after move = \{b.min_x}",
  )
  // move the root: every descendant must follow
  assert_true(s.move_by(0, 5.0, 0.0), msg="root move")
  ignore(s.flush())
  let b2 = s.bounds_of(cur)
  assert_true(
    (b2.min_x - 45.0).abs() < 1.0e-6,
    msg="descendant x after root move = \{b2.min_x}",
  )
  // and the subtree comes down without touching the call stack
  assert_true(s.remove_node(1), msg="remove a deep chain")
  ignore(s.flush())
  assert_true(s.alive(cur) == false, msg="the chain is gone")
}

///|
/// Regression: the world matrix is cached with "the parent's version when I
/// computed it" as its stamp, and two different parents can carry the *same*
/// version (a fresh scene has every version at 0). Reparenting between them
/// therefore used to pass the stamp check and leave the moved subtree with its
/// old world matrices — the 4001-node fuzz would only have caught it
/// probabilistically, so it gets its own test.
test "scene: reparenting between equal-version parents still refreshes the subtree" {
  let s = make_scene()
  let a = s.add_node(0, @scene.Trs::at(0.0, 0.0), @spatial.Aabb::empty())
  let b = s.add_node(0, @scene.Trs::at(100.0, 0.0), @spatial.Aabb::empty())
  let moved = s.add_node(
    a,
    @scene.Trs::at(5.0, 5.0),
    @spatial.Aabb::new(0.0, 0.0, 10.0, 10.0),
  )
  let deep = s.add_node(
    moved,
    @scene.Trs::at(1.0, 1.0),
    @spatial.Aabb::new(0.0, 0.0, 2.0, 2.0),
  )
  ignore(s.flush())
  let before = s.bounds_of(deep)
  assert_true(
    (before.min_x - 6.0).abs() < 1.0e-12,
    msg="deep x before = \{before.min_x}",
  )
  assert_true(s.reparent(moved, b), msg="reparent")
  ignore(s.flush())
  let after = s.bounds_of(deep)
  assert_true(
    (after.min_x - 106.0).abs() < 1.0e-12,
    msg="deep x after = \{after.min_x}",
  )
  assert_eq(check_against_full(s, "equal-version reparent").length(), 0)
}

///|
test "scene: visibility is inherited and a hidden subtree takes no damage" {
  let s = make_scene()
  let group = s.add_node(0, @scene.Trs::at(20.0, 20.0), @spatial.Aabb::empty())
  let leaf = s.add_node(group, @scene.Trs::at(4.0, 4.0), @spatial.Aabb::new(0.0, 0.0, 10.0, 10.0))
  ignore(s.flush())
  assert_true(s.is_visible(group), msg="the group starts visible")
  assert_true(s.is_visible(leaf), msg="and so does its child")
  // hiding the group hides the subtree: the child's own flag is untouched, but
  // the predicate has to agree with what the renderer draws
  assert_true(s.set_visible(group, false), msg="hide the group")
  assert_true(s.is_visible(group) == false, msg="the group is hidden")
  assert_true(
    s.is_visible(leaf) == false,
    msg="a child of a hidden group is hidden (inheritance)",
  )
  // ... and a mutation inside the hidden subtree is not damage
  s.begin_frame()
  ignore(s.move_by(leaf, 5.0, 0.0))
  ignore(s.flush())
  assert_eq(s.dirty().tiles(), 0, msg="nothing was painted there, nothing repaints")
  // damage_of says the same thing, and hit_test finds nothing in there
  assert_true(s.damage_of(leaf).is_empty(), msg="damage_of agrees")
  assert_eq(s.hit_test(29.0, 29.0), -1, msg="a hidden subtree is not hit")
  // showing the group again makes the child visible and hit-testable
  assert_true(s.set_visible(group, true), msg="show the group")
  assert_true(s.is_visible(leaf), msg="the child is visible again")
  assert_eq(s.hit_test(29.0, 29.0), leaf, msg="and now it can be hit")
  // a dead id is never visible
  ignore(s.remove_node(leaf))
  assert_true(s.is_visible(leaf) == false, msg="a removed node is not visible")
}
