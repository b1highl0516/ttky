///| The reactive core: a push-pull dataflow graph with fine-grained
/// invalidation, equality cut-off and glitch-free reads.
///
/// Why a hand-written engine instead of "recompute the frame":
///
///  * a UI frame touches a few hundred of tens of thousands of properties, and
///    the cost of finding them must not be O(all of them);
///  * "the property did not actually change" must be *free* — dragging a
///    slider whose value is already at the end of its range must not re-raster
///    anything;
///  * reading two values derived from the same source in one frame must never
///    observe an intermediate state (the classic diamond glitch).
///
/// The engine is a **declarative** graph, not a dynamic one: edges are
/// declared when the node is created, levels are derived from those edges, and
/// `seal()` freezes the topology into CSR form. That is the same trade the rest
/// of this project makes — structure known up front, so the runtime pays
/// nothing to discover it. Dynamic dependencies (a computed whose inputs change
/// shape as the UI changes) would be a layer on top, not a rewrite: the
/// invalidation protocol only needs the edge list to be correct.
///
/// Protocol (the reason the states are three and not two):
///
///  * `Dirty`  — must recompute.
///  * `Check`  — *may* need to recompute; verify by pulling dependencies. This
///    is what makes the equality cut-off cheap: a source write marks its whole
///    observer cone `Check`, and the cone stops at the first node whose value
///    turns out to be unchanged, without ever recomputing what is downstream.
///  * `Clean`  — current.
///
/// `changed_at` / `validated_at` are version stamps; a `Check` node is verified
/// by comparing its dependencies' `changed_at` against its own `validated_at`,
/// which is O(deps) with no per-edge storage.
///
/// Writes from inside an effect (the write-back path a two-way binding needs)
/// are legal: they mark observers again and are picked up by the next pass.
/// A genuine oscillation cannot hang the browser — `flush` runs at most
/// `max_passes` passes and reports `overflow` instead.

///|
/// What a node is. Sources hold values given from outside (including from the
/// UI), computed nodes derive values, effects exist for their side effects.
pub(all) enum NodeKind {
  Source
  Computed
  Effect
} derive(Eq)

///|
pub extend NodeKind with Eq::{equal, not_equal}

///|
pub impl @debug.Debug for NodeKind with fn to_repr(self) {
  match self {
    Source => @debug.Repr::literal("Source")
    Computed => @debug.Repr::literal("Computed")
    Effect => @debug.Repr::literal("Effect")
  }
}

///|
pub extend NodeKind with @debug.Debug::{to_repr}

///|
/// Invalidation state of a node.
pub(all) enum NodeState {
  Clean
  Check
  Dirty
} derive(Eq)

///|
pub extend NodeState with Eq::{equal, not_equal}

///|
pub impl @debug.Debug for NodeState with fn to_repr(self) {
  match self {
    Clean => @debug.Repr::literal("Clean")
    Check => @debug.Repr::literal("Check")
    Dirty => @debug.Repr::literal("Dirty")
  }
}

///|
pub extend NodeState with @debug.Debug::{to_repr}

///|
/// Read-only view passed to a compute/effect closure: it can see exactly the
/// values of the node's declared dependencies, already up to date. There is no
/// global "current node" in the engine, so a closure cannot accidentally pick
/// up an edge that the graph does not know about.
pub(all) struct Reader[A] {
  values : Array[A?]
  items : Array[Int]
  start : Int
  count : Int
}

///|
/// Value of the `k`-th declared dependency (declaration order).
pub fn[A] Reader::nth(self : Reader[A], k : Int) -> A {
  if k < 0 || k >= self.count {
    abort("reactive: dependency index \{k} out of range 0..\{self.count}")
  }
  let d = self.items[self.start + k]
  match self.values[d] {
    Some(v) => v
    None => abort("reactive: dependency \{d} has no value yet")
  }
}

///|
pub fn[A] Reader::count(self : Reader[A]) -> Int {
  self.count
}

///|
/// What a `flush` actually did. `overflow` means the write-back loop hit the
/// pass cap: the graph may not be settled, and the caller should surface it
/// (this is a diagnostic, not a crash).
pub(all) struct FlushReport {
  mut passes : Int
  mut effects_run : Int
  mut computes : Int
  mut overflow : Bool
}

///|
pub fn FlushReport::to_display(self : FlushReport) -> String {
  "passes=\{self.passes} effects=\{self.effects_run} computes=\{self.computes} overflow=\{self.overflow}"
}

///|
pub impl @debug.Debug for FlushReport with fn to_repr(self) {
  @debug.Repr::literal(self.to_display())
}

///|
pub extend FlushReport with @debug.Debug::{to_repr}

///|
/// Build-time violations, raised rather than panicking: a dependency list that
/// would create a cycle is a bug in the caller, and the caller should get a
/// message it can print instead of a dead process.
pub(all) suberror ReactiveError {
  ReactiveError(String)
} derive(@debug.Debug)

///|
pub extend ReactiveError with @debug.Debug::{to_repr}

///|
/// Outcome of writing a node. `Rejected` is a runtime condition (the target is
/// not a source — e.g. an attempt to type into a value that is derived), not a
/// programming error, so it is a value and not a raised error.
pub(all) enum WriteResult {
  Changed
  Unchanged
  Rejected
} derive(Eq)

///|
pub extend WriteResult with Eq::{equal, not_equal}

///|
pub impl @debug.Debug for WriteResult with fn to_repr(self) {
  match self {
    Changed => @debug.Repr::literal("Changed")
    Unchanged => @debug.Repr::literal("Unchanged")
    Rejected => @debug.Repr::literal("Rejected")
  }
}

///|
pub extend WriteResult with @debug.Debug::{to_repr}

///|
/// The graph. `A` is the value type and is monomorphised, so a `Graph[Double]`
/// stores plain doubles and a `Graph[Vec2]` stores unboxed vectors.
pub(all) struct Graph[A] {
  // build-time (per node)
  mut kind : Array[Int]
  mut state : Array[Int]
  mut level : Array[Int]
  mut values : Array[A?]
  mut compute : Array[((Reader[A]) -> A)?]
  mut effect : Array[((Reader[A]) -> Unit)?]
  mut changed_at : Array[Int]
  mut validated_at : Array[Int]
  mut dep_start : Array[Int]
  mut dep_items : Array[Int]
  mut obs_lists : Array[Array[Int]]
  // frozen (runtime) layout
  mut frozen : Bool
  mut obs_start : Array[Int]
  mut obs_items : Array[Int]
  mut in_pending : Array[Bool]
  mut pending : Array[Int]
  mut batch : Array[Int]
  mut worklist : Array[Int]
  mut visit : Array[Int]
  mut query_id : Int
  mut stack : Array[Int]
  mut stack_i : Array[Int]
  mut post : Array[Int]
  // counters / diagnostics
  mut n : Int
  mut version : Int
  mut compute_count : Int
  mut effect_count : Int
  mut overflow : Bool
}

///|
pub fn[A] Graph::new() -> Graph[A] {
  {
    kind: [],
    state: [],
    level: [],
    values: [],
    compute: [],
    effect: [],
    changed_at: [],
    validated_at: [],
    dep_start: [0],
    dep_items: [],
    obs_lists: [],
    frozen: false,
    obs_start: [],
    obs_items: [],
    in_pending: [],
    pending: [],
    batch: [],
    worklist: [],
    visit: [],
    query_id: 0,
    stack: [],
    stack_i: [],
    post: [],
    n: 0,
    version: 0,
    compute_count: 0,
    effect_count: 0,
    overflow: false,
  }
}

///|
/// Append a node shell; dependencies are attached separately by `wire`.
fn[A] Graph::push(
  self : Graph[A],
  k : Int,
  lvl : Int,
  v : A?,
  c : ((Reader[A]) -> A)?,
  e : ((Reader[A]) -> Unit)?,
) -> Int {
  let i = self.n
  self.kind.push(k)
  // sources are born Clean (their value is given), derived nodes are born
  // Dirty so the first read evaluates them
  self.state.push(if k == 0 { 0 } else { 2 })
  self.level.push(lvl)
  self.values.push(v)
  self.compute.push(c)
  self.effect.push(e)
  self.changed_at.push(0)
  self.validated_at.push(-1)
  self.obs_lists.push([])
  self.in_pending.push(false)
  self.visit.push(0)
  // ONE entry per node, plus the sentinel: `dep_start[i]` is the start of node
  // i's dependency range and `dep_start[n]` is the total. Pushing twice here
  // (the first version did) desynchronises every index as soon as a source is
  // declared *after* a node with dependencies — the range of a later node then
  // reaches back into an earlier node's edges, silently adding a phantom
  // dependency and making `Reader::nth` read the wrong node.
  self.dep_start.push(self.dep_items.length())
  self.n = i + 1
  i
}

///|
/// Reject the dependency lists that could create a cycle: self-edges, edges to
/// nodes that do not exist yet, and duplicates (a duplicate would make the
/// observer list disagree with the edge list).
///
/// This runs *before* the node is allocated. An earlier version validated
/// inside the edge-attachment pass and left a dead half-built node behind on
/// failure, which shifted every later index; the test that declared three
/// invalid nodes in a row caught it.
fn[A] Graph::check_deps(
  self : Graph[A],
  deps : Array[Int],
) -> Unit raise ReactiveError {
  let node = self.n
  let mut i = 0
  for d in deps {
    if d == node {
      raise ReactiveError("node \{node} cannot depend on itself")
    }
    if d < 0 || d > node {
      raise ReactiveError("dependency \{d} is not declared before node \{node}")
    }
    let mut j = 0
    for e in deps {
      if j < i && e == d {
        raise ReactiveError("duplicate dependency \{d} on node \{node}")
      }
      j = j + 1
    }
    i = i + 1
  }
}

///|
/// Attach the dependency edges of `node` and derive its level (one above the
/// highest dependency). The list must have been checked by `check_deps`.
fn[A] Graph::wire(self : Graph[A], node : Int, deps : Array[Int]) -> Unit {
  let mut lvl = 0
  for d in deps {
    self.dep_items.push(d)
    self.obs_lists[d].push(node)
    if self.level[d] + 1 > lvl {
      lvl = self.level[d] + 1
    }
  }
  self.level[node] = lvl
  self.dep_start[node + 1] = self.dep_items.length()
}

///|
/// Declare a source: a value written from outside (a UI control, a pointer
/// sample, a decoded file). Sources are always writable.
pub fn[A] Graph::source(self : Graph[A], init : A) -> Int {
  self.push(0, 0, Some(init), None, None)
}

///|
/// Declare a derived value. `f` reads its dependencies through the `Reader`,
/// in the order they were passed to `deps`.
pub fn[A] Graph::computed(
  self : Graph[A],
  deps : Array[Int],
  f : (Reader[A]) -> A,
) -> Int raise ReactiveError {
  self.check_deps(deps)
  let i = self.push(1, 0, None, Some(f), None)
  self.wire(i, deps)
  i
}

///|
/// Declare a side effect (runs after the graph settles, in level order).
pub fn[A] Graph::effect(
  self : Graph[A],
  deps : Array[Int],
  f : (Reader[A]) -> Unit,
) -> Int raise ReactiveError {
  self.check_deps(deps)
  let i = self.push(2, 0, None, None, Some(f))
  self.wire(i, deps)
  i
}

///|
/// Freeze the topology: build the observer lists into one CSR pair (so a
/// notification walks a contiguous run instead of a per-node array) and check
/// the level assignment. After this the graph is meant to be run, not edited.
pub fn[A] Graph::seal(self : Graph[A]) -> Int {
  let n = self.n
  let start = Array::make(n + 1, 0)
  for i = 0; i < n; i = i + 1 {
    start[i + 1] = start[i] + self.obs_lists[i].length()
  }
  let items = Array::make(start[n], 0)
  let cursor = start.copy()
  for i = 0; i < n; i = i + 1 {
    for o in self.obs_lists[i] {
      items[cursor[i]] = o
      cursor[i] = cursor[i] + 1
    }
  }
  self.obs_start = start
  self.obs_items = items
  self.obs_lists = []
  self.frozen = true
  // every effect gets a mount run: sealing queues them all, so the first flush
  // executes each body exactly once even if no source is ever written
  for i = 0; i < n; i = i + 1 {
    if self.kind[i] == 2 {
      self.enqueue_effect(i)
    }
  }
  self.n
}

///|
pub fn[A] Graph::nodes(self : Graph[A]) -> Int {
  self.n
}

///|
pub fn[A] Graph::kind_of(self : Graph[A], i : Int) -> NodeKind {
  match self.kind[i] {
    0 => Source
    1 => Computed
    _ => Effect
  }
}

///|
pub fn[A] Graph::state_of(self : Graph[A], i : Int) -> NodeState {
  match self.state[i] {
    0 => Clean
    1 => Check
    _ => Dirty
  }
}

///|
pub fn[A] Graph::level_of(self : Graph[A], i : Int) -> Int {
  self.level[i]
}

///|
pub fn[A] Graph::changed_at(self : Graph[A], i : Int) -> Int {
  self.changed_at[i]
}

///|
pub fn[A] Graph::deps_of(self : Graph[A], i : Int) -> Array[Int] {
  self.dep_items[self.dep_start[i]:self.dep_start[i + 1]].to_owned()
}

///|
pub fn[A] Graph::observers_of(self : Graph[A], i : Int) -> Array[Int] {
  if !self.frozen {
    return self.obs_lists[i].copy()
  }
  self.obs_items[self.obs_start[i]:self.obs_start[i + 1]].to_owned()
}

///|
/// Mark every observer in the cone as `Check`, stopping at nodes that are
/// already marked (their own cone was marked when they were first hit).
///
/// Iterative on purpose: the cone can follow a chain of ten thousand nodes and
/// a recursive version would end the process with a stack overflow instead of a
/// frame.
fn[A] Graph::mark_observers(self : Graph[A], from : Int) -> Unit {
  self.worklist.clear()
  let mut k = self.obs_start[from]
  while k < self.obs_start[from + 1] {
    let o = self.obs_items[k]
    if self.state[o] == 0 {
      self.state[o] = 1
      self.worklist.push(o)
      self.enqueue_effect(o)
    }
    k = k + 1
  }
  while self.worklist.length() > 0 {
    let node = self.worklist.pop().unwrap()
    let mut k2 = self.obs_start[node]
    while k2 < self.obs_start[node + 1] {
      let o = self.obs_items[k2]
      if self.state[o] == 0 {
        self.state[o] = 1
        self.worklist.push(o)
        self.enqueue_effect(o)
      }
      k2 = k2 + 1
    }
  }
}

///|
/// Effects are queued as they are touched, so `flush` never scans the graph.
fn[A] Graph::enqueue_effect(self : Graph[A], node : Int) -> Unit {
  if self.kind[node] == 2 && !self.in_pending[node] {
    self.in_pending[node] = true
    self.pending.push(node)
  }
}

///|
/// Write a source. Returns whether the value actually changed: an equal write
/// costs one comparison and stops the wave right there (the equality cut-off).
pub fn[A : Eq] Graph::set(self : Graph[A], i : Int, v : A) -> WriteResult {
  if self.kind[i] != 0 {
    return WriteResult::Rejected
  }
  match self.values[i] {
    Some(old) => if old == v { return WriteResult::Unchanged }
    None => ()
  }
  self.values[i] = Some(v)
  self.version = self.version + 1
  self.changed_at[i] = self.version
  self.state[i] = 0
  if self.frozen {
    self.mark_observers(i)
  }
  WriteResult::Changed
}

///|
/// Read a value, bringing it (and whatever it needs) up to date first.
/// This is the pull half of push-pull: invalidation is eager, recomputation is
/// lazy, so nothing is computed that nobody asks for.
pub fn[A : Eq] Graph::get(self : Graph[A], i : Int) -> A {
  self.ensure(i)
  match self.values[i] {
    Some(v) => v
    None => abort("reactive: node \{i} has no value (effects have none)")
  }
}

///|
/// Read the last computed value without updating anything. For inspectors and
/// tests; a `None` means "never computed".
pub fn[A] Graph::peek(self : Graph[A], i : Int) -> A? {
  self.values[i]
}

///|
/// Bring one node up to date.
///
/// This is *iterative*: an explicit DFS collects the affected nodes and emits
/// them in **post-order**, which for a dependency graph is exactly the order in
/// which they can be settled (every dependency finishes before the node that
/// needs it). No sorting is involved, so the cost is O(affected).
///
/// Two earlier versions are worth remembering, because both looked fine:
///  * recursion, one frame per chain level — passed on native/js/wasm-gc and
///    blew the wasm stack on a 2000-node chain;
///  * collect-then-sort-by-level — correct, but the sort cost more than the
///    work it ordered (54 ns per verified node on a 200-node chain).
///
/// Only nodes whose state is not `Clean` are collected, so a write that is cut
/// off at the first derived node never walks past it.
fn[A : Eq] Graph::ensure(self : Graph[A], target : Int) -> Unit {
  if self.state[target] == 0 {
    return
  }
  if self.kind[target] == 0 {
    self.state[target] = 0
    return
  }
  self.query_id = self.query_id + 1
  let qid = self.query_id
  let post = self.post
  post.clear()
  let stack = self.stack
  stack.clear()
  let cursors = self.stack_i
  cursors.clear()
  self.visit[target] = qid
  stack.push(target)
  cursors.push(0)
  while stack.length() > 0 {
    let top = stack.length() - 1
    let n = stack[top]
    let i = cursors[top]
    let s0 = self.dep_start[n]
    let e0 = self.dep_start[n + 1]
    if s0 + i < e0 {
      let d = self.dep_items[s0 + i]
      cursors[top] = i + 1
      if self.visit[d] != qid {
        self.visit[d] = qid
        if self.state[d] != 0 {
          stack.push(d)
          cursors.push(0)
        }
      }
    } else {
      ignore(stack.pop())
      ignore(cursors.pop())
      post.push(n)
    }
  }
  for n in post {
    self.settle(n)
  }
}

///|
/// Settle one node whose dependencies are already settled (guaranteed by the
/// level ordering inside `ensure`).
fn[A : Eq] Graph::settle(self : Graph[A], n : Int) -> Unit {
  if self.state[n] == 0 {
    return
  }
  if self.kind[n] == 0 {
    self.state[n] = 0
    return
  }
  if self.state[n] == 2 {
    self.recompute(n)
    return
  }
  // Check: pull the version stamps of the dependencies
  let mut changed = false
  for k = self.dep_start[n]; k < self.dep_start[n + 1]; k = k + 1 {
    if self.changed_at[self.dep_items[k]] > self.validated_at[n] {
      changed = true
    }
  }
  if changed {
    self.recompute(n)
  } else {
    self.state[n] = 0
    self.validated_at[n] = self.version
  }
}

///|
/// Reevaluate a node. Dependencies must already be settled.
fn[A : Eq] Graph::recompute(self : Graph[A], n : Int) -> Unit {
  let reader : Reader[A] = {
    values: self.values,
    items: self.dep_items,
    start: self.dep_start[n],
    count: self.dep_start[n + 1] - self.dep_start[n],
  }
  if self.kind[n] == 2 {
    // effects are run exactly once per change that survives the cut-off
    self.validated_at[n] = self.version
    self.state[n] = 0
    self.effect_count = self.effect_count + 1
    match self.effect[n] {
      Some(f) => f(reader)
      None => abort("reactive: effect \{n} has no body")
    }
    return
  }
  match self.compute[n] {
    None => abort("reactive: computed \{n} has no body")
    Some(f) => {
      let next = f(reader)
      self.compute_count = self.compute_count + 1
      let mut did_change = true
      match self.values[n] {
        Some(old) => if old == next { did_change = false }
        None => ()
      }
      if did_change {
        self.values[n] = Some(next)
        self.version = self.version + 1
        self.changed_at[n] = self.version
      }
      self.validated_at[n] = self.version
      self.state[n] = 0
    }
  }
}

///|
/// Run every pending effect, in level order, until the graph settles.
///
/// Writes performed by an effect inside a pass are applied to the *graph* right
/// away (so the values are consistent) but their effects are queued for the
/// next pass; that keeps a pass's ordering deterministic. `max_passes` bounds a
/// write-back oscillation; hitting it is reported through `overflow` rather
/// than throwing, because a UI must degrade to "slightly stale" and not to a
/// frozen tab.
pub fn[A : Eq] Graph::flush(self : Graph[A], max_passes? : Int) -> FlushReport {
  let cap = match max_passes {
    Some(m) => Int::max(1, m)
    None => 64
  }
  self.compute_count = 0
  self.effect_count = 0
  self.overflow = false
  let mut passes = 0
  while self.pending.length() > 0 && passes < cap {
    // swap the queues: writes during this pass land in the next one
    let tmp = self.batch
    self.batch = self.pending
    self.pending = tmp
    self.pending.clear()
    for e in self.batch {
      self.in_pending[e] = false
    }
    self.batch.sort_by_key(fn(i) { self.level[i] })
    for e in self.batch {
      self.ensure(e)
    }
    self.batch.clear()
    passes = passes + 1
  }
  if self.pending.length() > 0 {
    self.overflow = true
  }
  {
    passes,
    effects_run: self.effect_count,
    computes: self.compute_count,
    overflow: self.overflow,
  }
}

///|
/// Structural self-check: every dependency edge points at a lower level, the
/// levels are consistent with the edges, and the observer lists agree with the
/// dependency lists. Returns a list of problems (empty = healthy). This is the
/// graph inspector's backend and the thing to call when a scene "does not
/// update" — the usual cause is a missing edge, not a bug in the engine.
pub fn[A] Graph::validate(self : Graph[A]) -> Array[String] {
  let problems : Array[String] = []
  for i = 0; i < self.n; i = i + 1 {
    let mut lvl = 0
    for k = self.dep_start[i]; k < self.dep_start[i + 1]; k = k + 1 {
      let d = self.dep_items[k]
      if self.level[d] >= self.level[i] {
        problems.push(
          "node \{i} level \{self.level[i]} is not above dependency \{d} level \{self.level[d]}",
        )
      }
      if self.level[d] + 1 > lvl {
        lvl = self.level[d] + 1
      }
      if self.kind[d] == 2 {
        problems.push("node \{i} depends on effect \{d}")
      }
    }
    if self.kind[i] != 0 && lvl != self.level[i] {
      problems.push(
        "node \{i} level \{self.level[i]} does not match its edges (expected \{lvl})",
      )
    }
  }
  if self.frozen {
    // observers must be the exact reverse of the dependency edges
    let reversed = Array::make(self.n, 0)
    for i = 0; i < self.n; i = i + 1 {
      for k = self.dep_start[i]; k < self.dep_start[i + 1]; k = k + 1 {
        reversed[self.dep_items[k]] = reversed[self.dep_items[k]] + 1
      }
    }
    for i = 0; i < self.n; i = i + 1 {
      let got = self.obs_start[i + 1] - self.obs_start[i]
      if got != reversed[i] {
        problems.push(
          "node \{i} has \{got} observers but \{reversed[i]} dependents",
        )
      }
    }
    // and every observer entry must correspond to a real edge
    for i = 0; i < self.n; i = i + 1 {
      for k = self.obs_start[i]; k < self.obs_start[i + 1]; k = k + 1 {
        let o = self.obs_items[k]
        let mut found = false
        for k2 = self.dep_start[o]; k2 < self.dep_start[o + 1]; k2 = k2 + 1 {
          if self.dep_items[k2] == i {
            found = true
          }
        }
        if !found {
          problems.push("observer \{o} of \{i} has no matching dependency edge")
        }
      }
    }
  }
  problems
}

///|
/// Graphviz dump of the graph, for the inspector view. Nodes are labelled with
/// kind/level/state, edges point from dependency to dependent.
pub fn[A] Graph::to_dot(self : Graph[A]) -> String {
  let out = StringBuilder()
  out.write_string("digraph reactive {\n")
  out.write_string("  rankdir=LR;\n")
  for i = 0; i < self.n; i = i + 1 {
    let shape = match self.kind[i] {
      0 => "box"
      1 => "ellipse"
      _ => "note"
    }
    let name = match self.kind[i] {
      0 => "s"
      1 => "c"
      _ => "e"
    }
    let st = match self.state[i] {
      0 => "clean"
      1 => "check"
      _ => "dirty"
    }
    out.write_string(
      "  n\{i} [label=\"\{name}\{i} L\{self.level[i]} \{st}\" shape=\{shape}];\n",
    )
  }
  for i = 0; i < self.n; i = i + 1 {
    for k = self.dep_start[i]; k < self.dep_start[i + 1]; k = k + 1 {
      out.write_string("  n\{self.dep_items[k]} -> n\{i};\n")
    }
  }
  out.write_string("}\n")
  out.to_string()
}
