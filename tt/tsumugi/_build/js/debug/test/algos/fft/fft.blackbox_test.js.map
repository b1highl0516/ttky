///| Spectral helpers built on the plan: real-input FFT via the N/2 packing
/// trick, magnitude/phase, window application and DC removal.

///|
/// Real-input FFT of an even length n.
///
/// Packing trick (Cooley-Tukey + Hermitian symmetry): the n real samples are
/// viewed as n/2 complex ones, one n/2-point complex transform is computed
/// instead of one n-point complex transform, and the spectrum is untangled
/// with a twiddle rotation. Cost is halved, and half the output is redundant
/// anyway (X[n-k] = conj(X[k])).
///
/// Output: `out_re`/`out_im` have n/2 + 1 valid entries (k = 0..n/2).
pub fn Fft::rfft(
  self : Fft,
  x : FixedArray[Double],
  out_re : FixedArray[Double],
  out_im : FixedArray[Double],
) -> Unit {
  let n = self.n
  if n < 2 || n % 2 != 0 {
    // Odd/tiny lengths cannot use the packing trick. The scratch buffers are
    // built once and then reused, so even this path is allocation-free after
    // the first call.
    if self.full_re.length() < n {
      self.full_re = FixedArray::make(n, 0.0)
      self.full_im = FixedArray::make(n, 0.0)
    }
    let re = self.full_re
    let im = self.full_im
    for i = 0; i < n; i = i + 1 {
      re[i] = x[i]
      im[i] = 0.0
    }
    self.forward(re, im)
    for k = 0; k <= n / 2; k = k + 1 {
      out_re[k] = re[k]
      out_im[k] = im[k]
    }
    return
  }
  let h = n / 2
  self.ensure_half()
  let zr = self.half_re
  let zi = self.half_im
  for j = 0; j < h; j = j + 1 {
    zr[j] = x[2 * j]
    zi[j] = x[2 * j + 1]
  }
  match self.half {
    None => abort("fft: half plan missing")
    Some(half) => half.forward(zr, zi)
  }
  // untangle: Z[k] -> X[k], k = 1 .. h-1 (the two ends are exact and written
  // separately below, which is also what keeps the DC and Nyquist bins free of
  // any twiddle rounding)
  for k = 1; k < h; k = k + 1 {
    let zr_k = zr[k]
    let zi_k = zi[k]
    let zr_m = zr[h - k]
    let zi_m = zi[h - k]
    let even_r = 0.5 * (zr_k + zr_m)
    let even_i = 0.5 * (zi_k - zi_m)
    let odd_r = 0.5 * (zi_k + zi_m)
    let odd_i = -0.5 * (zr_k - zr_m)
    let wr = self.ut_cos[k]
    let wi = self.ut_sin[k]
    out_re[k] = even_r + (wr * odd_r - wi * odd_i)
    out_im[k] = even_i + (wr * odd_i + wi * odd_r)
  }
  out_re[0] = zr[0] + zi[0]
  out_im[0] = 0.0
  out_re[h] = zr[0] - zi[0]
  out_im[h] = 0.0
}

///|
/// Build the half-size plan and the packing/untangle tables on first use.
fn Fft::ensure_half(self : Fft) -> Unit {
  if self.half is Some(_) {
    return
  }
  let n = self.n
  let h = n / 2
  self.half = Some(Fft::plan(h))
  self.half_re = FixedArray::make(h, 0.0)
  self.half_im = FixedArray::make(h, 0.0)
  self.ut_cos = FixedArray::make(h + 1, 0.0)
  self.ut_sin = FixedArray::make(h + 1, 0.0)
  for k = 0; k <= h; k = k + 1 {
    let ang = -2.0 * @tm.PI * k.to_double() / n.to_double()
    self.ut_cos[k] = @cmath.cos(ang)
    self.ut_sin[k] = @cmath.sin(ang)
  }
}

///|
/// Magnitude spectrum (n/2 + 1 bins).
pub fn magnitude_spectrum(
  re : FixedArray[Double],
  im : FixedArray[Double],
  bins : Int,
  out : FixedArray[Double],
) -> Unit {
  for k = 0; k < bins; k = k + 1 {
    out[k] = @tm.hypot(re[k], im[k])
  }
}

///|
/// Power (energy) spectrum.
pub fn power_spectrum(
  re : FixedArray[Double],
  im : FixedArray[Double],
  bins : Int,
  out : FixedArray[Double],
) -> Unit {
  for k = 0; k < bins; k = k + 1 {
    out[k] = re[k] * re[k] + im[k] * im[k]
  }
}

///|
/// Parseval check helper: sum of |x|^2 versus the spectral energy / n.
pub fn parseval_energy(x : FixedArray[Double], n : Int) -> Double {
  let mut acc = 0.0
  for i = 0; i < n; i = i + 1 {
    acc = acc + x[i] * x[i]
  }
  acc
}

///|
/// Remove the mean (removes the DC bin leak that otherwise dominates
/// low-frequency work such as the @smooth filters).
pub fn remove_dc(x : FixedArray[Double], n : Int) -> Double {
  if n <= 0 {
    return 0.0
  }
  let mut sum = 0.0
  for i = 0; i < n; i = i + 1 {
    sum = sum + x[i]
  }
  let mean = sum / n.to_double()
  for i = 0; i < n; i = i + 1 {
    x[i] = x[i] - mean
  }
  mean
}
