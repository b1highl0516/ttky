///| Properties and the IR: one flat word array, two-way bound.
///
/// This is the layer the design brief calls "屬性↔IR 雙向綁定", and the reason
/// it is a separate file rather than a handful of fields on `Node` is the
/// deployment shape: the wasm side computes, the js side renders, and they meet
/// in a **byte buffer in linear memory**. So a property has to exist in three
/// places at once and stay coherent:
///
/// ```
///   UI event ──▶ signal source ──▶ IrStore word ──▶ scene node ──▶ damage
///      ▲               │                 │              │
///      └───────────────┴──── encode ─────┴──────────────┘
///                    (LE bytes + CRC32 for the js side)
/// ```
///
/// * `IrStore` — struct-of-arrays: `words[node * stride + prop]` doubles, with
///   one write stamp per word. A stamp is what makes the sync cheap in both
///   directions: `pull` reads a signal only when the graph says it changed, and
///   `push` writes a signal only when the word changed since we last published
///   it. Without the second stamp a pull→push round trip would echo forever.
/// * `IrBridge` — the `(node, prop) ↔ signal` links, with a per-link conflict
///   rule for the case where both sides changed between two syncs (the same
///   "last writer, but this side wins ties" policy as `@signal.TwoWay`).
/// * `encode_into` / `decode_from` — the wire form. Explicit little-endian, an
///   explicit header, and the *same* CRC-32 (IEEE) on both sides, because a
///   shared buffer between two runtimes is exactly where an unnoticed partial
///   write turns into a rendering that is subtly wrong rather than obviously
///   broken.
///
/// Everything here is allocation-free per call except `new`/`grow` and the
/// decoder: the per-frame path is `pull`, `push`, `apply_to_scene`,
/// `publish_from_scene`, all of which touch flat arrays only.

///|
/// The property vocabulary. The order is the on-wire order and must not be
/// reordered without bumping `IR_VERSION`.
pub(all) enum PropId {
  Px // translate x
  Py // translate y
  Rot // rotation, radians
  Sx
  Sy
  Op // opacity
  ClipL
  ClipT
  ClipR
  ClipB
}

///|
/// Number of property slots per node (`stride`).
pub const PROP_COUNT : Int = 10

///|
pub fn PropId::index(self : PropId) -> Int {
  match self {
    Px => 0
    Py => 1
    Rot => 2
    Sx => 3
    Sy => 4
    Op => 5
    ClipL => 6
    ClipT => 7
    ClipR => 8
    ClipB => 9
  }
}

///|
pub fn PropId::name(self : PropId) -> String {
  match self {
    Px => "px"
    Py => "py"
    Rot => "rot"
    Sx => "sx"
    Sy => "sy"
    Op => "op"
    ClipL => "clip_l"
    ClipT => "clip_t"
    ClipR => "clip_r"
    ClipB => "clip_b"
  }
}

///|
/// `"TSMG"` as a little-endian u32.
pub const IR_MAGIC : Int = 0x474D5354

///|
pub const IR_VERSION : Int = 1

///|
/// magic(4) + version(2) + stride(2) + nodes(4) + payload_bytes(4) +
/// crc32(4) + reserved(4).
pub const IR_HEADER : Int = 24

///|
pub fn ir_encoded_size(nodes : Int) -> Int {
  IR_HEADER + nodes * PROP_COUNT * 8
}

///|
/// The flat property store. One contiguous `FixedArray[Double]` so that the
/// whole thing can be handed to the js side as a `Float64Array` view (or
/// encoded to bytes) without any per-node work.
pub(all) struct IrStore {
  mut nodes : Int
  mut stride : Int
  mut words : FixedArray[Double]
  mut stamps : FixedArray[Int]
  mut version : Int
  mut writes : Int
  mut crc : Crc32
}

///|
pub fn IrStore::new(nodes : Int) -> IrStore {
  let n = if nodes < 1 { 1 } else { nodes }
  let stride = PROP_COUNT
  let words = FixedArray::make(n * stride, 0.0)
  let stamps = FixedArray::make(n * stride, 0)
  // defaults that make a fresh node sane: unit scale, unit opacity, no clip
  for i = 0; i < n; i = i + 1 {
    words[i * stride + PropId::Sx.index()] = 1.0
    words[i * stride + PropId::Sy.index()] = 1.0
    words[i * stride + PropId::Op.index()] = 1.0
  }
  { nodes: n, stride, words, stamps, version: 0, writes: 0, crc: Crc32::new(), }
}

///|
pub fn IrStore::stride(self : IrStore) -> Int {
  self.stride
}

///|
pub fn IrStore::node_count(self : IrStore) -> Int {
  self.nodes
}

///|
pub fn IrStore::version(self : IrStore) -> Int {
  self.version
}

///|
/// Grow to `nodes` slots (keeping existing words).
pub fn IrStore::grow_to(self : IrStore, nodes : Int) -> Unit {
  if nodes <= self.nodes {
    return
  }
  let words = FixedArray::make(nodes * self.stride, 0.0)
  let stamps = FixedArray::make(nodes * self.stride, 0)
  for i = 0; i < self.nodes * self.stride; i = i + 1 {
    words[i] = self.words[i]
    stamps[i] = self.stamps[i]
  }
  self.words = words
  self.stamps = stamps
  self.nodes = nodes
  self.version = self.version + 1
}

///|
fn IrStore::index_of(self : IrStore, node : Int, prop : PropId) -> Int {
  node * self.stride + prop.index()
}

///|
/// Read a word (0.0 out of range, which keeps `apply_to_scene` total).
pub fn IrStore::get(self : IrStore, node : Int, prop : PropId) -> Double {
  let i = self.index_of(node, prop)
  if i < 0 || i >= self.words.length() {
    0.0
  } else {
    self.words[i]
  }
}

///|
/// Write a word. Returns true when the value actually changed; an identical
/// write bumps nothing, which is what stops a pull/push cycle from echoing.
pub fn IrStore::set(
  self : IrStore,
  node : Int,
  prop : PropId,
  v : Double,
) -> Bool {
  let i = self.index_of(node, prop)
  if i < 0 || i >= self.words.length() {
    return false
  }
  if self.words[i] == v {
    return false
  }
  self.words[i] = v
  self.stamps[i] = self.stamps[i] + 1
  self.version = self.version + 1
  self.writes = self.writes + 1
  true
}

///|
/// Write stamp of a word: 0 never written, higher means newer.
pub fn IrStore::stamp_of(self : IrStore, node : Int, prop : PropId) -> Int {
  let i = self.index_of(node, prop)
  if i < 0 || i >= self.words.length() {
    -1
  } else {
    self.stamps[i]
  }
}

///|
pub fn IrStore::writes(self : IrStore) -> Int {
  self.writes
}

///|
/// The transform words as a `Trs`, for the scene→IR and IR→scene paths.
pub fn IrStore::trs_of(self : IrStore, node : Int) -> Trs {
  Trs::new(
    self.get(node, Px),
    self.get(node, Py),
    self.get(node, Rot),
    self.get(node, Sx),
    self.get(node, Sy),
  )
}

///|
pub fn IrStore::set_trs(self : IrStore, node : Int, t : Trs) -> Bool {
  let a = self.set(node, Px, t.x)
  let b = self.set(node, Py, t.y)
  let c = self.set(node, Rot, t.rot)
  let d = self.set(node, Sx, t.sx)
  let e = self.set(node, Sy, t.sy)
  a || b || c || d || e
}

///|
/// "No clip" as it travels in the store: a degenerate box. An empty
/// (`±inf`) box would put infinities into a buffer that the js side reads, so
/// the marker is four zeroes, and `has_clip` is the predicate to test it with.
pub fn IrStore::no_clip() -> @spatial.Aabb {
  @spatial.Aabb::new(0.0, 0.0, 0.0, 0.0)
}

///|
pub fn IrStore::has_clip(self : IrStore, node : Int) -> Bool {
  let b = self.clip_of(node)
  b.min_x < b.max_x && b.min_y < b.max_y
}

///|
pub fn IrStore::set_clip(self : IrStore, node : Int, b : @spatial.Aabb) -> Bool {
  let a = self.set(node, ClipL, b.min_x)
  let b2 = self.set(node, ClipT, b.min_y)
  let c = self.set(node, ClipR, b.max_x)
  let d = self.set(node, ClipB, b.max_y)
  a || b2 || c || d
}

///|
pub fn IrStore::clip_of(self : IrStore, node : Int) -> @spatial.Aabb {
  @spatial.Aabb::new(
    self.get(node, ClipL),
    self.get(node, ClipT),
    self.get(node, ClipR),
    self.get(node, ClipB),
  )
}

///|
/// Copy the scene's node state into the store (scene → IR).
pub fn IrStore::publish_from_scene(
  self : IrStore,
  scene : Scene,
  id : Int,
) -> Bool {
  let changed = self.set_trs(id, scene.trs_of(id))
  let op = self.set(id, Op, scene.opacity_of(id))
  // always write the clip words, so a clip that was removed on the scene side
  // does not linger in the store
  let clip = self.set_clip(
    id,
    if scene.has_clip(id) {
      scene.clip_local_of(id)
    } else {
      IrStore::no_clip()
    },
  )
  changed || op || clip
}

///|
/// Copy the store's words into the scene (IR → scene). Every individual write
/// goes through the scene's equality cut-off, so a store that has not changed
/// damages nothing.
pub fn IrStore::apply_to_scene(self : IrStore, scene : Scene, id : Int) -> Bool {
  if !scene.alive(id) {
    return false
  }
  let mut changed = false
  if scene.set_trs(id, self.trs_of(id)) {
    changed = true
  }
  if scene.set_opacity(id, self.get(id, Op)) {
    changed = true
  }
  if self.has_clip(id) {
    if scene.set_clip(id, self.clip_of(id)) {
      changed = true
    }
  } else if scene.clear_clip(id) {
    changed = true
  }
  changed
}

// ------------------------------------------------------------------ the bridge

///|
/// One `(node, prop) ↔ signal` link.
pub(all) struct PropLink {
  node : Int
  prop : PropId
  sig : Int
  /// `graph.changed_at(sig)` last seen by `pull`.
  mut seen_sig : Int
  /// `store.stamp_of(node, prop)` last published by `pull`.
  mut seen_ir : Int
  /// True: the IR side wins a two-sided conflict. False (default): the signal
  /// side wins, matching `@signal.TwoWay`'s default.
  mut prefer_ir : Bool
}

///|
/// The link table plus its counters. Deliberately not holding a `Graph`: the
/// graph is passed in per call, the way `TwoWay::sync` does it.
pub(all) struct IrBridge {
  mut links : Array[PropLink]
  mut pulls : Int
  mut pushes : Int
  mut conflicts : Int
}

///|
pub fn IrBridge::new() -> IrBridge {
  { links: [], pulls: 0, pushes: 0, conflicts: 0, }
}

///|
pub fn IrBridge::count(self : IrBridge) -> Int {
  self.links.length()
}

///|
/// Bind `(node, prop)` to signal `sig`, seeding the signal from the word when
/// the word has a value and the signal does not (0.0 is the "unset" value, so
/// binding a fresh pair just adopts whatever is there).
pub fn IrBridge::bind(
  self : IrBridge,
  graph : @signal.Graph[Double],
  store : IrStore,
  node : Int,
  prop : PropId,
  sig : Int,
) -> Int {
  let cur = graph.peek(sig)
  let seeded = match cur {
    Some(v) =>
      if v == 0.0 {
        ignore(graph.set(sig, store.get(node, prop)))
        true
      } else {
        false
      }
    None => false
  }
  let link : PropLink = {
    node,
    prop,
    sig,
    seen_sig: graph.changed_at(sig),
    seen_ir: store.stamp_of(node, prop),
    prefer_ir: false,
  }
  self.links.push(link)
  ignore(seeded)
  self.links.length() - 1
}

///|
pub fn IrBridge::link_at(self : IrBridge, i : Int) -> PropLink {
  self.links[i]
}

///|
pub fn IrBridge::set_prefer_ir(self : IrBridge, i : Int, prefer : Bool) -> Unit {
  self.links[i].prefer_ir = prefer
}

///|
/// Signal → IR. Only links whose signal changed since the last pull are
/// touched: an idle frame costs one `changed_at` compare per link and nothing
/// else. Returns how many words were written.
pub fn IrBridge::pull(
  self : IrBridge,
  graph : @signal.Graph[Double],
  store : IrStore,
) -> Int {
  let mut n = 0
  for i = 0; i < self.links.length(); i = i + 1 {
    let l = self.links[i]
    let at = graph.changed_at(l.sig)
    if at == l.seen_sig {
      continue
    }
    let v = graph.get(l.sig)
    if store.set(l.node, l.prop, v) {
      n = n + 1
    }
    l.seen_sig = at
    l.seen_ir = store.stamp_of(l.node, l.prop)
    self.pulls = self.pulls + 1
  }
  n
}

///|
/// IR → signal. Writes only where the word changed since we last published it,
/// i.e. where the change came from the other side (or from the store's owner).
/// Both sides changed → the conflict rule decides, and the loser is re-synced
/// rather than left divergent. Returns how many signals were written.
pub fn IrBridge::push(
  self : IrBridge,
  graph : @signal.Graph[Double],
  store : IrStore,
) -> Int {
  let mut n = 0
  for i = 0; i < self.links.length(); i = i + 1 {
    let l = self.links[i]
    let at_ir = store.stamp_of(l.node, l.prop)
    if at_ir == l.seen_ir {
      continue
    }
    let at_sig = graph.changed_at(l.sig)
    let sig_dirty = at_sig != l.seen_sig
    if sig_dirty && !l.prefer_ir {
      // the signal side wins: adopt its value into the word instead
      self.conflicts = self.conflicts + 1
      ignore(store.set(l.node, l.prop, graph.get(l.sig)))
      l.seen_ir = store.stamp_of(l.node, l.prop)
      l.seen_sig = at_sig
      continue
    }
    if sig_dirty {
      self.conflicts = self.conflicts + 1
    }
    let v = store.get(l.node, l.prop)
    ignore(graph.set(l.sig, v))
    l.seen_sig = graph.changed_at(l.sig)
    l.seen_ir = at_ir
    n = n + 1
    self.pushes = self.pushes + 1
  }
  n
}

///|
/// Idle cost check: how many links would a `pull`+`push` actually touch now.
/// Used by tests to prove a settled bridge does no work.
pub fn IrBridge::dirty_links(
  self : IrBridge,
  graph : @signal.Graph[Double],
  store : IrStore,
) -> Int {
  let mut n = 0
  for i = 0; i < self.links.length(); i = i + 1 {
    let l = self.links[i]
    if graph.changed_at(l.sig) != l.seen_sig ||
      store.stamp_of(l.node, l.prop) != l.seen_ir {
      n = n + 1
    }
  }
  n
}

// ---------------------------------------------------------------- wire format
//
// The pieces that *only* depend on "bytes on the wire" live in `core/base`:
// the checksum, the little-endian codec and the string→UTF-8 bridge. They were
// born here, but `emit/png` needs the very same CRC-32 and `render/raster` the
// very same codec, and a second copy of a checksum is how two producers start
// disagreeing about the same file. So they moved down to L0 and are re-exported
// here under their old names, which keeps the wire format's vocabulary intact
// for anyone reading `IrBridge`.

pub using @base { type Crc32 }

///|
/// Alias kept for the IR tests and for property names that travel as text.
pub fn bytes_of_string(s : String) -> FixedArray[Byte] {
  @base.utf8_bytes(s)
}


///|
/// Encode the store into a little-endian byte buffer: header, then the words
/// node-major. Returns the number of bytes written, or 0 if `buf` is too small
/// (never a partial write into the header region).
pub fn IrStore::encode_into(self : IrStore, buf : FixedArray[Byte]) -> Int {
  let total = ir_encoded_size(self.nodes)
  if buf.length() < total {
    return 0
  }
  @base.put_u32_le(buf, 0, IR_MAGIC)
  @base.put_u16(buf, 4, IR_VERSION)
  @base.put_u16(buf, 6, self.stride)
  @base.put_u32_le(buf, 8, self.nodes)
  @base.put_u32_le(buf, 12, self.nodes * self.stride * 8)
  @base.put_u32_le(buf, 20, 0)
  let mut off = IR_HEADER
  for i = 0; i < self.nodes; i = i + 1 {
    for p = 0; p < self.stride; p = p + 1 {
      @base.put_u64(buf, off, self.words[i * self.stride + p].reinterpret_as_uint64())
      off = off + 8
    }
  }
  let crc = self.crc.of(buf, IR_HEADER, self.nodes * self.stride * 8)
  @base.put_u32_le(buf, 16, crc.reinterpret_as_int())
  total
}

///|
/// Decode a store from the buffer, validating magic, version, sizes and CRC.
/// `None` means "do not trust this buffer" rather than "an empty store", which
/// is the only sane answer for a shared-memory handoff.
pub fn IrStore::decode_from(buf : FixedArray[Byte]) -> IrStore? {
  if buf.length() < IR_HEADER {
    return None
  }
  if @base.get_u32_le(buf, 0) != IR_MAGIC {
    return None
  }
  if @base.get_u16(buf, 4) != IR_VERSION {
    return None
  }
  let stride = @base.get_u16(buf, 6)
  let nodes = @base.get_u32_le(buf, 8)
  let payload = @base.get_u32_le(buf, 12)
  if stride != PROP_COUNT || nodes < 1 {
    return None
  }
  if payload != nodes * stride * 8 || buf.length() < IR_HEADER + payload {
    return None
  }
  let store = IrStore::new(nodes)
  // defaults first, so a corrupted payload cannot leave a node with scale 0
  let mut off = IR_HEADER
  for i = 0; i < nodes; i = i + 1 {
    for p = 0; p < stride; p = p + 1 {
      let bits = @base.get_u64(buf, off)
      store.words[i * stride + p] = bits.reinterpret_as_double()
      off = off + 8
    }
  }
  let want = @base.get_u32_le(buf, 16).reinterpret_as_uint()
  let got = store.crc.of(buf, IR_HEADER, payload)
  if want != got {
    return None
  }
  store.stamps = FixedArray::make(nodes * stride, 0)
  store.version = 1
  Some(store)
}

///|
/// Byte-level round-trip check of one word — used by the tests to prove the
/// encoding really is little-endian rather than "whatever the host does".
pub fn put_f64_le(buf : FixedArray[Byte], off : Int, v : Double) -> Unit {
  @base.put_f64(buf, off, v)
}

///|
pub fn get_f64_le(buf : FixedArray[Byte], off : Int) -> Double {
  @base.get_f64(buf, off)
}
