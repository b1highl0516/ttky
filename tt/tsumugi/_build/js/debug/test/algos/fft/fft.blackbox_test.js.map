///| FFT: the single most reused piece of arithmetic in the project.
///
/// What it accelerates (all of it "structure known, logic fixed"):
///  * large-kernel convolution for @fx (blur, glow) — O(N log N) beats O(N k)
///    once the kernel passes the measured crossover;
///  * circulant / diagonal matrix families in @lin (multiplication becomes a
///    pointwise product);
///  * spectral helpers for the smoothing filters in @smooth;
///  * the PNG/emit pipeline has no use for it, so it is *not* in those deps.
///
/// Design decisions that matter for the wasm target:
///  * SoA storage: separate real / imaginary `FixedArray[Double]` planes so
///    butterflies stream linearly (no interleaved stride-2 traffic).
///  * One plan object owns every table (bit-reversal, twiddles, Bluestein
///    chirp, work buffers): planning allocates once, `run` allocates nothing.
///  * Any n is supported. Powers of two take the radix-2 path; everything else
///    (primes included) takes the Bluestein chirp-z path with m = 2^ceil of
///    2n-1. No silent fallback to O(n^2).

///|
pub(all) struct Fft {
  n : Int
  log2n : Int
  mut m : Int
  rev : FixedArray[Int]
  cos : FixedArray[Double]
  sin : FixedArray[Double]
  mut chirp_cos : FixedArray[Double]
  mut chirp_sin : FixedArray[Double]
  mut b_re : FixedArray[Double]
  mut b_im : FixedArray[Double]
  mut m_rev : FixedArray[Int]
  mut m_cos : FixedArray[Double]
  mut m_sin : FixedArray[Double]
  w_re : FixedArray[Double]
  w_im : FixedArray[Double]
  // Lazily built on the first `rfft`: the half-size complex plan, its packing
  // buffers and the untangle twiddles. Plans that never call `rfft` (the
  // convolution path, for instance) pay nothing for them; after the first call
  // `rfft` allocates nothing at all — the earlier version allocated a fresh
  // `Fft::plan(n/2)` plus three arrays on *every* call, which is why it
  // measured slower than the full complex transform it was meant to beat.
  mut half : Fft?
  mut half_re : FixedArray[Double]
  mut half_im : FixedArray[Double]
  mut ut_cos : FixedArray[Double]
  mut ut_sin : FixedArray[Double]
  mut full_re : FixedArray[Double]
  mut full_im : FixedArray[Double]
}

///|
#inline
fn is_pow2(n : Int) -> Bool {
  n > 0 && (n & (n - 1)) == 0
}

///|

///|
/// Next power of two >= n (keeps transforms off the Bluestein path).
pub fn next_pow2(n : Int) -> Int {
  let mut p = 1
  while p < n {
    p = p << 1
  }
  p
}

///|
/// Build a plan for transform length n (any n >= 1).
pub fn Fft::plan(n : Int) -> Fft {
  let nn = Int::max(1, n)
  let log2n = {
    let mut k = 0
    let mut v = nn
    while v > 1 {
      v = v >> 1
      k = k + 1
    }
    k
  }
  // Work planes are needed only by Bluestein, and only m wide: one m-point
  // complex buffer is all it takes (a is built there, transformed in place,
  // multiplied by the precomputed b spectrum and transformed again).
  let work = if is_pow2(nn) { 0 } else { next_pow2(2 * nn - 1) }
  let plan : Fft = {
    n: nn,
    log2n,
    m: 0,
    rev: FixedArray::make(nn, 0),
    cos: FixedArray::make(nn / 2 + 1, 0.0),
    sin: FixedArray::make(nn / 2 + 1, 0.0),
    chirp_cos: [],
    chirp_sin: [],
    b_re: [],
    b_im: [],
    m_rev: [],
    m_cos: [],
    m_sin: [],
    w_re: FixedArray::make(work, 0.0),
    w_im: FixedArray::make(work, 0.0),
    half: None,
    half_re: [],
    half_im: [],
    ut_cos: [],
    ut_sin: [],
    full_re: [],
    full_im: [],
  }
  if is_pow2(nn) {
    // bit reversal
    for i = 0; i < nn; i = i + 1 {
      let mut r = 0
      for b = 0; b < log2n; b = b + 1 {
        r = (r << 1) | ((i >> b) & 1)
      }
      plan.rev[i] = r
    }
    // twiddles: cos/sin of the *positive* angle 2*pi*k/n. The transform
    // direction is carried by the caller's sign flag (forward = -1), which
    // keeps one table valid for both directions.
    for k = 0; k <= nn / 2; k = k + 1 {
      let ang = 2.0 * @tm.PI * k.to_double() / nn.to_double()
      plan.cos[k] = @cmath.cos(ang)
      plan.sin[k] = @cmath.sin(ang)
    }
  } else {
    let m = next_pow2(2 * nn - 1)
    plan.m = m
    plan.chirp_cos = FixedArray::make(nn, 0.0)
    plan.chirp_sin = FixedArray::make(nn, 0.0)
    plan.b_re = FixedArray::make(m, 0.0)
    plan.b_im = FixedArray::make(m, 0.0)
    plan.m_rev = FixedArray::make(m, 0)
    plan.m_cos = FixedArray::make(m / 2 + 1, 0.0)
    plan.m_sin = FixedArray::make(m / 2 + 1, 0.0)
    let mlog = {
      let mut k = 0
      let mut v = m
      while v > 1 {
        v = v >> 1
        k = k + 1
      }
      k
    }
    for i = 0; i < m; i = i + 1 {
      let mut r = 0
      for b = 0; b < mlog; b = b + 1 {
        r = (r << 1) | ((i >> b) & 1)
      }
      plan.m_rev[i] = r
    }
    for k = 0; k <= m / 2; k = k + 1 {
      let ang = 2.0 * @tm.PI * k.to_double() / m.to_double()
      plan.m_cos[k] = @cmath.cos(ang)
      plan.m_sin[k] = @cmath.sin(ang)
    }
    // chirp w[k] = exp(-i*pi*k^2/n); k^2 taken mod 2n to stay exact for
    // large n (k^2 would otherwise lose precision as a Double).
    for k = 0; k < nn; k = k + 1 {
      let k2 = k * k % (2 * nn)
      let ang = -@tm.PI * k2.to_double() / nn.to_double()
      plan.chirp_cos[k] = @cmath.cos(ang)
      plan.chirp_sin[k] = @cmath.sin(ang)
    }
    // b[k] = exp(+i*pi*k^2/n), mirrored into b[m-k] for the circular part
    for k = 0; k < nn; k = k + 1 {
      let k2 = k * k % (2 * nn)
      let ang = @tm.PI * k2.to_double() / nn.to_double()
      let c = @cmath.cos(ang)
      let s = @cmath.sin(ang)
      plan.b_re[k] = c
      plan.b_im[k] = s
      if k > 0 {
        plan.b_re[m - k] = c
        plan.b_im[m - k] = s
      }
    }
    // Precompute the spectrum of b once: the whole point of Bluestein is that
    // b (the chirp kernel) is fixed, so its transform is paid for at plan time
    // and every later n-point transform costs exactly two m-point FFTs.
    pow2_fft(plan.b_re, plan.b_im, m, plan.m_rev, plan.m_cos, plan.m_sin, -1.0)
  }
  plan
}

///|
/// In-place complex FFT on powers of two (iterative radix-2, decimation in
/// time). `sign` is -1 for the forward transform, +1 for the inverse.
fn pow2_fft(
  re : FixedArray[Double],
  im : FixedArray[Double],
  n : Int,
  rev : FixedArray[Int],
  cos : FixedArray[Double],
  sin : FixedArray[Double],
  sign : Double,
) -> Unit {
  let log2n = {
    let mut k = 0
    let mut v = n
    while v > 1 {
      v = v >> 1
      k = k + 1
    }
    k
  }
  ignore(log2n)
  // bit-reversal permutation (in place, swap pairs)
  for i = 0; i < n; i = i + 1 {
    let j = rev[i]
    if j > i {
      let tr = re[i]
      re[i] = re[j]
      re[j] = tr
      let ti = im[i]
      im[i] = im[j]
      im[j] = ti
    }
  }
  // butterflies; twiddles are read from the n-length table with stride
  let mut len = 2
  while len <= n {
    let half = len / 2
    let step = n / len
    let mut base = 0
    while base < n {
      let mut j = 0
      while j < half {
        let k = j * step
        let wr = cos[k]
        let wi = sin[k] * sign
        let a = base + j
        let b = a + half
        let xr = re[b]
        let xi = im[b]
        let tr = xr * wr - xi * wi
        let ti = xr * wi + xi * wr
        re[b] = re[a] - tr
        im[b] = im[a] - ti
        re[a] = re[a] + tr
        im[a] = im[a] + ti
        j = j + 1
      }
      base = base + len
    }
    len = len << 1
  }
}

///|
/// Forward complex transform, in place. Requires n == plan size.
pub fn Fft::forward(
  self : Fft,
  re : FixedArray[Double],
  im : FixedArray[Double],
) -> Unit {
  if self.m > 0 {
    self.bluestein(re, im, -1.0)
  } else {
    pow2_fft(re, im, self.n, self.rev, self.cos, self.sin, -1.0)
  }
}

///|
/// Inverse complex transform, in place (1/n scaling applied).
pub fn Fft::inverse(
  self : Fft,
  re : FixedArray[Double],
  im : FixedArray[Double],
) -> Unit {
  if self.m > 0 {
    self.bluestein(re, im, 1.0)
    self.scale(re, im, 1.0 / self.n.to_double())
  } else {
    pow2_fft(re, im, self.n, self.rev, self.cos, self.sin, 1.0)
    self.scale(re, im, 1.0 / self.n.to_double())
  }
}

///|
fn Fft::scale(
  self : Fft,
  re : FixedArray[Double],
  im : FixedArray[Double],
  f : Double,
) -> Unit {
  for i = 0; i < self.n; i = i + 1 {
    re[i] = re[i] * f
    im[i] = im[i] * f
  }
}

///|
/// Bluestein chirp-z: evaluates the n-point DFT as a 2m-point circular
/// convolution, valid for any n (m is the next power of two >= 2n-1).
fn Fft::bluestein(
  self : Fft,
  re : FixedArray[Double],
  im : FixedArray[Double],
  sign : Double,
) -> Unit {
  let n = self.n
  let m = self.m
  let ar = self.w_re
  let ai = self.w_im
  // a[k] = x[k] * chirp[k]  (forward) / x[k] * conj(chirp[k]) (inverse):
  // the factor is -sign because chirp already carries the forward sign, as
  // derived from tk = (t^2 + k^2 - (k-t)^2)/2.
  let factor = -sign
  for k = 0; k < n; k = k + 1 {
    let cr = self.chirp_cos[k]
    let ci = self.chirp_sin[k] * factor
    ar[k] = re[k] * cr - im[k] * ci
    ai[k] = re[k] * ci + im[k] * cr
  }
  for k = n; k < m; k = k + 1 {
    ar[k] = 0.0
    ai[k] = 0.0
  }
  pow2_fft(ar, ai, m, self.m_rev, self.m_cos, self.m_sin, -1.0)
  // Multiply with the precomputed spectrum of b. The inverse direction needs
  // the conjugate kernel (b = conj(chirp) for forward, conj(b) for inverse),
  // which is the same `factor` the chirp multiplications above use.
  for k = 0; k < m; k = k + 1 {
    let br = self.b_re[k]
    let bi = self.b_im[k] * factor
    let xr = ar[k]
    let xi = ai[k]
    ar[k] = xr * br - xi * bi
    ai[k] = xr * bi + xi * br
  }
  pow2_fft(ar, ai, m, self.m_rev, self.m_cos, self.m_sin, 1.0)
  // X[k] = conv[k] * chirp[k] (forward) / conv[k] * conj(chirp[k]) (inverse)
  let inv_m = 1.0 / m.to_double()
  for k = 0; k < n; k = k + 1 {
    let cr = self.chirp_cos[k]
    let ci = self.chirp_sin[k] * factor
    let xr = ar[k] * inv_m
    let xi = ai[k] * inv_m
    re[k] = xr * cr - xi * ci
    im[k] = xr * ci + xi * cr
  }
}
