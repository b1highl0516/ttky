///| Window functions for spectral analysis. All are built from the cosine-sum
/// family so they share one evaluation path; the coefficients are the standard
/// published ones (Hann, Hamming, Blackman, Nuttall).

///|
pub(all) enum Window {
  Rect
  Hann
  Hamming
  Blackman
  Nuttall
} derive(Eq)

///|
pub extend Window with Eq::{equal, not_equal}

///|
pub impl @debug.Debug for Window with fn to_repr(self) {
  match self {
    Rect => @debug.Repr::literal("Rect")
    Hann => @debug.Repr::literal("Hann")
    Hamming => @debug.Repr::literal("Hamming")
    Blackman => @debug.Repr::literal("Blackman")
    Nuttall => @debug.Repr::literal("Nuttall")
  }
}

///|
pub extend Window with @debug.Debug::{to_repr}

///|
/// Fill `out[0..n)` with the window coefficients.
pub fn Window::apply(self : Window, n : Int, out : FixedArray[Double]) -> Unit {
  if n <= 0 {
    return
  }
  if n == 1 {
    // The symmetric definition divides by (n - 1); with one sample there is no
    // taper to describe, and 0/0 would make the coefficient NaN. One.
    out[0] = 1.0
    return
  }
  let denom = (n - 1).to_double()
  for i = 0; i < n; i = i + 1 {
    let t = i.to_double() / denom
    out[i] = match self {
      Rect => 1.0
      Hann => 0.5 - 0.5 * @cmath.cos(2.0 * @tm.PI * t)
      Hamming => 0.54 - 0.46 * @cmath.cos(2.0 * @tm.PI * t)
      Blackman =>
        0.42 -
        0.5 * @cmath.cos(2.0 * @tm.PI * t) +
        0.08 * @cmath.cos(4.0 * @tm.PI * t)
      Nuttall =>
        0.355768 -
        0.487396 * @cmath.cos(2.0 * @tm.PI * t) +
        0.144232 * @cmath.cos(4.0 * @tm.PI * t) -
        0.012604 * @cmath.cos(6.0 * @tm.PI * t)
    }
  }
}

///|
/// Coherent gain (mean of the window), needed to normalise amplitudes.
pub fn Window::coherent_gain(self : Window, n : Int) -> Double {
  let w = FixedArray::make(n, 0.0)
  self.apply(n, w)
  let mut sum = 0.0
  for i = 0; i < n; i = i + 1 {
    sum = sum + w[i]
  }
  sum / n.to_double()
}

///|
/// Apply a window to a signal in place (multiply).
pub fn Window::apply_to(self : Window, x : FixedArray[Double], n : Int) -> Unit {
  let w = FixedArray::make(n, 0.0)
  self.apply(n, w)
  for i = 0; i < n; i = i + 1 {
    x[i] = x[i] * w[i]
  }
}
