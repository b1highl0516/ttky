///| Transcendental re-exports.
///
/// Rationale (packaging, not vanity): every downstream package then depends on
/// exactly one math surface — `@tm` — instead of reaching into the core
/// package table with its own alias. The wrappers are `#inline`, so on every
/// backend they compile down to the same intrinsic call the core function
/// would have produced; the indirection is erased at compile time.

///|
#inline
pub fn sin(x : Double) -> Double {
  @cmath.sin(x)
}

///|
#inline
pub fn cos(x : Double) -> Double {
  @cmath.cos(x)
}

///|
#inline
pub fn tan(x : Double) -> Double {
  @cmath.tan(x)
}

///|
#inline
pub fn atan(x : Double) -> Double {
  @cmath.atan(x)
}

///|
#inline
pub fn atan2(y : Double, x : Double) -> Double {
  @cmath.atan2(y, x)
}

///|
#inline
pub fn asin(x : Double) -> Double {
  @cmath.asin(x)
}

///|
#inline
pub fn acos(x : Double) -> Double {
  @cmath.acos(x)
}

///|
#inline
pub fn exp(x : Double) -> Double {
  @cmath.exp(x)
}

///|
#inline
pub fn ln(x : Double) -> Double {
  @cmath.ln(x)
}

///|
#inline
pub fn pow(x : Double, y : Double) -> Double {
  @cmath.pow(x, y)
}

///|
/// Deviation from `Double::sqrt`, on purpose: negative inputs return `0.0`
/// instead of `NaN`.
///
/// A renderer that produces NaN in a coordinate gets a blank frame with no
/// indication of where it came from; a renderer that clamps to zero gets a
/// visible degeneracy at the offending value, which is findable. Since every
/// caller in this project is geometry (lengths, radii, squared distances that
/// can go *slightly* negative from rounding), the clamp is the better failure
/// mode. It is only for that: `@tm.sqrt` must not be used where a negative
/// input means a real bug — use `x.sqrt()` there so the NaN propagates.
#inline
pub fn sqrt(x : Double) -> Double {
  if x <= 0.0 {
    0.0
  } else {
    x.sqrt()
  }
}

///|
#inline
pub fn hypot(x : Double, y : Double) -> Double {
  @cmath.hypot(x, y)
}

///|
#inline
pub fn floor(x : Double) -> Double {
  x.floor()
}

///|
#inline
pub fn ceil(x : Double) -> Double {
  x.ceil()
}

///|
#inline
pub fn round(x : Double) -> Double {
  x.round()
}

///|
#inline
pub fn trunc(x : Double) -> Double {
  x.trunc()
}

///|
#inline
pub fn abs(x : Double) -> Double {
  x.abs()
}

///|
pub const PI : Double = 3.141592653589793

///|
pub const TAU : Double = 6.283185307179586

///|
pub const DEG_TO_RAD : Double = 0.017453292519943295

///|
pub const RAD_TO_DEG : Double = 57.29577951308232

///|
#inline
pub fn cbrt(x : Double) -> Double {
  @cmath.cbrt(x)
}
