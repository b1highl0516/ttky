///| Dirty regions: the damage a frame leaves behind, expressed twice.
///
/// A renderer needs the damage in two shapes at the same time:
///
///  * a **tile set** (`DirtyRegion` keeps a bit per 16×16 px tile) — that is
///    what a tile-based backend wants, and it is the same 16×16 tiling the
///    forward+ light culling in `render/light` will use, so one grid serves
///    both;
///  * a **rectangle list** — that is what a GPU scissor / `LoadOp::Load` blit
///    wants, because setting one scissor per rect is cheaper than one per tile.
///
/// The two are reconciled by `to_rects`, a greedy row-run + vertical coalescing
/// pass that turns the tile set into a small list of *maximal, non-overlapping*
/// rectangles covering exactly the dirty tiles (the "greedy rectangle merging"
/// of tile grids; horizontal-first scanning is what makes the runs maximal in x).
///
/// Two production rules are baked in because they are what keeps a damage API
/// usable at 4K:
///
///  * **rect cap** — a frame that dirties more than `rect_cap` rectangles stops
///    growing the list and keeps their union instead. Sixteen scissor rects are
///    roughly where the driver-side cost of a rect list crosses the cost of a
///    few wasted pixels (the same heuristic ships in GDK, Sway and gogpu/ui);
/// **Edge convention**: a damage rectangle is half-open, `[min, max)`. A box
/// whose right edge lands exactly on a tile boundary does *not* dirty the tile
/// to its right, and a zero-area box dirties nothing. This matters because the
/// tile set is fed back into `to_rects`, and a rectangle produced from tiles
/// `[t0, t1]` must rasterise back to exactly those tiles — with closed edges it
/// grows by one tile on every round trip, which is exactly the bug the exact
/// cover test catches.
///
///  * **full-damage shortcut** — once every tile is dirty, the bitset is
///    bypassed entirely: `is_tile_set` answers true and `to_rects` returns the
///    viewport. A full-screen repaint is then O(1) rather than O(tiles).

///|
/// Tile edge in pixels. Matches forward+ light culling so a tile id means the
/// same thing in the damage pass and in the lighting pass.
pub const DEFAULT_TILE : Int = 16

///|
/// Past this many separate rectangles, keep the union instead of the list.
pub const DEFAULT_RECT_CAP : Int = 16

///|
pub(all) struct DirtyRegion {
  /// The rectangle the region is clamped to (the viewport, usually).
  vp : @spatial.Aabb
  mut tile : Int
  mut cols : Int
  mut rows : Int
  mut bits : @base.BitSet
  /// Number of dirty tiles, maintained incrementally (never scanned).
  mut tiles : Int
  /// Every tile is dirty: the bitset is then not touched at all.
  mut full : Bool
  /// Pixel bounds of the *tile* coverage. Conservative by construction (it is
  /// the union of whole dirty tiles), which is what a repaint bound needs.
  mut min_x : Double
  mut min_y : Double
  mut max_x : Double
  mut max_y : Double
  /// Exact rectangles as added, until the cap is exceeded.
  mut rects : Array[@spatial.Aabb]
  mut rect_cap : Int
  mut overflow : Bool
  mut adds : Int
}

///|
pub fn DirtyRegion::new(vp : @spatial.Aabb, tile : Int) -> DirtyRegion {
  let t = if tile < 1 { 1 } else { tile }
  let cols = tile_count(vp.width(), t)
  let rows = tile_count(vp.height(), t)
  {
    vp,
    tile: t,
    cols,
    rows,
    bits: @base.BitSet::new(cols * rows),
    tiles: 0,
    full: false,
    min_x: vp.max_x,
    min_y: vp.max_y,
    max_x: vp.min_x,
    max_y: vp.min_y,
    rects: [],
    rect_cap: DEFAULT_RECT_CAP,
    overflow: false,
    adds: 0,
  }
}

///|
/// How many tiles an extent of `extent` pixels needs (always ≥ 0).
fn tile_count(extent : Double, tile : Int) -> Int {
  if extent <= 0.0 {
    0
  } else {
    let n = (extent / tile.to_double()).ceil().to_int()
    if n < 0 {
      0
    } else {
      n
    }
  }
}

///|
pub fn DirtyRegion::cols(self : DirtyRegion) -> Int {
  self.cols
}

///|
pub fn DirtyRegion::rows(self : DirtyRegion) -> Int {
  self.rows
}

///|
pub fn DirtyRegion::tile_size(self : DirtyRegion) -> Int {
  self.tile
}

///|
/// Dirty tile count.
pub fn DirtyRegion::tiles(self : DirtyRegion) -> Int {
  self.tiles
}

///|
pub fn DirtyRegion::is_empty(self : DirtyRegion) -> Bool {
  self.tiles == 0
}

///|
/// True once every tile is dirty (a full-frame repaint).
pub fn DirtyRegion::is_full(self : DirtyRegion) -> Bool {
  self.full
}

///|
/// Pixel bounds of the damage; empty when nothing is dirty.
pub fn DirtyRegion::bounds(self : DirtyRegion) -> @spatial.Aabb {
  if self.tiles == 0 {
    @spatial.Aabb::empty()
  } else {
    @spatial.Aabb::new(self.min_x, self.min_y, self.max_x, self.max_y)
  }
}

///|
pub fn DirtyRegion::is_tile_set(self : DirtyRegion, tx : Int, ty : Int) -> Bool {
  if tx < 0 || ty < 0 || tx >= self.cols || ty >= self.rows {
    false
  } else if self.full {
    true
  } else {
    self.bits.get(ty * self.cols + tx)
  }
}

///|
/// Drop everything. Cheap by design: the bitset is cleared word-wise and the
/// rect list is emptied without touching the allocation.
pub fn DirtyRegion::clear(self : DirtyRegion) -> Unit {
  if !self.full {
    self.bits.clear_all()
  }
  self.full = false
  self.tiles = 0
  self.rects.clear()
  self.overflow = false
  self.adds = 0
  self.min_x = self.vp.max_x
  self.min_y = self.vp.max_y
  self.max_x = self.vp.min_x
  self.max_y = self.vp.min_y
}

///|
/// Add a damaged rectangle. Rectangles are clipped to the viewport, tracked
/// exactly (until the cap) and rasterised into tiles under the half-open edge
/// convention described at the top of the file.
pub fn DirtyRegion::add_rect(self : DirtyRegion, b : @spatial.Aabb) -> Unit {
  if b.is_empty() {
    return
  }
  let c = b.intersect(self.vp)
  if c.is_empty() {
    return
  }
  self.adds = self.adds + 1
  self.keep_rect(c)
  self.raster_rect(c)
}

///|
/// Record the exact rectangle for the scissor list, honouring the cap.
fn DirtyRegion::keep_rect(self : DirtyRegion, c : @spatial.Aabb) -> Unit {
  if self.overflow {
    return
  }
  self.rects.push(c)
  if self.rects.length() > self.rect_cap {
    // Merging to one rectangle loses pixel precision but bounds the list; a
    // frame that scatters this much damage is usually a relayout anyway, where
    // the union is within a few percent of the exact area.
    let mut u = self.rects[0]
    for i = 1; i < self.rects.length(); i = i + 1 {
      u = u.union(self.rects[i])
    }
    self.rects.clear()
    self.rects.push(u)
    self.overflow = true
  }
}

///|
/// The half-open tile span `[lo, hi]` a pixel span `[a, b)` touches.
///
/// The arithmetic lives in `algos/spatial` (`tile_span`) because the forward+
/// light culling in `render/light` must agree with this pass tile for tile.
fn tile_span(
  a : Double,
  b : Double,
  origin : Double,
  tile : Double,
) -> (Int, Int) {
  @spatial.tile_span(a, b, origin, tile)
}

///|
/// Rasterise a rectangle into the tile grid, maintaining the count and bounds
/// without ever scanning the bitset.
fn DirtyRegion::raster_rect(self : DirtyRegion, c : @spatial.Aabb) -> Unit {
  if self.full {
    return
  }
  let tf = self.tile.to_double()
  let (lx, hx) = tile_span(c.min_x, c.max_x, self.vp.min_x, tf)
  let (ly, hy) = tile_span(c.min_y, c.max_y, self.vp.min_y, tf)
  if lx > hx || ly > hy {
    return
  }
  let tx0 = clamp_tile(lx, self.cols)
  let tx1 = clamp_tile(hx, self.cols)
  let ty0 = clamp_tile(ly, self.rows)
  let ty1 = clamp_tile(hy, self.rows)
  if tx0 > tx1 || ty0 > ty1 {
    return
  }
  if tx0 == 0 && ty0 == 0 && tx1 == self.cols - 1 && ty1 == self.rows - 1 {
    // Whole-viewport damage: flip the flag instead of setting every tile bit.
    // Without this, the one frame that repaints everything (a resize, a theme
    // change) pays for all the bits it is about to make redundant.
    self.full = true
    self.tiles = self.cols * self.rows
    self.bits.clear_all()
    self.min_x = self.vp.min_x
    self.min_y = self.vp.min_y
    self.max_x = self.vp.max_x
    self.max_y = self.vp.max_y
    return
  }
  // the pixel bounds grow to whole tiles: a partially dirty tile is repainted
  // whole, so the bound must cover the whole tile too
  let x0 = self.vp.min_x + (tx0 * self.tile).to_double()
  let y0 = self.vp.min_y + (ty0 * self.tile).to_double()
  let x1 = Double::min(
    self.vp.max_x,
    self.vp.min_x + ((tx1 + 1) * self.tile).to_double(),
  )
  let y1 = Double::min(
    self.vp.max_y,
    self.vp.min_y + ((ty1 + 1) * self.tile).to_double(),
  )
  if self.tiles == 0 {
    self.min_x = x0
    self.min_y = y0
    self.max_x = x1
    self.max_y = y1
  } else {
    self.min_x = Double::min(self.min_x, x0)
    self.min_y = Double::min(self.min_y, y0)
    self.max_x = Double::max(self.max_x, x1)
    self.max_y = Double::max(self.max_y, y1)
  }
  for ty = ty0; ty <= ty1; ty = ty + 1 {
    let row = ty * self.cols
    for tx = tx0; tx <= tx1; tx = tx + 1 {
      let idx = row + tx
      if !self.bits.get(idx) {
        self.bits.set(idx)
        self.tiles = self.tiles + 1
      }
    }
  }
  if self.tiles == self.cols * self.rows {
    self.full = true
    // The bitset is now redundant; dropping it keeps the full-frame path O(1).
    self.bits.clear_all()
  }
}

///|
fn clamp_tile(v : Int, n : Int) -> Int {
  @spatial.clamp_tile(v, n)
}

///|
/// Add a box that has been placed by an affine transform, using Arvo's method:
/// transform the centre, and the half-extents through `|a|,|c|` / `|b|,|d|`.
/// Four multiplies for the extents instead of transforming four corners, and
/// the result is the *tight* axis-aligned bound of the transformed box.
pub fn DirtyRegion::add_transformed(
  self : DirtyRegion,
  box : @spatial.Aabb,
  m : @math.Mat2x3,
) -> Unit {
  self.add_rect(transform_bounds(box, m))
}

///|
/// Tight axis-aligned bounds of `b` under `m` (Arvo, "Transforming
/// axis-aligned bounding boxes", Graphics Gems I). Used for every node whose
/// geometry is rotated: transforming four corners costs four times the work and
/// gives the same answer.
pub fn transform_bounds(b : @spatial.Aabb, m : @math.Mat2x3) -> @spatial.Aabb {
  if b.is_empty() {
    return @spatial.Aabb::empty()
  }
  let cx = (b.min_x + b.max_x) * 0.5
  let cy = (b.min_y + b.max_y) * 0.5
  let ex = (b.max_x - b.min_x) * 0.5
  let ey = (b.max_y - b.min_y) * 0.5
  let ncx = m.a * cx + m.c * cy + m.e
  let ncy = m.b * cx + m.d * cy + m.f
  let nex = m.a.abs() * ex + m.c.abs() * ey
  let ney = m.b.abs() * ex + m.d.abs() * ey
  @spatial.Aabb::new(ncx - nex, ncy - ney, ncx + nex, ncy + ney)
}

///|
/// Add another region's damage. Both must share the same tile grid (the same
/// viewport and tile size), which is what a scene guarantees.
pub fn DirtyRegion::add_region(self : DirtyRegion, o : DirtyRegion) -> Unit {
  if o.tiles == 0 {
    return
  }
  if o.full {
    self.add_rect(o.vp)
    return
  }
  // exact rects first: they are the precise form and survive the cap
  if !o.overflow {
    for i = 0; i < o.rects.length(); i = i + 1 {
      self.keep_rect(o.rects[i])
    }
  } else {
    self.keep_rect(o.bounds())
  }
  if self.full || o.tiles == 0 {
    return
  }
  let tf = self.tile.to_double()
  let (lx, hx) = tile_span(o.min_x, o.max_x, self.vp.min_x, tf)
  let (ly, hy) = tile_span(o.min_y, o.max_y, self.vp.min_y, tf)
  let tx0 = clamp_tile(lx, self.cols)
  let tx1 = clamp_tile(hx, self.cols)
  let ty0 = clamp_tile(ly, self.rows)
  let ty1 = clamp_tile(hy, self.rows)
  for ty = ty0; ty <= ty1; ty = ty + 1 {
    for tx = tx0; tx <= tx1; tx = tx + 1 {
      if o.is_tile_set(tx, ty) && !self.bits.get(ty * self.cols + tx) {
        self.bits.set(ty * self.cols + tx)
        self.tiles = self.tiles + 1
      }
    }
  }
  if self.tiles == self.cols * self.rows {
    self.full = true
    self.bits.clear_all()
  }
  self.min_x = Double::min(self.min_x, Double::max(self.vp.min_x, o.min_x))
  self.min_y = Double::min(self.min_y, Double::max(self.vp.min_y, o.min_y))
  self.max_x = Double::max(self.max_x, Double::min(self.vp.max_x, o.max_x))
  self.max_y = Double::max(self.max_y, Double::min(self.vp.max_y, o.max_y))
}

///|
/// The exact rectangles added so far (pixel precision). When the cap was
/// exceeded this is the single merged rectangle, and `overflowed` says so.
pub fn DirtyRegion::pixel_rects(self : DirtyRegion) -> Array[@spatial.Aabb] {
  let out : Array[@spatial.Aabb] = []
  for i = 0; i < self.rects.length(); i = i + 1 {
    out.push(self.rects[i])
  }
  out
}

///|
pub fn DirtyRegion::overflowed(self : DirtyRegion) -> Bool {
  self.overflow
}

///|
/// Number of rectangles a caller would set scissors for.
pub fn DirtyRegion::scissor_count(self : DirtyRegion) -> Int {
  self.rects.length()
}

///|
/// Greedy row-run + vertical coalescing: the tile set as maximal,
/// non-overlapping rectangles. Exact cover (every dirty tile is in exactly one
/// rectangle), which the tests verify by re-rasterising the result.
pub fn DirtyRegion::to_rects(self : DirtyRegion) -> Array[@spatial.Aabb] {
  let out : Array[@spatial.Aabb] = []
  if self.tiles == 0 {
    return out
  }
  if self.full {
    out.push(self.vp)
    return out
  }
  // open[x] = a run that is still being extended downwards, with the row it
  // started at. Runs are kept sorted by x0, which both the row scan and the
  // two-pointer merge below rely on.
  let open_x0 : Array[Int] = []
  let open_x1 : Array[Int] = []
  let open_y0 : Array[Int] = []
  let row_x0 : Array[Int] = []
  let row_x1 : Array[Int] = []
  for ty = 0; ty < self.rows; ty = ty + 1 {
    row_x0.clear()
    row_x1.clear()
    let mut tx = 0
    while tx < self.cols {
      if self.is_tile_set(tx, ty) {
        let start = tx
        while tx < self.cols && self.is_tile_set(tx, ty) {
          tx = tx + 1
        }
        row_x0.push(start)
        row_x1.push(tx)
      } else {
        tx = tx + 1
      }
    }
    let next_x0 : Array[Int] = []
    let next_x1 : Array[Int] = []
    let next_y0 : Array[Int] = []
    let mut oi = 0
    let mut ri = 0
    while oi < open_x0.length() || ri < row_x0.length() {
      if oi < open_x0.length() && ri < row_x0.length() {
        if open_x0[oi] == row_x0[ri] && open_x1[oi] == row_x1[ri] {
          // same extent: keep growing the open run
          next_x0.push(open_x0[oi])
          next_x1.push(open_x1[oi])
          next_y0.push(open_y0[oi])
          oi = oi + 1
          ri = ri + 1
        } else if open_x0[oi] < row_x0[ri] {
          self.emit_tiles(out, open_x0[oi], open_x1[oi], open_y0[oi], ty)
          oi = oi + 1
        } else {
          next_x0.push(row_x0[ri])
          next_x1.push(row_x1[ri])
          next_y0.push(ty)
          ri = ri + 1
        }
      } else if oi < open_x0.length() {
        self.emit_tiles(out, open_x0[oi], open_x1[oi], open_y0[oi], ty)
        oi = oi + 1
      } else {
        next_x0.push(row_x0[ri])
        next_x1.push(row_x1[ri])
        next_y0.push(ty)
        ri = ri + 1
      }
    }
    open_x0.clear()
    open_x1.clear()
    open_y0.clear()
    for i = 0; i < next_x0.length(); i = i + 1 {
      open_x0.push(next_x0[i])
      open_x1.push(next_x1[i])
      open_y0.push(next_y0[i])
    }
  }
  for i = 0; i < open_x0.length(); i = i + 1 {
    self.emit_tiles(out, open_x0[i], open_x1[i], open_y0[i], self.rows)
  }
  out
}

///|
/// Turn a tile run `[tx0, tx1) × [ty0, ty1)` into a pixel rectangle.
fn DirtyRegion::emit_tiles(
  self : DirtyRegion,
  out : Array[@spatial.Aabb],
  tx0 : Int,
  tx1 : Int,
  ty0 : Int,
  ty1 : Int,
) -> Unit {
  let x0 = self.vp.min_x + (tx0 * self.tile).to_double()
  let y0 = self.vp.min_y + (ty0 * self.tile).to_double()
  let x1 = Double::min(
    self.vp.max_x,
    self.vp.min_x + (tx1 * self.tile).to_double(),
  )
  let y1 = Double::min(
    self.vp.max_y,
    self.vp.min_y + (ty1 * self.tile).to_double(),
  )
  out.push(@spatial.Aabb::new(x0, y0, x1, y1))
}

///|
/// True if every tile that `b` touches is already dirty: the damage pass can
/// then skip re-adding it (used to prune children inside a dirty group).
pub fn DirtyRegion::covers(self : DirtyRegion, b : @spatial.Aabb) -> Bool {
  if self.tiles == 0 || b.is_empty() {
    return false
  }
  if self.full {
    return true
  }
  let c = b.intersect(self.vp)
  if c.is_empty() {
    return true
  }
  let tf = self.tile.to_double()
  let (lx, hx) = tile_span(c.min_x, c.max_x, self.vp.min_x, tf)
  let (ly, hy) = tile_span(c.min_y, c.max_y, self.vp.min_y, tf)
  if lx > hx || ly > hy {
    return true
  }
  let tx0 = clamp_tile(lx, self.cols)
  let tx1 = clamp_tile(hx, self.cols)
  let ty0 = clamp_tile(ly, self.rows)
  let ty1 = clamp_tile(hy, self.rows)
  for ty = ty0; ty <= ty1; ty = ty + 1 {
    for tx = tx0; tx <= tx1; tx = tx + 1 {
      if !self.bits.get(ty * self.cols + tx) {
        return false
      }
    }
  }
  true
}

///|
/// Iterate the dirty tiles. Order is row-major, which is the order a tile
/// renderer wants to schedule work in.
pub fn DirtyRegion::for_each_tile(
  self : DirtyRegion,
  f : (Int, Int) -> Unit,
) -> Unit {
  if self.tiles == 0 {
    return
  }
  if self.full {
    for ty = 0; ty < self.rows; ty = ty + 1 {
      for tx = 0; tx < self.cols; tx = tx + 1 {
        f(tx, ty)
      }
    }
    return
  }
  for ty = 0; ty < self.rows; ty = ty + 1 {
    for tx = 0; tx < self.cols; tx = tx + 1 {
      if self.bits.get(ty * self.cols + tx) {
        f(tx, ty)
      }
    }
  }
}

///|
pub fn DirtyRegion::to_display(self : DirtyRegion) -> String {
  let b = self.bounds()
  let n_rects = self.rects.length()
  let all_tiles = self.cols * self.rows
  "DirtyRegion(tiles=\{self.tiles}/\{all_tiles}, rects=\{n_rects}, bounds=\{b.to_display()})"
}

///|
pub impl @debug.Debug for DirtyRegion with fn to_repr(self) {
  @debug.Repr::literal(self.to_display())
}

///|
pub extend DirtyRegion with @debug.Debug::{to_repr}
