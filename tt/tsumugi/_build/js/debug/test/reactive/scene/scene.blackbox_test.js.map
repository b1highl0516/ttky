///| Tests for the property layer: the flat store, the two-way bridge, and the
/// wire format that the js side reads.
///
/// The properties worth testing here are the ones that make a two-way binding
/// usable rather than merely present:
///
///  * a settled bridge does **zero** work in both directions (no echo, no
///    oscillation, no "write back what you just read");
///  * a genuine conflict resolves deterministically, and the loser is re-synced
///    rather than left divergent;
///  * the bytes really are little-endian with a correct CRC-32 (checked against
///    the standard `"123456789"` → `0xCBF43926` vector), because a shared buffer
///    between wasm and js is exactly where "it worked on my machine" hides.

///|
/// The well-known CRC-32 check value, checked at byte level.
fn ascii_bytes(s : String) -> FixedArray[Byte] {
  @scene.bytes_of_string(s)
}

///|
test "ir: store defaults, equality cut-off and stamps" {
  let st = @scene.IrStore::new(4)
  assert_eq(st.node_count(), 4)
  assert_eq(st.stride(), @scene.PROP_COUNT)
  // a fresh node is unit scale / unit opacity / no translation
  assert_eq(st.get(0, @scene.PropId::Sx), 1.0)
  assert_eq(st.get(0, @scene.PropId::Sy), 1.0)
  assert_eq(st.get(0, @scene.PropId::Op), 1.0)
  assert_eq(st.get(0, @scene.PropId::Px), 0.0)
  // a real write bumps the stamp, an identical write does not
  assert_true(st.set(1, @scene.PropId::Px, 12.0), msg="first write changes")
  assert_eq(st.get(1, @scene.PropId::Px), 12.0)
  assert_eq(st.stamp_of(1, @scene.PropId::Px), 1)
  assert_true(
    st.set(1, @scene.PropId::Px, 12.0) == false,
    msg="identical write",
  )
  assert_eq(st.stamp_of(1, @scene.PropId::Px), 1)
  // out-of-range access is total, not a crash
  assert_eq(st.get(99, @scene.PropId::Px), 0.0)
  assert_true(
    st.set(99, @scene.PropId::Px, 1.0) == false,
    msg="out of range write is refused",
  )
  assert_eq(st.stamp_of(99, @scene.PropId::Px), -1)
  // growing keeps the words
  st.grow_to(8)
  assert_eq(st.get(1, @scene.PropId::Px), 12.0)
  assert_eq(st.node_count(), 8)
}

///|
test "ir: TRS and clip round-trip through the store" {
  let st = @scene.IrStore::new(2)
  let t = @scene.Trs::new(3.5, -2.25, 0.75, 2.0, 0.5)
  assert_true(st.set_trs(0, t), msg="set_trs changes something")
  let back = st.trs_of(0)
  assert_true(@scene.Trs::equal(back, t), msg="trs round trip")
  assert_true(st.set_trs(0, t) == false, msg="identical trs is a no-op")
  let clip = @spatial.Aabb::new(1.0, 2.0, 30.0, 40.0)
  assert_true(st.set_clip(0, clip), msg="set_clip")
  assert_eq(st.clip_of(0), clip)
  // the factory default is "no clip" (a degenerate box, not infinities — the
  // js side reads these words)
  assert_true(st.has_clip(1) == false, msg="default clip means no clip")
  assert_eq(st.clip_of(1), @spatial.Aabb::new(0.0, 0.0, 0.0, 0.0))
}

///|
test "ir: apply_to_scene is idempotent and only damages when it changes" {
  let s = @scene.Scene::new(@spatial.Aabb::new(0.0, 0.0, 128.0, 128.0), 16)
  let st = @scene.IrStore::new(2)
  let n = s.add_node(
    0,
    @scene.Trs::at(4.0, 4.0),
    @spatial.Aabb::new(0.0, 0.0, 16.0, 16.0),
  )
  ignore(s.flush())
  // publishing the scene into the store, then applying the store back, is a
  // no-op both times: this is the property that makes the round trip safe
  assert_true(
    st.publish_from_scene(s, n),
    msg="first publish writes the defaults",
  )
  assert_true(
    st.publish_from_scene(s, n) == false,
    msg="second publish changes nothing",
  )
  assert_true(
    st.apply_to_scene(s, n) == false,
    msg="applying what we published is a no-op",
  )
  s.begin_frame()
  ignore(s.flush())
  assert_true(
    s.dirty().is_empty(),
    msg="an idempotent round trip must damage nothing",
  )
  // now change the store the way the js side would
  assert_true(st.set(n, @scene.PropId::Px, 40.0), msg="js-side edit")
  assert_true(st.apply_to_scene(s, n), msg="the edit reaches the scene")
  let stt = s.flush()
  assert_true(
    stt.pre_rects >= 1 && stt.post_rects >= 1,
    msg="the node moved, so both ends are damaged",
  )
  assert_eq(s.bounds_of(n).min_x, 40.0)
  // a clip written from the store lands as a clip
  assert_true(
    st.set_clip(n, @spatial.Aabb::new(0.0, 0.0, 8.0, 8.0)),
    msg="clip edit",
  )
  assert_true(st.apply_to_scene(s, n), msg="clip reaches the scene")
  assert_true(s.has_clip(n), msg="the scene node now has a clip")
  assert_true(
    st.clip_of(n).is_empty() == false,
    msg="and the store still has it",
  )
  // ... and the no-clip marker clears it (and publishing the scene back writes
  // the marker, so a removed clip does not linger in the store)
  assert_true(
    st.set_clip(n, @scene.IrStore::no_clip()),
    msg="clear clip from the store",
  )
  assert_true(st.apply_to_scene(s, n), msg="applies")
  assert_true(s.has_clip(n) == false, msg="the clip is gone")
  assert_true(st.set(n, @scene.PropId::Px, 41.0), msg="move again")
  ignore(st.apply_to_scene(s, n))
  ignore(s.flush())
  assert_true(
    st.publish_from_scene(s, n) == false,
    msg="the store already agrees with the scene",
  )
}

///|
test "ir: the bridge pulls only what changed and never echoes" {
  let g : @signal.Graph[Double] = @signal.Graph::new()
  let st = @scene.IrStore::new(2)
  let bridge = @scene.IrBridge::new()
  let sx = g.source(1.0)
  let px = g.source(0.0)
  ignore(bridge.bind(g, st, 0, @scene.PropId::Px, px))
  ignore(bridge.bind(g, st, 0, @scene.PropId::Sx, sx))
  assert_eq(bridge.count(), 2)
  // a settled bridge does nothing at all
  assert_eq(bridge.dirty_links(g, st), 0)
  assert_eq(bridge.pull(g, st), 0)
  assert_eq(bridge.push(g, st), 0)
  // a signal-side edit is pulled exactly once
  ignore(g.set(px, 12.5))
  ignore(g.flush())
  assert_eq(bridge.dirty_links(g, st), 1)
  assert_eq(bridge.pull(g, st), 1)
  assert_eq(st.get(0, @scene.PropId::Px), 12.5)
  // ... and after the pull, nothing is dirty in either direction
  assert_eq(bridge.dirty_links(g, st), 0)
  assert_eq(bridge.pull(g, st), 0)
  assert_eq(bridge.push(g, st), 0)
  assert_eq(st.writes(), 1)
}

///|
test "ir: a conflict resolves by policy, and the loser is re-synced" {
  let g : @signal.Graph[Double] = @signal.Graph::new()
  let st = @scene.IrStore::new(1)
  let bridge = @scene.IrBridge::new()
  let sig = g.source(0.0)
  let link = bridge.bind(g, st, 0, @scene.PropId::Px, sig)
  assert_eq(bridge.push(g, st), 0)
  // both sides change between two syncs
  ignore(st.set(0, @scene.PropId::Px, 5.0))
  ignore(g.set(sig, 9.0))
  ignore(g.flush())
  // default: the signal side wins, and the store adopts 9.0 instead of diverging
  assert_eq(bridge.push(g, st), 0)
  assert_eq(st.get(0, @scene.PropId::Px), 9.0)
  assert_eq(g.get(sig), 9.0)
  assert_eq(bridge.dirty_links(g, st), 0)
  // IR side wins when the link says so
  bridge.set_prefer_ir(link, true)
  ignore(st.set(0, @scene.PropId::Px, 20.0))
  ignore(g.set(sig, 30.0))
  ignore(g.flush())
  assert_eq(bridge.push(g, st), 1)
  assert_eq(g.get(sig), 20.0)
  assert_eq(st.get(0, @scene.PropId::Px), 20.0)
  assert_eq(bridge.dirty_links(g, st), 0)
  // multi-step: signal → store → scene → damage, and back again
  let s = @scene.Scene::new(@spatial.Aabb::new(0.0, 0.0, 128.0, 128.0), 16)
  // the word is already 20.0; the scene starts at 0
  let st_scene = @scene.IrStore::new(2)
  let node = s.add_node(
    0,
    @scene.Trs::at(0.0, 0.0),
    @spatial.Aabb::new(0.0, 0.0, 8.0, 8.0),
  )
  ignore(s.flush())
  s.begin_frame()
  ignore(st_scene.set(node, @scene.PropId::Px, 20.0))
  ignore(st_scene.apply_to_scene(s, node))
  ignore(s.flush())
  assert_eq(s.bounds_of(node).min_x, 20.0)
  assert_true(
    s.dirty().is_empty() == false,
    msg="the move damaged the two positions",
  )
}

///|
test "ir: encode/decode is little-endian with a real CRC-32" {
  // CRC-32 of the ASCII string "123456789" is 0xCBF43926 — the standard check
  // value. Verified at byte level so that the bit pattern, not just "some
  // number", is pinned down.
  let crc = @scene.Crc32::new()
  let digits = ascii_bytes("123456789")
  let v = crc.of(digits, 0, 9)
  let buf : FixedArray[Byte] = FixedArray::make(
    8,
    (0).reinterpret_as_uint().to_byte(),
  )
  @base.put_u32_le(buf, 0, v.reinterpret_as_int())
  assert_eq(buf[0].to_int(), 0x26)
  assert_eq(buf[1].to_int(), 0x39)
  assert_eq(buf[2].to_int(), 0xF4)
  assert_eq(buf[3].to_int(), 0xCB)
  // and a one-bit flip changes it
  assert_true(
    crc.of(ascii_bytes("12345678A"), 0, 9) != v,
    msg="crc must depend on the data",
  )
}

///|
test "ir: the wire format round-trips, and rejects anything corrupt" {
  let st = @scene.IrStore::new(3)
  ignore(st.set(0, @scene.PropId::Px, 1.5))
  ignore(st.set(1, @scene.PropId::Py, -2.25))
  ignore(st.set(2, @scene.PropId::Op, 0.5))
  ignore(st.set(2, @scene.PropId::ClipR, 64.0))
  let size = @scene.ir_encoded_size(3)
  assert_eq(size, @scene.IR_HEADER + 3 * @scene.PROP_COUNT * 8)
  let buf : FixedArray[Byte] = FixedArray::make(
    size,
    (0).reinterpret_as_uint().to_byte(),
  )
  assert_eq(st.encode_into(buf), size)
  // header fields are at the documented offsets
  assert_eq(@base.get_u32_le(buf, 0), @scene.IR_MAGIC)
  assert_eq(buf[4].to_int(), @scene.IR_VERSION)
  assert_eq(buf[6].to_int(), @scene.PROP_COUNT)
  // the payload really is little-endian: 1.5 is 0x3FF8000000000000, so its
  // highest byte 0x3F is the *last* byte of the word
  assert_eq(buf[@scene.IR_HEADER + 7].to_int(), 0x3F)
  assert_eq(buf[@scene.IR_HEADER + 6].to_int(), 0xF8)
  assert_eq(@scene.get_f64_le(buf, @scene.IR_HEADER), 1.5)
  let back = @scene.IrStore::decode_from(buf)
  match back {
    None => fail("a valid buffer must decode")
    Some(d) => {
      assert_eq(d.node_count(), 3)
      assert_eq(d.get(0, @scene.PropId::Px), 1.5)
      assert_eq(d.get(1, @scene.PropId::Py), -2.25)
      assert_eq(d.get(2, @scene.PropId::Op), 0.5)
      assert_eq(d.get(2, @scene.PropId::ClipR), 64.0)
      // a decoded store is a fresh one: nothing is "already published"
      assert_eq(d.stamp_of(0, @scene.PropId::Px), 0)
    }
  }
  // corruption in the payload is caught by the CRC
  let bad : FixedArray[Byte] = FixedArray::make(
    size,
    (0).reinterpret_as_uint().to_byte(),
  )
  for i = 0; i < size; i = i + 1 {
    bad[i] = buf[i]
  }
  bad[@scene.IR_HEADER + 2] = (0x7F).reinterpret_as_uint().to_byte()
  assert_true(
    @scene.IrStore::decode_from(bad) is None,
    msg="a flipped payload byte must be rejected",
  )
  // a flipped header field is caught by the magic / version checks
  let bad2 : FixedArray[Byte] = FixedArray::make(
    size,
    (0).reinterpret_as_uint().to_byte(),
  )
  for i = 0; i < size; i = i + 1 {
    bad2[i] = buf[i]
  }
  bad2[0] = (0x00).reinterpret_as_uint().to_byte()
  assert_true(
    @scene.IrStore::decode_from(bad2) is None,
    msg="a wrong magic must be rejected",
  )
  let bad3 : FixedArray[Byte] = FixedArray::make(
    size,
    (0).reinterpret_as_uint().to_byte(),
  )
  for i = 0; i < size; i = i + 1 {
    bad3[i] = buf[i]
  }
  bad3[4] = (99).reinterpret_as_uint().to_byte()
  assert_true(
    @scene.IrStore::decode_from(bad3) is None,
    msg="a wrong version must be rejected",
  )
  // too small, and a truncated payload, are refused rather than misread
  let eight : FixedArray[Byte] = FixedArray::make(
    8,
    (0).reinterpret_as_uint().to_byte(),
  )
  assert_true(@scene.IrStore::decode_from(eight) is None, msg="short header")
  let short : FixedArray[Byte] = FixedArray::make(
    size - 8,
    (0).reinterpret_as_uint().to_byte(),
  )
  for i = 0; i < short.length(); i = i + 1 {
    short[i] = buf[i]
  }
  assert_true(
    @scene.IrStore::decode_from(short) is None,
    msg="truncated payload",
  )
  // and an undersized encode target is refused instead of writing half a frame
  let tiny : FixedArray[Byte] = FixedArray::make(
    @scene.IR_HEADER,
    (0).reinterpret_as_uint().to_byte(),
  )
  assert_eq(st.encode_into(tiny), 0)
}
