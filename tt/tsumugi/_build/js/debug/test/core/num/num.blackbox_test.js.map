///| Q16.16 fixed-point arithmetic.
///
/// Why fixed point at all, next to `Double`?  Layout is fixed and logic is
/// data-independent: 32-bit fixed point is bit-reproducible across every
/// backend (no soft-float drift, no x87/SSE differences), it halves memory
/// traffic for the z-buffer / depth keys / light radii, and it is exactly the
/// representation used on the wasm side when state must be shared with the JS
/// host through a single `i32` array. Everything here is deterministic: the
/// same input bytes produce the same output bits on native, wasm and JS.

///|
/// Raw Q16.16 representation (1.0 == 65536).
///
/// `#valtype` is what makes fixed point worth having at all: an unboxed
/// single-word value type means `Fx` lives in a register and never touches
/// the heap. Measured without it, a `Fx::mul` round trip cost ~23 ns against
/// 0.8 ns for the bare integer multiply it lowers to (docs/bench).
#valtype
pub(all) struct Fx {
  raw : Int
} derive(Eq)

///|
pub extend Fx with Eq::{equal, not_equal}

///|
pub let fx_one : Fx = { raw: 65536, }

///|
pub let fx_zero : Fx = { raw: 0, }

///|
#inline
pub fn Fx::from_raw(raw : Int) -> Fx {
  { raw, }
}

///|
/// Convert with rounding to nearest; saturates outside the representable
/// range (+-32768) instead of wrapping.
pub fn Fx::from_double(x : Double) -> Fx {
  let scaled = x * 65536.0
  if scaled >= 2147483647.0 {
    { raw: 2147483647, }
  } else if scaled <= -2147483648.0 {
    { raw: -2147483648, }
  } else {
    { raw: scaled.round().to_int(), }
  }
}

///|
pub fn Fx::to_double(self : Fx) -> Double {
  self.raw.to_double() / 65536.0
}

///|
/// Saturating addition (never wraps, never traps).
pub fn Fx::add(self : Fx, o : Fx) -> Fx {
  let s = self.raw + o.raw
  // overflow iff both operands share a sign that differs from the result's
  if ((self.raw ^ s) & (o.raw ^ s)) < 0 {
    if self.raw < 0 {
      { raw: -2147483648, }
    } else {
      { raw: 2147483647, }
    }
  } else {
    { raw: s, }
  }
}

///|
pub fn Fx::sub(self : Fx, o : Fx) -> Fx {
  let s = self.raw - o.raw
  if ((self.raw ^ o.raw) & (self.raw ^ s)) < 0 {
    if self.raw < 0 {
      { raw: -2147483648, }
    } else {
      { raw: 2147483647, }
    }
  } else {
    { raw: s, }
  }
}

///|
/// 64-bit intermediate product, single rounding shift (round-half-up).
#inline
pub fn Fx::mul(self : Fx, o : Fx) -> Fx {
  let p = self.raw.to_int64() * o.raw.to_int64()
  let shifted = (p + 32768L) >> 16
  if shifted > 2147483647L {
    { raw: 2147483647, }
  } else if shifted < -2147483648L {
    { raw: -2147483648, }
  } else {
    { raw: shifted.to_int(), }
  }
}

///|
/// Division with a 64-bit-accuracy numerator and division-by-zero guard.
pub fn Fx::div(self : Fx, o : Fx) -> Fx {
  if o.raw == 0 {
    if self.raw >= 0 {
      { raw: 2147483647, }
    } else {
      { raw: -2147483648, }
    }
  } else {
    let num = self.raw.to_int64() << 16
    let den = o.raw.to_int64()
    let q = floor_div(2L * num + den, 2L * den)
    if q > 2147483647L {
      { raw: 2147483647, }
    } else if q < -2147483648L {
      { raw: -2147483648, }
    } else {
      { raw: q.to_int(), }
    }
  }
}

///|
/// Floor division for Int64 (MoonBit's `/` truncates toward zero). Needed so
/// the rounding above is "half up" for negative values too.
fn floor_div(a : Int64, b : Int64) -> Int64 {
  let q = a / b
  if a % b != 0L && (a < 0L) != (b < 0L) {
    q - 1L
  } else {
    q
  }
}

///|
/// Square root of the fixed value.
///
/// sqrt(x/65536)*65536 = sqrt(x*65536), so the job is the integer square root
/// of `raw << 16` (a 47-bit number, exactly representable as a double).
///
/// The f64 `sqrt` is used *only* as a seed. IEEE-754 square root is correctly
/// rounded, so for an exactly representable input the seed is within one unit
/// of `floor(sqrt(n))`; the integer Newton steps plus the correction loops
/// below then make the result exactly `floor(sqrt(n))` for every input,
/// independent of the seed. So the output is still an exact, deterministic
/// integer result — it just no longer pays for 47 shift-and-compare rounds
/// (measured on native release: 80 ns/op restoring vs 5.4 ns/op seeded).
pub fn Fx::sqrt(self : Fx) -> Fx {
  if self.raw <= 0 {
    return fx_zero
  }
  let n = self.raw.to_int64() << 16
  { raw: isqrt64(n).to_int(), }
}

///|
/// Exact `floor(sqrt(n))` for n >= 0, seeded by a double sqrt.
pub fn isqrt64(n : Int64) -> Int64 {
  if n <= 0L {
    return 0L
  }
  let mut r = n.to_double().sqrt().to_int64()
  if r < 1L {
    r = 1L
  }
  // Two integer Newton steps (each is exact integer arithmetic) bring the
  // seed onto floor(sqrt(n)) or its immediate neighbour.
  let mut step = 0
  while step < 2 {
    let q = n / r
    if q >= r {
      break
    }
    r = (r + q) >> 1
    step = step + 1
  }
  // Correction: the loops run at most twice given a correctly-rounded seed.
  while r > 0L && r * r > n {
    r = r - 1L
  }
  while (r + 1L) * (r + 1L) <= n {
    r = r + 1L
  }
  r
}

///|
/// Bit-by-bit (restoring) integer square root, kept as the floating-point-free
/// reference the seeded version is tested against.
pub fn isqrt64_restoring(n : Int64) -> Int64 {
  if n <= 0L {
    return 0L
  }
  let mut res : Int64 = 0L
  let mut bit : Int64 = 1L << 62
  let mut rem = n
  while bit > rem {
    bit = bit >> 2
  }
  while bit != 0L {
    if rem >= res + bit {
      rem = rem - (res + bit)
      res = (res >> 1) + bit
    } else {
      res = res >> 1
    }
    bit = bit >> 2
  }
  res
}

///|
/// Exact integer square root without any floating point: the reference path
/// for platforms where `sqrt` must not be used at all.
pub fn Fx::sqrt_restoring(self : Fx) -> Fx {
  if self.raw <= 0 {
    return fx_zero
  }
  { raw: isqrt64_restoring(self.raw.to_int64() << 16).to_int(), }
}

///|
pub fn Fx::abs(self : Fx) -> Fx {
  if self.raw < 0 {
    { raw: -self.raw, }
  } else {
    self
  }
}

///|
pub fn Fx::min(self : Fx, o : Fx) -> Fx {
  if self.raw < o.raw {
    self
  } else {
    o
  }
}

///|
pub fn Fx::max(self : Fx, o : Fx) -> Fx {
  if self.raw > o.raw {
    self
  } else {
    o
  }
}

///|
/// Linear interpolation with 64-bit intermediate (no precision loss for
/// the common t in [0,1] case).
pub fn Fx::lerp(self : Fx, o : Fx, t : Fx) -> Fx {
  let d = (o.raw - self.raw).to_int64() * t.raw.to_int64()
  { raw: self.raw + (d >> 16).to_int(), }
}

///|
/// Human readable fixed-point rendering (4 fractional digits).
pub fn Fx::to_display(self : Fx) -> String {
  let sign = if self.raw < 0 { "-" } else { "" }
  let v = self.raw.abs()
  let int_part = v >> 16
  // print 4 fractional digits (1/65536 ~ 1.5e-5)
  let frac = ((v & 0xFFFF) * 10000) >> 16
  let mut frac_s = frac.to_string()
  while frac_s.length() < 4 {
    frac_s = "0" + frac_s
  }
  sign + int_part.to_string() + "." + frac_s
}

///|
pub impl @debug.Debug for Fx with fn to_repr(self) {
  @debug.Repr::literal(self.to_display())
}

///|
pub extend Fx with @debug.Debug::{to_repr}
