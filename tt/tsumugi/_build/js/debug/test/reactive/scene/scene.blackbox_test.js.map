///| Checksums that a file format defines, not that we invented.
///
/// Both live here rather than next to either user: CRC-32 is needed by the IR
/// wire format (`reactive/scene`) *and* by PNG (`emit/png`), and Adler-32 by
/// zlib streams inside PNG. A checksum is structure-known, logic-fixed,
/// data-varying — the exact shape of package that belongs in L0 with a
/// reference vector as its test.
///
/// Reference vectors, so this can never quietly become "self-consistent":
///
///  * CRC-32 of `"123456789"` is `0xCBF43926` (the check value in every CRC
///    catalogue; it is what zlib, PNG, gzip and every browser `crc32()` agree
///    on);
///  * Adler-32 of `"Wikipedia"` is `0x11E60398` (the RFC 1950 example).

///|
/// CRC-32 (reflected, polynomial `0xEDB88320`), table-driven.
pub(all) struct Crc32 {
  table : FixedArray[UInt]
}

///|
pub fn Crc32::new() -> Crc32 {
  let table = FixedArray::make(256, 0U)
  for i = 0; i < 256; i = i + 1 {
    // `UInt` throughout: CRC-32 is defined on unsigned 32-bit words, and a
    // signed shift would smear the top bit into the value — a CRC that only
    // agrees with itself and not with zlib.
    let mut c = i.reinterpret_as_uint()
    for _k = 0; _k < 8; _k = _k + 1 {
      c = if (c & 1U) != 0U { (c >> 1) ^ 0xEDB88320U } else { c >> 1 }
    }
    table[i] = c
  }
  { table, }
}

///|
/// Update a running CRC with `len` bytes of `buf`.
pub fn Crc32::update(
  self : Crc32,
  buf : FixedArray[Byte],
  off : Int,
  len : Int,
  seed : UInt,
) -> UInt {
  let mut c = seed
  for i = 0; i < len; i = i + 1 {
    let b = buf[off + i].to_int() & 255
    c = (c >> 8) ^ self.table[(c.reinterpret_as_int() ^ b) & 255]
  }
  c
}

///|
/// CRC-32 of a byte range.
pub fn Crc32::of(self : Crc32, buf : FixedArray[Byte], off : Int, len : Int) -> UInt {
  self.update(buf, off, len, 0xFFFFFFFFU) ^ 0xFFFFFFFFU
}

///|
/// Continuation of `of` over more bytes (checksums are appendable).
pub fn Crc32::continue_with(self : Crc32, seed : UInt, buf : FixedArray[Byte], len : Int) -> UInt {
  // `of` complements at the end; un-complement before folding more data in
  self.update(buf, 0, len, seed ^ 0xFFFFFFFFU) ^ 0xFFFFFFFFU
}

///|
/// Adler-32 (RFC 1950): two running sums modulo 65521, with the deferred
/// modulo the RFC uses so a 32-bit accumulator cannot overflow before 5552
/// bytes.
pub fn adler32(buf : FixedArray[Byte], off : Int, len : Int) -> UInt {
  let mut a = 1U
  let mut b = 0U
  let mut i = 0
  while i < len {
    let n = Int::min(5552, len - i)
    for _k = 0; _k < n; _k = _k + 1 {
      a = a + (buf[off + i + _k].to_int() & 255).reinterpret_as_uint()
      b = b + a
    }
    a = a % 65521U
    b = b % 65521U
    i = i + n
  }
  (b << 16) | a
}

///|
/// Adler-32 of a `Bytes` view (a String's UTF-8 form, usually).
///
/// Deliberately takes `Bytes` and not `String`: `String::to_bytes()` hands back
/// the runtime's *internal* encoding (UTF-16 in this toolchain — 18 bytes for a
/// 9-byte ASCII string), which would silently produce a checksum that matches
/// nothing on earth. Convert with `@utf8.encode` at the call site.
pub fn adler32_bytes(s : Bytes) -> UInt {
  let buf = FixedArray::make(s.length(), b'\x00')
  for i = 0; i < s.length(); i = i + 1 {
    buf[i] = s[i]
  }
  adler32(buf, 0, s.length())
}

///|
/// Adler-32 of a string's UTF-8 form (no `@utf8` import needed by callers).
pub fn adler32_string(s : String) -> UInt {
  adler32_bytes(@utf8.encode(s))
}
