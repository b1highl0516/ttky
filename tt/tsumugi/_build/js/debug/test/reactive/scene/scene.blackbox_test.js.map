///| Tile arithmetic, shared by every pass that thinks in 16×16 blocks.
///
/// Three passes need the same answer to "which tiles does this rectangle
/// touch", and they must agree exactly or the passes disagree about the frame:
///
///  * damage tracking (`reactive/scene`) — which tiles need repainting,
///  * forward+ light culling (`render/light`) — which tiles a light reaches,
///  * the vertex/index path of anything that renders per tile.
///
/// The convention is **half-open**: a span `[a, b)` touches tile `t` when
/// `t·tile + origin <= a < (t+1)·tile + origin`, and a span whose end lands
/// exactly on a tile boundary does not touch the next tile. A zero-width span
/// touches nothing. Getting this wrong is not a rounding detail: a damage rect
/// generated *from* a tile set and fed back through this function would grow by
/// one tile per round trip, which is how the bug shows up.

///| Tile edges. One constant, so every pass means the same thing by "tile".
pub const TILE : Int = 16

///|
/// The half-open tile span `[lo, hi]` a pixel span `[a, b)` touches, before
/// clamping to any grid. `hi < lo` means "touches nothing".
pub fn tile_span(a : Double, b : Double, origin : Double, tile : Double) -> (Int, Int) {
  let lo = ((a - origin) / tile).floor().to_int()
  let hi = ((b - origin) / tile).ceil().to_int() - 1
  (lo, hi)
}

///|
/// Index of the tile containing `v` on one axis. Not clamped: a value outside
/// the grid returns a tile index outside the grid, which callers clamp with
/// `clamp_tile` so that "outside" stays distinguishable from "edge".
pub fn tile_of(v : Double, origin : Double, tile : Double) -> Int {
  ((v - origin) / tile).floor().to_int()
}

///|
/// Clamp a tile index into `[0, n)`.
pub fn clamp_tile(v : Int, n : Int) -> Int {
  if v < 0 {
    0
  } else if v >= n {
    n - 1
  } else {
    v
  }
}

///|
/// The pixel rectangle of the tile range `[tx0, tx1] × [ty0, ty1]` (inclusive),
/// clipped to `clip`. Used to turn a tile span back into pixels: a damage rect,
/// a light's tile rectangle, a scissor.
pub fn tile_rect(
  tx0 : Int,
  ty0 : Int,
  tx1 : Int,
  ty1 : Int,
  origin_x : Double,
  origin_y : Double,
  tile : Double,
  clip : Aabb,
) -> Aabb {
  let x0 = origin_x + (tx0.to_double() * tile)
  let y0 = origin_y + (ty0.to_double() * tile)
  let x1 = Double::min(clip.max_x, origin_x + ((tx1 + 1).to_double() * tile))
  let y1 = Double::min(clip.max_y, origin_y + ((ty1 + 1).to_double() * tile))
  Aabb::new(Double::max(clip.min_x, x0), Double::max(clip.min_y, y0), x1, y1)
}
