///| Tests for the damage representation. The important properties are not
/// "the API returns something" but:
///
///  * `to_rects` is an *exact* cover of the tile set (verified by rasterising
///    the rectangles back into a second region and comparing tile by tile);
///  * every tile a damaged box touches is dirty, and no tile it does not touch
///    is (verified against a brute-force rasteriser written here, not shared
///    with the implementation);
///  * `transform_bounds` is tight under rotation and shear (verified against
///    21×21 sampled points of the source box *and* against the four-corner
///    bound).

///|
/// A brute-force rasteriser: which tiles does this box touch? Written from the
/// definition (floor of the pixel offsets), independently of the package.
fn naive_tiles(
  b : @spatial.Aabb,
  vp : @spatial.Aabb,
  tile : Int,
  cols : Int,
  rows : Int,
) -> Array[(Int, Int)] {
  let out : Array[(Int, Int)] = []
  let c = b.intersect(vp)
  if c.is_empty() {
    return out
  }
  let tf = tile.to_double()
  // half-open span: shrink the far edge by an epsilon so a box that ends
  // exactly on a tile boundary does not claim the next tile
  let eps = 1.0e-9
  let x0 = ((c.min_x - vp.min_x) / tf).floor().to_int()
  let x1 = ((c.max_x - eps - vp.min_x) / tf).floor().to_int()
  let y0 = ((c.min_y - vp.min_y) / tf).floor().to_int()
  let y1 = ((c.max_y - eps - vp.min_y) / tf).floor().to_int()
  if x1 < x0 || y1 < y0 {
    return out
  }
  for ty = y0; ty <= y1; ty = ty + 1 {
    for tx = x0; tx <= x1; tx = tx + 1 {
      if tx >= 0 && ty >= 0 && tx < cols && ty < rows {
        out.push((tx, ty))
      }
    }
  }
  out
}

///|
/// Sorted list of the region's dirty tiles, for set comparisons.
fn tiles_of(r : @scene.DirtyRegion) -> Array[(Int, Int)] {
  let out : Array[(Int, Int)] = []
  r.for_each_tile(fn(tx, ty) { out.push((tx, ty)) })
  out
}

///|
fn tile_key(t : (Int, Int)) -> Int {
  t.0 * 100000 + t.1
}

///|
/// Sorted, de-duplicated tile keys — the tile *set* as a comparable list.
/// De-duplication matters: adding two overlapping boxes lists a shared tile
/// twice, and set equality is what the tests mean.
fn sorted_keys(ts : Array[(Int, Int)]) -> Array[Int] {
  let ks : Array[Int] = []
  for i = 0; i < ts.length(); i = i + 1 {
    ks.push(tile_key(ts[i]))
  }
  ks.sort()
  let out : Array[Int] = []
  for i = 0; i < ks.length(); i = i + 1 {
    if i == 0 || ks[i] != ks[i - 1] {
      out.push(ks[i])
    }
  }
  out
}

///|
fn same_tiles(a : Array[(Int, Int)], b : Array[(Int, Int)]) -> Bool {
  let ka = sorted_keys(a)
  let kb = sorted_keys(b)
  if ka.length() != kb.length() {
    return false
  }
  for i = 0; i < ka.length(); i = i + 1 {
    if ka[i] != kb[i] {
      return false
    }
  }
  true
}

///|
/// The viewport used by most tests.
fn vp() -> @spatial.Aabb {
  @spatial.Aabb::new(0.0, 0.0, 256.0, 192.0)
}

///|
test "dirty: every touched tile is dirty and nothing else" {
  let r = @scene.DirtyRegion::new(vp(), 16)
  assert_eq(r.cols(), 16)
  assert_eq(r.rows(), 12)
  let boxes : Array[@spatial.Aabb] = [
    @spatial.Aabb::new(3.0, 5.0, 40.0, 20.0),
    @spatial.Aabb::new(200.0, 100.0, 255.0, 191.0),
    @spatial.Aabb::new(16.0, 16.0, 32.0, 32.0),
    // exactly on a tile boundary, and degenerate: half-open means no tiles
    @spatial.Aabb::new(128.0, 64.0, 128.0, 64.0),
  ]
  let want : Array[(Int, Int)] = []
  for i = 0; i < boxes.length(); i = i + 1 {
    r.add_rect(boxes[i])
    for t in naive_tiles(boxes[i], vp(), 16, r.cols(), r.rows()) {
      want.push(t)
    }
  }
  assert_true(
    same_tiles(tiles_of(r), want),
    msg="dirty tiles != brute force rasterisation",
  )
  assert_eq(r.tiles(), sorted_keys(want).length())
  // and the pixel bounds cover every pixel that was damaged
  let b = r.bounds()
  for i = 0; i < boxes.length(); i = i + 1 {
    let c = boxes[i].intersect(vp())
    assert_true(
      c.min_x >= b.min_x &&
      c.max_x <= b.max_x &&
      c.min_y >= b.min_y &&
      c.max_y <= b.max_y,
      msg="bounds must contain every clipped input",
    )
  }
}

///|
test "dirty: everything outside the viewport is ignored, partial damage is clipped" {
  let r = @scene.DirtyRegion::new(vp(), 16)
  r.add_rect(@spatial.Aabb::new(-100.0, -100.0, -1.0, -1.0))
  assert_true(
    r.is_empty(),
    msg="a box off the viewport must not dirty anything",
  )
  assert_eq(r.adds, 0)
  r.add_rect(@spatial.Aabb::new(250.0, 185.0, 1000.0, 1000.0))
  assert_eq(r.tiles(), 1)
  let b = r.bounds()
  assert_eq(b.max_x, 256.0)
  assert_eq(b.max_y, 192.0)
  assert_eq(b.min_x, 240.0)
  assert_eq(b.min_y, 176.0)
}

///|
test "dirty: the full shortcut takes over once every tile is dirty" {
  let r = @scene.DirtyRegion::new(vp(), 16)
  r.add_rect(@spatial.Aabb::new(10.0, 10.0, 20.0, 20.0))
  assert_true(!r.is_full(), msg="one tile is not full damage")
  r.add_rect(vp())
  assert_true(r.is_full(), msg="viewport damage is full damage")
  assert_eq(r.tiles(), r.cols() * r.rows())
  assert_eq(r.tiles(), 192)
  // a tile that was never explicitly touched now reads dirty
  assert_true(r.is_tile_set(0, 0), msg="full damage covers every tile")
  assert_true(r.is_tile_set(15, 11), msg="full damage covers the last tile")
  assert_true(r.covers(@spatial.Aabb::new(60.0, 60.0, 70.0, 70.0)))
  let rects = r.to_rects()
  assert_eq(rects.length(), 1)
  assert_eq(rects[0], vp())
  // clearing restores the sparse path
  r.clear()
  assert_true(r.is_empty(), msg="clear must empty the region")
  assert_true(!r.is_full())
  assert_true(!r.is_tile_set(3, 3), msg="clear must clear the tile bits")
  assert_eq(r.tiles(), 0)
}

///|
test "dirty: to_rects is an exact, non-overlapping cover of the tile set" {
  let r = @scene.DirtyRegion::new(vp(), 16)
  // a deliberately awkward pattern: detached islands, plus a checkerboard
  r.add_rect(@spatial.Aabb::new(0.0, 0.0, 48.0, 32.0))
  r.add_rect(@spatial.Aabb::new(80.0, 0.0, 96.0, 16.0))
  r.add_rect(@spatial.Aabb::new(0.0, 64.0, 16.0, 80.0))
  for tx = 0; tx < 6; tx = tx + 1 {
    for ty = 6; ty < 10; ty = ty + 1 {
      if (tx + ty) % 2 == 0 {
        let x = 128.0 + (tx * 16).to_double()
        let y = (ty * 16).to_double()
        r.add_rect(@spatial.Aabb::new(x, y, x + 16.0, y + 16.0))
      }
    }
  }
  let rects = r.to_rects()
  assert_true(
    rects.length() < r.tiles(),
    msg="coalescing should reduce the rect count",
  )
  // 1. every rect is tile-aligned and inside the viewport
  for i = 0; i < rects.length(); i = i + 1 {
    let b = rects[i]
    assert_true(b.min_x >= 0.0 && b.max_y <= 192.0, msg="rect inside viewport")
    assert_true(
      (b.min_x / 16.0).floor() * 16.0 == b.min_x,
      msg="rect must be tile aligned in x",
    )
    assert_true(
      (b.min_y / 16.0).floor() * 16.0 == b.min_y,
      msg="rect must be tile aligned in y",
    )
  }
  // 2. re-rasterising the rects gives exactly the same tile set
  let back = @scene.DirtyRegion::new(vp(), 16)
  for i = 0; i < rects.length(); i = i + 1 {
    back.add_rect(rects[i])
  }
  assert_true(
    same_tiles(tiles_of(back), tiles_of(r)),
    msg="rects are not an exact cover",
  )
  assert_eq(back.tiles(), r.tiles())
  // 3. no two rects overlap (an exact cover, not just a cover)
  for i = 0; i < rects.length(); i = i + 1 {
    for j = i + 1; j < rects.length(); j = j + 1 {
      // positive-area overlap is the property: rectangles that merely share an
      // edge are exactly what a maximal cover looks like
      let inter = rects[i].intersect(rects[j])
      assert_true(
        inter.is_empty() || inter.width() == 0.0 || inter.height() == 0.0,
        msg="merged rectangles must not overlap with positive area",
      )
    }
  }
  // 4. maximality: no vertical pair could be fused
  for i = 0; i < rects.length(); i = i + 1 {
    for j = 0; j < rects.length(); j = j + 1 {
      if i == j {
        continue
      }
      let a = rects[i]
      let b = rects[j]
      let fusable = a.min_x == b.min_x &&
        a.max_x == b.max_x &&
        a.max_y == b.min_y
      assert_true(
        !fusable,
        msg="two stacked rects with the same x extent should have merged",
      )
    }
  }
}

///|
test "dirty: adding the same rect twice is idempotent, and the cap bounds the list" {
  let r = @scene.DirtyRegion::new(vp(), 16)
  let b = @spatial.Aabb::new(10.0, 10.0, 20.0, 20.0)
  r.add_rect(b)
  let t1 = r.tiles()
  r.add_rect(b)
  assert_eq(r.tiles(), t1)
  assert_eq(r.adds, 2)
  // the cap: 30 scattered rects collapse to a single merged rectangle
  let r2 = @scene.DirtyRegion::new(vp(), 16)
  for i = 0; i < 30; i = i + 1 {
    let x = (i % 8 * 32).to_double()
    let y = (i / 8 * 48).to_double()
    r2.add_rect(@spatial.Aabb::new(x, y, x + 8.0, y + 8.0))
  }
  assert_true(r2.overflowed(), msg="30 rects must overflow a cap of 16")
  assert_eq(r2.scissor_count(), 1)
  let pr = r2.pixel_rects()
  assert_eq(pr.length(), 1)
  // the merged rectangle still covers every damaged tile
  assert_true(r2.covers(@spatial.Aabb::new(0.0, 0.0, 8.0, 8.0)))
  assert_true(r2.covers(@spatial.Aabb::new(224.0, 96.0, 232.0, 104.0)))
}

///|
test "dirty: region union equals the union of tile sets" {
  let a = @scene.DirtyRegion::new(vp(), 16)
  a.add_rect(@spatial.Aabb::new(0.0, 0.0, 32.0, 32.0))
  let b = @scene.DirtyRegion::new(vp(), 16)
  b.add_rect(@spatial.Aabb::new(240.0, 176.0, 256.0, 192.0))
  b.add_rect(@spatial.Aabb::new(16.0, 16.0, 32.0, 32.0))
  let want : Array[(Int, Int)] = []
  for t in tiles_of(a) {
    want.push(t)
  }
  for t in tiles_of(b) {
    want.push(t)
  }
  a.add_region(b)
  assert_true(
    same_tiles(tiles_of(a), want),
    msg="add_region must be the set union",
  )
  assert_eq(a.tiles(), sorted_keys(want).length())
  assert_eq(a.tiles(), 5)
}

///|
test "dirty: transform_bounds is tight under rotation and shear" {
  let b = @spatial.Aabb::new(-2.0, -1.0, 3.0, 4.0)
  let cases : Array[@math.Mat2x3] = [
    @math.Mat2x3::identity(),
    @math.Mat2x3::translate(10.0, -5.0),
    @math.Mat2x3::rotate(0.0),
    // 45°: the classic case where a corner-based bound and a tight bound differ
    @math.Mat2x3::rotate(@math.PI / 4.0),
    @math.Mat2x3::rotate(1.1).compose(@math.Mat2x3::scale(2.0, 0.5)),
    @math.Mat2x3::skew(0.4, 0.0),
    @math.Mat2x3::new(1.3, -0.7, 0.9, 1.1, 4.0, 2.0),
  ]
  for i = 0; i < cases.length(); i = i + 1 {
    let m = cases[i]
    let got = @scene.transform_bounds(b, m)
    // every sampled interior point must be inside
    for ix = 0; ix <= 20; ix = ix + 1 {
      for iy = 0; iy <= 20; iy = iy + 1 {
        let x = b.min_x + (b.max_x - b.min_x) * ix.to_double() / 20.0
        let y = b.min_y + (b.max_y - b.min_y) * iy.to_double() / 20.0
        let p = m.apply(@math.Vec2::new(x, y))
        assert_true(
          p.x >= got.min_x - 1.0e-9 &&
          p.x <= got.max_x + 1.0e-9 &&
          p.y >= got.min_y - 1.0e-9 &&
          p.y <= got.max_y + 1.0e-9,
          msg="transformed point escaped the bound at case \{i}",
        )
      }
    }
    // and it is tight: the four transformed corners must touch the bound
    let corners : Array[@math.Vec2] = [
      @math.Vec2::new(b.min_x, b.min_y),
      @math.Vec2::new(b.max_x, b.min_y),
      @math.Vec2::new(b.min_x, b.max_y),
      @math.Vec2::new(b.max_x, b.max_y),
    ]
    let mut cx_min = 1.0e308
    let mut cx_max = -1.0e308
    let mut cy_min = 1.0e308
    let mut cy_max = -1.0e308
    for c in corners {
      let p = m.apply(c)
      cx_min = Double::min(cx_min, p.x)
      cx_max = Double::max(cx_max, p.x)
      cy_min = Double::min(cy_min, p.y)
      cy_max = Double::max(cy_max, p.y)
    }
    assert_true((cx_min - got.min_x).abs() < 1.0e-9, msg="left edge not tight")
    assert_true((cx_max - got.max_x).abs() < 1.0e-9, msg="right edge not tight")
    assert_true((cy_min - got.min_y).abs() < 1.0e-9, msg="top edge not tight")
    assert_true(
      (cy_max - got.max_y).abs() < 1.0e-9,
      msg="bottom edge not tight",
    )
  }
  // an empty box stays empty (fold-safety)
  assert_true(
    @scene.transform_bounds(@spatial.Aabb::empty(), @math.Mat2x3::rotate(0.3)).is_empty(),
  )
}

///|
test "dirty: covers tells the truth about partially dirty areas" {
  let r = @scene.DirtyRegion::new(vp(), 16)
  r.add_rect(@spatial.Aabb::new(0.0, 0.0, 32.0, 16.0))
  assert_true(
    r.covers(@spatial.Aabb::new(0.0, 0.0, 32.0, 16.0)),
    msg="exact hit",
  )
  assert_true(
    r.covers(@spatial.Aabb::new(4.0, 4.0, 12.0, 12.0)),
    msg="inside a dirty tile",
  )
  assert_true(
    r.covers(@spatial.Aabb::new(0.0, 0.0, 48.0, 16.0)) == false,
    msg="a third tile is clean",
  )
  assert_true(
    r.covers(@spatial.Aabb::new(-50.0, -50.0, -10.0, -10.0)),
    msg="a box outside the viewport needs no repaint",
  )
  assert_true(
    r.covers(@spatial.Aabb::new(10.0, 10.0, 20.0, 20.0)) == false,
    msg="the second row of tiles is clean",
  )
}
