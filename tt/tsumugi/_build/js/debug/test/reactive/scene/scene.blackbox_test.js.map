///| Affine and homogeneous matrices.
///
/// `Mat2x3` stores the six coefficients in the same order used by CSS
/// `matrix(a,b,c,d,e,f)` and Canvas2D `setTransform`, so emitting to the
/// browser host needs no reordering — the storage layout *is* the wire
/// layout. Column-major meaning:
///
///   | a  c  e |     x' = a*x + c*y + e
///   | b  d  f |     y' = b*x + d*y + f
///   | 0  0  1 |

///|
#valtype
pub(all) struct Mat2x3 {
  a : Double
  b : Double
  c : Double
  d : Double
  e : Double
  f : Double
} derive(Eq)

///|
pub extend Mat2x3 with Eq::{equal, not_equal}

///|
pub fn Mat2x3::identity() -> Mat2x3 {
  { a: 1.0, b: 0.0, c: 0.0, d: 1.0, e: 0.0, f: 0.0, }
}

///|
pub fn Mat2x3::new(
  a : Double,
  b : Double,
  c : Double,
  d : Double,
  e : Double,
  f : Double,
) -> Mat2x3 {
  { a, b, c, d, e, f, }
}

///|
pub fn Mat2x3::translate(tx : Double, ty : Double) -> Mat2x3 {
  { a: 1.0, b: 0.0, c: 0.0, d: 1.0, e: tx, f: ty, }
}

///|
pub fn Mat2x3::scale(sx : Double, sy : Double) -> Mat2x3 {
  { a: sx, b: 0.0, c: 0.0, d: sy, e: 0.0, f: 0.0, }
}

///|
pub fn Mat2x3::rotate(rad : Double) -> Mat2x3 {
  let c = @cmath.cos(rad)
  let s = @cmath.sin(rad)
  { a: c, b: s, c: -s, d: c, e: 0.0, f: 0.0, }
}

///|
pub fn Mat2x3::skew(kx : Double, ky : Double) -> Mat2x3 {
  { a: 1.0, b: @cmath.tan(ky), c: @cmath.tan(kx), d: 1.0, e: 0.0, f: 0.0, }
}

///|
/// Determinant of the linear part.
#inline
pub fn Mat2x3::det(self : Mat2x3) -> Double {
  self.a * self.d - self.b * self.c
}

///|
/// Composition: `self * other` applies `other` first, then `self`
/// (matches CSS/canvas nesting order).
pub fn Mat2x3::compose(self : Mat2x3, other : Mat2x3) -> Mat2x3 {
  {
    a: self.a * other.a + self.c * other.b,
    b: self.b * other.a + self.d * other.b,
    c: self.a * other.c + self.c * other.d,
    d: self.b * other.c + self.d * other.d,
    e: self.a * other.e + self.c * other.f + self.e,
    f: self.b * other.e + self.d * other.f + self.f,
  }
}

///|
/// Inverse via the adjugate matrix: A^-1 = adj(A) / det(A). For the affine
/// case adj(A) is the transposed cofactor matrix and the last row is known
/// to be (0,0,1), so only six coefficients need computing. Returns `None`
/// when |det| < eps (degenerate: the transform collapses the plane).
pub fn Mat2x3::invert(self : Mat2x3, eps? : Double) -> Mat2x3? {
  let det = self.det()
  let eps = match eps {
    Some(e) => e
    None => 1.0e-12
  }
  if det.abs() <= eps || det.is_nan() {
    None
  } else {
    let inv = 1.0 / det
    Some({
      a: self.d * inv,
      b: -self.b * inv,
      c: -self.c * inv,
      d: self.a * inv,
      e: (self.c * self.f - self.d * self.e) * inv,
      f: (self.b * self.e - self.a * self.f) * inv,
    })
  }
}

///|
pub fn Mat2x3::apply(self : Mat2x3, p : Vec2) -> Vec2 {
  {
    x: self.a * p.x + self.c * p.y + self.e,
    y: self.b * p.x + self.d * p.y + self.f,
  }
}

///|
/// Transform a direction (ignores translation).
pub fn Mat2x3::apply_dir(self : Mat2x3, p : Vec2) -> Vec2 {
  { x: self.a * p.x + self.c * p.y, y: self.b * p.x + self.d * p.y, }
}

///|
/// Expand to a full 3x3 homogeneous matrix (for plane / frustum math).
pub fn Mat2x3::to_mat3(self : Mat2x3) -> Mat3 {
  {
    m00: self.a,
    m01: self.c,
    m02: self.e,
    m10: self.b,
    m11: self.d,
    m12: self.f,
    m20: 0.0,
    m21: 0.0,
    m22: 1.0,
  }
}

///|
/// Affine decomposition result: the matrix is rebuilt as
/// `translate * rotate * skewX * scale`, which is exactly the CSS transform
/// order and therefore directly emittable by @emit.
#valtype
pub(all) struct AffineParts {
  translate : Vec2
  rotation : Double
  scale : Vec2
  skew_x : Double
}

///|
/// Decompose with Gram-Schmidt on the columns.
///
/// Writing the matrix as [col0 | col1] with col0 = sx * u, u the unit rotated
/// axis, the shear is the projection of col1 onto u and the signed y-scale is
/// the projection onto v = perpendicular(u):
///
///   sx    = |col0|
///   theta = atan2(b, a)
///   shear = col1 . u
///   sy    = col1 . v            (signed: negative scale / mirroring is kept)
///   kx    = atan2(shear, sy)    (tan(kx) = shear / sy, sign-safe)
///
/// Rebuilding as translate * rotate * skewX * scale reproduces the original
/// matrix exactly (up to rounding), which the round-trip test verifies.
pub fn Mat2x3::decompose(self : Mat2x3) -> AffineParts? {
  let det = self.det()
  if det.abs() <= 1.0e-12 {
    return None
  }
  let sx = (self.a * self.a + self.b * self.b).sqrt()
  if sx <= 1.0e-12 {
    return None
  }
  let rotation = @cmath.atan2(self.b, self.a)
  let cos_r = self.a / sx
  let sin_r = self.b / sx
  let shear = self.c * cos_r + self.d * sin_r
  let sy = -self.c * sin_r + self.d * cos_r
  let skew_x = @cmath.atan2(shear, sy)
  Some({
    translate: Vec2::{ x: self.e, y: self.f, },
    rotation,
    scale: Vec2::{ x: sx, y: sy, },
    skew_x,
  })
}

///|
/// Rebuild from decomposed parts (inverse of `decompose`).
pub fn affine_rebuild(parts : AffineParts) -> Mat2x3 {
  let t = Mat2x3::translate(parts.translate.x, parts.translate.y)
  let r = Mat2x3::rotate(parts.rotation)
  let k = Mat2x3::skew(parts.skew_x, 0.0)
  let s = Mat2x3::scale(parts.scale.x, parts.scale.y)
  t.compose(r).compose(k).compose(s)
}

///|
/// Full 3x3 homogeneous matrix. Used by the light-culling plane tests and
/// the isometric projections in @tg, where the last row is *not* affine.
#valtype
pub(all) struct Mat3 {
  m00 : Double
  m01 : Double
  m02 : Double
  m10 : Double
  m11 : Double
  m12 : Double
  m20 : Double
  m21 : Double
  m22 : Double
} derive(Eq)

///|
pub extend Mat3 with Eq::{equal, not_equal}

///|
pub fn Mat3::identity() -> Mat3 {
  {
    m00: 1.0,
    m01: 0.0,
    m02: 0.0,
    m10: 0.0,
    m11: 1.0,
    m12: 0.0,
    m20: 0.0,
    m21: 0.0,
    m22: 1.0,
  }
}

///|
pub fn Mat3::compose(self : Mat3, o : Mat3) -> Mat3 {
  {
    m00: self.m00 * o.m00 + self.m01 * o.m10 + self.m02 * o.m20,
    m01: self.m00 * o.m01 + self.m01 * o.m11 + self.m02 * o.m21,
    m02: self.m00 * o.m02 + self.m01 * o.m12 + self.m02 * o.m22,
    m10: self.m10 * o.m00 + self.m11 * o.m10 + self.m12 * o.m20,
    m11: self.m10 * o.m01 + self.m11 * o.m11 + self.m12 * o.m21,
    m12: self.m10 * o.m02 + self.m11 * o.m12 + self.m12 * o.m22,
    m20: self.m20 * o.m00 + self.m21 * o.m10 + self.m22 * o.m20,
    m21: self.m20 * o.m01 + self.m21 * o.m11 + self.m22 * o.m21,
    m22: self.m20 * o.m02 + self.m21 * o.m12 + self.m22 * o.m22,
  }
}

///|
pub fn Mat3::det(self : Mat3) -> Double {
  self.m00 * (self.m11 * self.m22 - self.m12 * self.m21) -
  self.m01 * (self.m10 * self.m22 - self.m12 * self.m20) +
  self.m02 * (self.m10 * self.m21 - self.m11 * self.m20)
}

///|
/// Cofactor (adjugate = transpose of cofactor matrix); used for the inverse
/// and, in @lin, to study the conditioning of near-singular systems.
pub fn Mat3::adjugate(self : Mat3) -> Mat3 {
  {
    m00: self.m11 * self.m22 - self.m12 * self.m21,
    m01: self.m02 * self.m21 - self.m01 * self.m22,
    m02: self.m01 * self.m12 - self.m02 * self.m11,
    m10: self.m12 * self.m20 - self.m10 * self.m22,
    m11: self.m00 * self.m22 - self.m02 * self.m20,
    m12: self.m02 * self.m10 - self.m00 * self.m12,
    m20: self.m10 * self.m21 - self.m11 * self.m20,
    m21: self.m01 * self.m20 - self.m00 * self.m21,
    m22: self.m00 * self.m11 - self.m01 * self.m10,
  }
}

///|
pub fn Mat3::invert(self : Mat3, eps? : Double) -> Mat3? {
  let det = self.det()
  let eps = match eps {
    Some(e) => e
    None => 1.0e-12
  }
  if det.abs() <= eps {
    None
  } else {
    let adj = self.adjugate()
    let inv = 1.0 / det
    Some({
      m00: adj.m00 * inv,
      m01: adj.m01 * inv,
      m02: adj.m02 * inv,
      m10: adj.m10 * inv,
      m11: adj.m11 * inv,
      m12: adj.m12 * inv,
      m20: adj.m20 * inv,
      m21: adj.m21 * inv,
      m22: adj.m22 * inv,
    })
  }
}

///|
/// A plane in 3D: `n . p + d = 0`.
#valtype
pub(all) struct Plane {
  nx : Double
  ny : Double
  nz : Double
  d : Double
}

///|
pub fn Plane::new(nx : Double, ny : Double, nz : Double, d : Double) -> Plane {
  { nx, ny, nz, d, }
}

///|
/// Signed distance of a point from the plane.
#inline
pub fn Plane::distance(self : Plane, p : Vec3) -> Double {
  self.nx * p.x + self.ny * p.y + self.nz * p.z + self.d
}

///|
/// Plane from the two depth bounds of a tile: the light-culling code in
/// @light builds five planes per tile (4 sides + near depth).
pub fn Plane::from_normal_point(n : Vec3, p : Vec3) -> Plane {
  let nn = n.normalize()
  Plane::new(nn.x, nn.y, nn.z, -nn.dot(p))
}
