///| The filters are checked against their defining properties, not against a
/// copied implementation: half-life accuracy, no overshoot, steady-state
/// tracking, noise reduction, and "no chatter" for the trigger.

///|
/// Deterministic noise for the tests.
fn tnoise(i : Int) -> Double {
  let s = (i * 1103515245 + 12345) & 0x7FFFFFFF
  s.to_double() / 1073741824.0 - 1.0
}

///|
test "spring: half-life is exact and there is no overshoot" {
  for half_life in [0.05, 0.2, 1.0] {
    let sp = @smooth.Spring::new(half_life, 0.0)
    sp.set_target(1.0)
    // step in 1 ms increments: the closed form must hit exactly half after
    // exactly one half-life
    let dt = 0.001
    let steps = (half_life / dt).to_int()
    for i = 0; i < steps; i = i + 1 {
      ignore(sp.step(dt))
    }
    let at_half = 1.0 - sp.pos
    assert_true(
      (at_half - 0.5).abs() < 2.0e-3,
      msg="half-life \{half_life}: remaining \{at_half}",
    )
    // and it must never cross the target
    let mut max_seen = sp.pos
    for i = 0; i < 2000; i = i + 1 {
      let p = sp.step(dt)
      if p > max_seen {
        max_seen = p
      }
    }
    assert_true(max_seen <= 1.0 + 1.0e-9, msg="overshoot to \{max_seen}")
    // after 3 half-lives (the loop above + 2 s) the offset is small but not
    // zero: a critically damped spring has an exponential tail, not a snap
    assert_true(sp.settled(0.1), msg="did not settle: \{(sp.pos - 1.0).abs()}")
  }
}

///|
/// A single huge dt (a stalled frame) must stay stable — an Euler spring
/// blows up here, which is why the closed form is used.
test "spring: one 500 ms stall does not explode" {
  let sp = @smooth.Spring::new(0.15, 0.0)
  sp.set_target(1.0)
  let p = sp.step(0.5)
  assert_true(p <= 1.0 + 1.0e-9 && p >= 0.0, msg="pos \{p}")
  // the *position* has closed almost the whole gap in one stalled frame; the
  // velocity still has a tail (that is the physics, not a defect)
  assert_true(
    (p - 1.0).abs() < 0.05,
    msg="offset after stall \{(p - 1.0).abs()}",
  )
  assert_true(sp.settled(0.25), msg="velocity still \{sp.vel}")
}

///|
/// With a moving target the spring must track it with a *bounded* lag and
/// keep up once at constant velocity (velocity feed-forward property of the
/// critically damped spring).
test "spring: tracks a ramp with bounded lag" {
  let sp = @smooth.Spring::new(0.1, 0.0)
  let dt = 1.0 / 120.0
  let speed = 2.0
  let mut t = 0.0
  for i = 0; i < 240; i = i + 1 {
    t = t + dt
    sp.set_target(speed * t)
    ignore(sp.step(dt))
  }
  let lag = speed * t - sp.pos
  assert_true(lag.abs() < 0.25, msg="steady-state lag \{lag}")
}

///|
/// 1€: a constant input must pass through untouched (after the first
/// sample), and the cutoff must actually open with speed.
test "one-euro: constant passes, jitter is attenuated, fast motion is not delayed" {
  let f = @smooth.OneEuro::new(1.0, 0.0, 1.0)
  let dt = 1.0 / 60.0
  // constant 5.0
  let mut last = 0.0
  for i = 0; i < 200; i = i + 1 {
    last = f.step(5.0, dt)
  }
  assert_true((last - 5.0).abs() < 1.0e-9, msg="constant drifted to \{last}")
  // jitter around 5.0: the output variance must be much smaller than input
  let g = @smooth.OneEuro::new(1.0, 0.0, 1.0)
  let mut in_var = 0.0
  let mut out_var = 0.0
  let mut in_sum = 0.0
  let mut out_sum = 0.0
  let n = 600
  let ins : Array[Double] = []
  let outs : Array[Double] = []
  for i = 0; i < n; i = i + 1 {
    let x = 5.0 + tnoise(i) * 0.5
    let y = g.step(x, dt)
    ins.push(x)
    outs.push(y)
  }
  for i = 0; i < ins.length(); i = i + 1 {
    in_sum = in_sum + ins[i]
    out_sum = out_sum + outs[i]
  }
  let in_mean = in_sum / n.to_double()
  let out_mean = out_sum / n.to_double()
  for i = 0; i < n; i = i + 1 {
    in_var = in_var + (ins[i] - in_mean) * (ins[i] - in_mean)
    out_var = out_var + (outs[i] - out_mean) * (outs[i] - out_mean)
  }
  // theory: a plain exponential filter with alpha leaves a variance ratio of
  // a/(2-a). The 1€ filter opens its cutoff as the signal moves, so it passes
  // a little more than that — but it must stay in that ballpark.
  let a = @smooth.alpha_for(1.0, dt)
  let theory = a / (2.0 - a)
  let ratio = out_var / in_var
  assert_true(ratio < 0.15, msg="attenuation: in \{in_var} out \{out_var}")
  assert_true(
    ratio > theory * 0.5 && ratio < theory * 3.0,
    msg="ratio \{ratio} vs theory \{theory}",
  )
  // with beta > 0 a fast ramp must be followed closely (low lag)
  let h = @smooth.OneEuro::new(1.0, 0.05, 1.0)
  let mut y = 0.0
  let mut t = 0.0
  for i = 0; i < 120; i = i + 1 {
    t = t + dt
    y = h.step(t * 3.0, dt)
  }
  let lag = t * 3.0 - y
  assert_true(lag < 0.30, msg="fast-motion lag \{lag}")
  // and a *fixed* low cutoff on the same ramp has visibly more lag
  let k = @smooth.OneEuro::new(1.0, 0.0, 1.0)
  let mut y2 = 0.0
  let mut t2 = 0.0
  for i = 0; i < 120; i = i + 1 {
    t2 = t2 + dt
    y2 = k.step(t2 * 3.0, dt)
  }
  let lag2 = t2 * 3.0 - y2
  assert_true(lag2 > lag * 1.5, msg="beta had no effect: \{lag} vs \{lag2}")
}

///|
test "kalman: converges to a linear ramp with no steady-state lag" {
  let kf = @smooth.Kalman1D::new(1.0e-3, 1.0e-2, 0.05)
  let dt = 1.0 / 120.0
  let speed = 1.5
  let mut t = 0.0
  let mut out = 0.0
  for i = 0; i < 600; i = i + 1 {
    t = t + dt
    let z = speed * t + tnoise(i) * 0.02
    out = kf.step(z, dt)
  }
  let truth = speed * t
  assert_true((out - truth).abs() < 0.05, msg="pos \{out} vs \{truth}")
  assert_true((kf.v - speed).abs() < 0.1, msg="velocity \{kf.v} vs \{speed}")
}

///|
test "hysteresis: no chatter on a noisy threshold crossing" {
  let h = @smooth.Hysteresis::new(0.4, 0.6)
  let mut flips = 0
  let mut prev = h.update(0.5)
  for i = 0; i < 400; i = i + 1 {
    // a value that hovers exactly around 0.5
    let x = 0.5 + tnoise(i) * 0.08
    let on = h.update(x)
    if on != prev {
      flips = flips + 1
      prev = on
    }
  }
  assert_eq(flips, 0)
  // a real crossing still switches on, and stays on while above hi
  assert_true(h.update(0.9))
  assert_true(h.update(0.9))
  // inside the band the previous decision is kept (still on)
  assert_true(h.update(0.5))
  // dropping below lo switches off
  assert_true(!h.update(0.1))
  // and from below, hovering under hi keeps it off
  assert_true(!h.update(0.55))
}
